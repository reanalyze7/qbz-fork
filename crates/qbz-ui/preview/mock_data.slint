// Mock rows for the local preview harness. Never compiled into the app —
// nothing under preview/ is reachable from ui/app.slint, which is the only
// entry point build.rs feeds to slint-build.
//
// The point of the numbers below is coverage, not realism: every quality tier
// the badge can render, an explicit row, a long title that must elide, and
// enough rows that a virtualized ListView actually has to scroll. A three-row
// mock hides exactly the bugs a list is likely to have.

import { TrackItem } from "../ui/state.slint";

export global MockData {
    out property <[TrackItem]> tracks: [
        { id: "1", number: "1", title: "SACRIFICE MYSELF", artist: "Freddie Dredd", album: "Cease & Disintegrate", duration: "2:02", quality-tier: "hires", quality-detail: "24-bit / 48 kHz", explicit: true, is-favorite: true },
