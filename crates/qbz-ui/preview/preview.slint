// The WHOLE app, with mock data, through slint-viewer — no Rust build.
//
// It mounts `AppShell`, the same component ui/app.slint mounts once past the
// splash and login screens. So this is not a mock of the app or a selection of
// its pieces: it is the app's real component tree, real sidebar, real header,
// real now-playing bar, drawn by the same compiler version the build pins.
//
// Two things it cannot do, and both follow from there being no Rust:
//
//   1. Every callback is inert. Playing, queueing, searching, filtering,
//      navigating — all of it is computed on the Rust side. AppShell's
//      callbacks are simply unhandled here.
//   2. Nothing loads. Artwork comes from the Rust artwork pipeline, so covers
//      stay empty; the lists show what `init` below seeds and nothing more.
//
// Because navigation is one of those callbacks, the strip pinned bottom-right
// writes NavState.view directly. It is the one thing here that is not the real
// app, and it exists only because without it this is a single static screen.
//
// Run: ./scripts/slint-preview.sh

import { MockData } from "mock_data.slint";
import { AppShell } from "../ui/shell/AppShell.slint";
import { Theme } from "../ui/foundation/semantic-colors.slint";
import { NavState, ContentView, FavoritesState, LocalLibraryState,
         NowPlayingState, SidebarState } from "../ui/state.slint";

export component Preview inherits Window {
    title: "qbz — preview (mock data)";
    // 1080p — matches DP-1, the primary screen, so what you see here is
    // laid out at the size the app actually runs at.
    width: 1920px;
    height: 1080px;
    background: Theme.surface-main;
    default-font-family: "Inter";

    init => {
        // Library (Qobuz favorites)
        FavoritesState.tracks = MockData.tracks;
        FavoritesState.tracks-visible = MockData.tracks;
        FavoritesState.active-tab = "tracks";

        // Local Library (on-disk)
        LocalLibraryState.tracks = MockData.tracks;
        LocalLibraryState.tracks-visible = MockData.tracks;
        LocalLibraryState.track-count = MockData.tracks.length;
        LocalLibraryState.active-tab = "tracks";

        // Sidebar playlists — one folder with two playlists under it, so the
        // indent, the folder count and the nesting all get exercised.
        SidebarState.entries = [
            { kind: "folder", id: "f1", name: "Écoutes", expanded: true, count: 2 },
            { kind: "playlist", id: "p1", name: "Mes titres", indent: true, folder-id: "f1", cover-count: 4 },
            { kind: "playlist", id: "p2", name: "Late night", indent: true, folder-id: "f1", cover-count: 2 },
            { kind: "playlist", id: "p3", name: "Piano", cover-count: 1 },
        ];

        // Now-playing bar — a Hi-Res track mid-play, so the bar, the quality
        // badge and the progress fill all render in their non-empty state.
        NowPlayingState.title = "From The Start";
        NowPlayingState.artist = "Laufey";
        NowPlayingState.album = "Bewitched";
        NowPlayingState.quality-tier = "hires";
        NowPlayingState.quality-detail = "24-bit / 48 kHz";
        NowPlayingState.position-secs = 72;
        NowPlayingState.duration-secs = 169;
        NowPlayingState.progress = 0.43;
        NowPlayingState.playing = true;

        NavState.view = ContentView.favorites;
    }

    AppShell {
        width: 100%;
        height: 100%;
    }

    // --- preview-only navigation ------------------------------------------
    // Not part of the app. Real navigation goes through Rust; this writes the
    // view enum straight so the screens are reachable at all.
    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 96px;
        width: nav-row.preferred-width + 20px;
        height: 34px;
        border-radius: 8px;
        background: Theme.surface-elevated;
        border-width: 1px;
        border-color: Theme.border-strong;
        opacity: hover-ta.has-hover ? 1.0 : 0.55;
        animate opacity { duration: 120ms; }

        hover-ta := TouchArea { mouse-cursor: default; }

        nav-row := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 4px;
            alignment: center;
            Text {
                text: "preview";
                color: Theme.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
            for dest[i] in [
                { label: "Library", view: ContentView.favorites },
                { label: "Local", view: ContentView.local-library },
                { label: "Home", view: ContentView.home },
                { label: "Settings", view: ContentView.settings },
            ]: Rectangle {
                width: lbl.preferred-width + 16px;
                border-radius: 5px;
                background: NavState.view == dest.view
                    ? Theme.accent
                    : (dta.has-hover ? Theme.surface-hover : transparent);
                lbl := Text {
                    text: dest.label;
                    color: NavState.view == dest.view ? #ffffff : Theme.text-secondary;
                    font-size: 11px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                dta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { NavState.view = dest.view; }
                }
            }
        }
    }
}
