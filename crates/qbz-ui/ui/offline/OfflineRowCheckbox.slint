// Offline Cache Manager row — selection checkbox (track rows only; empty
// spacer for album-header rows). Split out of OfflineRow.slint to keep
// files under the 130-line cap.

import { Theme } from "../foundation/semantic-colors.slint";
import { OfflineManagerActions } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component OfflineRowCheckbox inherits Rectangle {
    in property <bool> is-track;
    in property <bool> selected;
    in property <string> track-id;

    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: root.selected ? Theme.accent : transparent;
    border-width: (root.is-track && !root.selected) ? 1.5px : 0px;
    border-color: Theme.text-muted;
    visible: root.is-track;
    QbzIcon {
        source: @image-url("../assets/icons/check.svg");
        width: 10px;
        height: 10px;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        tint: #ffffff;
        visible: root.selected;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            OfflineManagerActions.toggle-select(root.track-id);
        }
    }
}
