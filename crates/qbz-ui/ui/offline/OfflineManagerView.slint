// Offline Cache Manager — the standalone manage-downloads surface (Tauri's
// OfflineCacheManagerView). Header (Back + title) + a stats bar (totals /
// usage bar / edit-limit / open-folder / clear-all) + a toolbar (sort
// dropdown / show-only-failed) over a two-pane body: a left A-Z artist rail
// and a right scrolling list of album-header (with cover) + track rows
// (per-row remove / re-download).
//
// Rows + artists are precomputed in Rust (crate::offline_manager) and pushed
// as models; actions go through OfflineManagerActions.
//
// Split into sibling files to keep this under the 130-line cap:
// IconBtn/StatusIcon/ArtistRailRow/BulkIconBtn/OfflineRowCheckbox (small
// primitives), OfflineStatsBar (stats + size-limit GB block, kept intact),
// OfflineToolbar (sort/filter/bulk actions), ArtistRail (left pane),
// OfflineRowsList/OfflineRow (right pane, row rendering).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { ShellState } from "../state.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { OfflineStatsBar } from "OfflineStatsBar.slint";
import { OfflineToolbar } from "OfflineToolbar.slint";
import { ArtistRail } from "ArtistRail.slint";
import { OfflineRowsList } from "OfflineRowsList.slint";

export component OfflineManagerView inherits Rectangle {
    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        // Header.
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 12px;
            NavButtons { }
            VerticalLayout {
                alignment: center;
                Text {
                    text: @tr("Offline Cache");
                    color: Theme.text-primary;
                    // Hero homologated to the canonical 18px (section).
                    font-size: Typography.section;
                    font-weight: Typography.bold;
                }
            }
        }

        OfflineStatsBar { }

        OfflineToolbar { }

        // Body — artist rail + rows.
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            ArtistRail { }

            OfflineRowsList { }
        }
    }
}
