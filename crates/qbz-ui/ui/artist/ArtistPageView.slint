// Artist detail page: gradient header, Popular Tracks, and a discography
// split into titled release sections. Data comes from ArtistState.
//
// Split across sibling files to stay under the 130-line budget (see each
// file's own header comment). This file stays the single import surface
// (export name / public callbacks unchanged) and keeps `page-flickable`
// and `body-row` as named elements: the sticky JUMP TO bar / scrollbar /
// network sidebar (ArtistPageChrome) need their live geometry, which
// can't be reached across files by id — only by value, resolved here.

import { Theme } from "../foundation/semantic-colors.slint";
import { ArtistState, ArtistActions, NavState, NetworkSidebarState, DragState, ShellState, AppearanceState } from "../state.slint";
import { ArtistAtmosphereBackground } from "ArtistAtmosphereBackground.slint";
import { ArtistHeader } from "ArtistHeader.slint";
import { ArtistHiddenBanner } from "ArtistHiddenBanner.slint";
import { ArtistPageBody } from "ArtistPageBody.slint";
import { ArtistPageChrome } from "ArtistPageChrome.slint";
import { BiographyModal } from "BiographyModal.slint";
import { NavButtons } from "../shell/NavButtons.slint";

export component ArtistPageView inherits Rectangle {
    callback open-album(string);
    callback media-action(string, string, string);

    property <bool> show-bio: false;
    property <bool> search-visible: false;
    property <string> active-jump-tab: "popular-tracks";
    // Full window width minus page padding + portrait + header gap.
    property <length> content-width: root.width;
    // Atmosphere gate + exact height the header resolved to (`page.y +
    // body-row.y`; both only nameable in this file).
    property <bool> header-atmo-on: AppearanceState.album-header-gradient && !ShellState.app-background-active;
    property <length> atmo-height: page.y + body-row.y;

    // The Network sidebar auto-collapses under ShellState.content-constrained
    // and re-opens when there's room; the user's manual toggle overrides
    // this until the next constrain-edge or artist change.
    property <bool> net-cramped: ShellState.content-constrained;
    property <string> net-nav-watch: ArtistState.id;
    changed net-cramped => { NetworkSidebarState.open = !root.net-cramped; }
    changed net-nav-watch => { NetworkSidebarState.open = !root.net-cramped; }

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    page-flickable := Flickable {
        interactive: !DragState.active;
        viewport-width: self.width;
        viewport-height: page.preferred-height;
        property <string> sr-armed: NavState.restore-scope;
        function sr-restore() {
            if (NavState.restore-scope == "artist" && self.viewport-height > self.height) {
                self.viewport-y = NavState.scroll-restore;
                NavState.restore-scope = "";
            }
        }
        init => { self.sr-restore(); }
        changed sr-armed => { self.sr-restore(); }
        changed viewport-height => { self.sr-restore(); }
        changed viewport-y => { NavState.report-scroll(self.viewport-y); }

        ArtistAtmosphereBackground {
            x: 0;
            y: 0;
            width: parent.width;
            active: root.header-atmo-on;
            atmo-height: root.atmo-height;
            header-atmosphere: ArtistState.header-atmosphere;
            artwork: ArtistState.artwork;
            header-color: ArtistState.header-color;
        }

        page := VerticalLayout {
            width: parent.width;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 11px;
            padding-bottom: 100px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                alignment: start;
                NavButtons { }
            }
            Rectangle { height: 22px; }

            ArtistHeader {
                content-width: root.content-width;
                show-bio-requested => { root.show-bio = true; }
                media-action(kind, id, action) => { root.media-action(kind, id, action); }
            }

            ArtistHiddenBanner {
                media-action(kind, id, action) => { root.media-action(kind, id, action); }
            }

            Rectangle { height: 20px; }
            body-row := HorizontalLayout {
                spacing: 0px;
                ArtistPageBody {
                    horizontal-stretch: 1;
                    open-album(id) => { root.open-album(id); }
                    media-action(kind, id, action) => { root.media-action(kind, id, action); }
                }
                if NetworkSidebarState.open: Rectangle { width: 300px; }
            }
        }
    }

    ArtistPageChrome {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        body-content-top: body-row.absolute-position.y - page-flickable.absolute-position.y;
        flick-x: page-flickable.absolute-position.x;
        flick-y: page-flickable.absolute-position.y;
        flick-w: page-flickable.width;
        flick-h: page-flickable.height;
        flick-viewport-height: page-flickable.viewport-height;
        flick-viewport-y <=> page-flickable.viewport-y;
        active-jump-tab <=> root.active-jump-tab;
        search-visible <=> root.search-visible;
        search-query-changed(q) => { ArtistActions.search(q); }
    }

    if root.show-bio: BiographyModal {
        close => { root.show-bio = false; }
    }
}
