// Network sidebar "Magazine" tab body — Qobuz editorial stories list.
// Split out of NetworkSidebar.slint to keep that file under the 130-line
// budget.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { ArtistState, ArtworkActions } from "../state.slint";

export component NetworkSidebarMagazineTab inherits Flickable {
    vertical-stretch: 1;
    viewport-width: self.width;
    viewport-height: magazine-body.preferred-height;

    magazine-body := VerticalLayout {
        spacing: 10px;
        padding: 12px;
        alignment: start;

        if ArtistState.stories-loading && ArtistState.stories.length == 0: Text {
            text: @tr("Loading…");
            color: Theme.text-muted;
            font-size: 12px;
        }
        if !ArtistState.stories-loading && ArtistState.stories.length == 0: Text {
            text: @tr("No stories for this artist");
            color: Theme.text-muted;
            font-size: 12px;
        }

        for story in ArtistState.stories: Rectangle {
            border-radius: 8px;
            height: story-col.preferred-height;
            background: story-ta.has-hover ? Theme.surface-hover : transparent;
            story-col := VerticalLayout {
                padding: 6px;
                spacing: 6px;
                if story.image-url != "": Rectangle {
                    // 1:1 square thumbnail (height tracks the
                    // layout-stretched width).
                    height: self.width;
                    border-radius: 6px;
                    clip: true;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: story.image;
                        image-fit: cover;
                    }
                }
                Text {
                    text: story.title;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: Typography.semibold;
                    wrap: word-wrap;
                }
                if story.author != "": Text {
                    text: story.author;
                    color: Theme.text-muted;
                    font-size: 11px;
                }
            }
            story-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ArtworkActions.open-in-browser(story.url);
                }
            }
        }
    }
}
