// Network sidebar "Labels" section (Qobuz, deduped from own albums).
// Split out of the Network sidebar to keep each file under the 130-line
// budget.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { ArtistState, NetworkSidebarActions } from "../state.slint";
import { SidebarLink } from "ArtistHelpers.slint";

export component NetworkSidebarLabels inherits VerticalLayout {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 6px;
    spacing: 4px;

    Text {
        text: @tr("LABELS");
        color: Theme.text-muted;
        font-size: 11px;
        font-weight: Typography.semibold;
        letter-spacing: 0.5px;
    }

    if ArtistState.labels.length == 0: Text {
        text: @tr("No label info");
        color: Theme.text-muted;
        font-size: 12px;
    }
    for label in ArtistState.labels: SidebarLink {
        label: label.name;
        icon: @image-url("../assets/icons/disc.svg");
        tooltip: label.name;
        clicked => {
            NetworkSidebarActions.label-clicked(label.id, label.name);
        }
    }
}
