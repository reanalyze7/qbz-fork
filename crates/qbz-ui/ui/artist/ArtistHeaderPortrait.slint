// 200px circular artist portrait + its right-click artwork context menu
// (Add/Change/Remove custom image, Open in browser, Save as). Split out of
// ArtistHeader.slint to keep that file under the 130-line budget.

import { Theme } from "../foundation/semantic-colors.slint";
import { ArtistState, ArtworkActions } from "../state.slint";
import { ContextMenu } from "../primitives/ContextMenu.slint";
import { ContextMenuItem } from "../primitives/ContextMenuItem.slint";

export component ArtistHeaderPortrait inherits Rectangle {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background: Theme.surface-elevated;
    drop-shadow-blur: 32px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 8px;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: ArtistState.artwork;
        image-fit: cover;
    }
    // Right-click → image context menu. Left clicks pass through (no
    // action on the portrait itself).
    artwork-ta := TouchArea {
        mouse-cursor: default;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right
                && e.kind == PointerEventKind.up) {
                artwork-menu.show();
            }
        }
    }
    artwork-menu := PopupWindow {
        x: artwork-ta.mouse-x;
        y: artwork-ta.mouse-y;
        width: 220px;
        close-policy: close-on-click;
        ContextMenu {
            if !ArtistState.has-custom-image: ContextMenuItem {
                icon: @image-url("../assets/icons/image-plus.svg");
                label: @tr("Add image");
                clicked => {
                    ArtworkActions.add-custom("artist", ArtistState.name);
                }
            }
            if ArtistState.has-custom-image: ContextMenuItem {
                icon: @image-url("../assets/icons/image-plus.svg");
                label: @tr("Change image");
                clicked => {
                    ArtworkActions.add-custom("artist", ArtistState.name);
                }
            }
            if ArtistState.has-custom-image: ContextMenuItem {
                icon: @image-url("../assets/icons/trash-2.svg");
                label: @tr("Remove image");
                clicked => {
                    ArtworkActions.remove-custom("artist", ArtistState.name);
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }
            ContextMenuItem {
                icon: @image-url("../assets/icons/external-link.svg");
                label: @tr("Open in browser");
                clicked => {
                    ArtworkActions.open-in-browser(ArtistState.artwork-url);
                }
            }
            ContextMenuItem {
                icon: @image-url("../assets/icons/cloud-download.svg");
                label: @tr("Save as…");
                clicked => {
                    ArtworkActions.save-as(
                        ArtistState.artwork-url, ArtistState.name + ".jpg");
                }
            }
        }
    }
}
