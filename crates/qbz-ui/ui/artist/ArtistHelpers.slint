// Small shared building blocks used across the artist page split
// (ArtistHeader*, DiscographySection, LibraryTabSection, NetworkSidebar*).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component SectionTitle inherits Text {
    color: Theme.text-primary;
    font-size: Typography.heading;
    font-weight: Typography.semibold;
}

// One row in the network sidebar — small leading icon + name. Used by
// Labels (Disc icon), Similar Artists / Members / Discovery (User
// icon), and Member-Of groups (Music icon). Mirrors Tauri's
// `.sidebar-artist-link` rendering.
export component SidebarLink inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> tooltip;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: link-ta.has-hover ? Theme.surface-elevated : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            QbzIcon {
                source: root.icon;
                width: 12px;
                height: 12px;
                tint: link-ta.has-hover ? Theme.text-primary : Theme.text-muted;
            }
        }

        Text {
            text: root.label;
            color: link-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    link-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
