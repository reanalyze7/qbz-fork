// Inline 2-row AudioStamp (owner redesign — NO format icon). Extracted from
// PlayerBarSmall.slint so BOTH the Small bar and the Large bar (centre cluster)
// can mount the same component; the def is now exported.
//
//   Row 1 (focus): [TIER]  [detail]      e.g.  HI-RES   24-bit / 96 kHz
//   Row 2 (secondary): [BACKEND] [MODE]  the two LEDs, smaller, below.
//
// The quality line is the BRIGHTER one (detail = text-primary, tier =
// text-secondary, ~9px) so the LEDs (~6px, below) don't steal the focus. The
// tier label is built MANUALLY from NowPlayingState.quality-tier (no
// QualityBadgeFull — that one carries the icon + stacks tier/detail vertically).
//
// No pills (ADR-008): backend LED blue when active, mode LED green when active,
// muted grey otherwise. Right-aligned + width-clamped (via the parent's
// max-width) so it never blows out the control row.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { NowPlayingState, TooltipState } from "../state.slint";

export component AudioStamp inherits VerticalLayout {
    spacing: 1px;
    alignment: center;
    horizontal-stretch: 0;

    // Manual tier label: hires→HI-RES, mp3→MP3, lossless→LOSSLESS, else→CD.
    property <string> tier-label: NowPlayingState.quality-tier == "hires"
        ? "HI-RES"
        : (NowPlayingState.quality-tier == "mp3"
            ? "MP3"
            : (NowPlayingState.quality-tier == "lossless" ? "LOSSLESS" : "CD"));

    // DELIVERED-first main line (#638 fix 1, owner decision — reverses the
    // #590 catalog-max choice, restoring the Tauri behavior): while the
    // stream is downgraded, Row 1 reports the tier/detail actually playing
    // and the catalog max moves to the tooltip's "Source" line.
    property <bool> show-delivered: NowPlayingState.quality-downgraded
        && NowPlayingState.quality-true-detail != "";
    property <string> delivered-tier-label: NowPlayingState.quality-effective-tier == "hires"
        ? "HI-RES"
        : (NowPlayingState.quality-effective-tier == "mp3" ? "MP3" : "CD");

    // WHY the stream is below the catalog max — third tooltip line, keyed by
    // the QualityLimit discriminant in quality-limit-cause. Informative, not
    // alarming: a downgrade caused by the user's own setting is the app doing
    // what it was told, never a failure. Cause 2 = the local device cap (fix 3).
    property <string> cause-line: NowPlayingState.quality-limit-cause == 1
        ? @tr("Limited by your streaming quality setting")
        : (NowPlayingState.quality-limit-cause == 2
            ? @tr("Limited by your output device's limit")
            : (NowPlayingState.quality-limit-cause == 4
                ? @tr("Qobuz has no higher quality for this track")
                : ""));

    // Tooltip for Row 1: while downgraded, the catalog max ("Source") vs the
    // truly delivered stream ("Output") plus the cause line when known;
    // otherwise the plain tier + detail. Shown only when a detail line exists
    // (no empty "CD: ").
    property <string> quality-tooltip: root.show-delivered
        ? @tr("Source: {}", NowPlayingState.quality-detail) + "\n"
            + @tr("Output: {}", NowPlayingState.quality-true-detail)
            + (root.cause-line == "" ? "" : "\n" + root.cause-line)
        : root.tier-label + ": " + NowPlayingState.quality-detail;

    // === Row 1 — quality, INLINE + BRIGHT (the focus) ====================
    // Wrapped in a TouchArea that feeds the global tooltip overlay (same
    // pattern as PlayerBar's ConnectButton) so hovering the stamp reveals the
    // TRUE delivered quality when the badge shows the catalog max.
    quality-hover := TouchArea {
        changed has-hover => {
            if (self.has-hover && NowPlayingState.quality-detail != "") {
                TooltipState.text = root.quality-tooltip;
                TooltipState.anchor-x = self.absolute-position.x + self.width / 2;
                TooltipState.anchor-y = self.absolute-position.y;
                TooltipState.show = true;
            } else if (!self.has-hover) {
                TooltipState.show = false;
            }
        }
        HorizontalLayout {
            spacing: 5px;
            alignment: end;
            // Pill badge (Spotify/Tidal-style tag), overriding ADR-008's
            // "no pills" rule for this one owner-requested redesign.
            Rectangle {
                background: Theme.accent;
                border-radius: Radius.pill;
                height: 16px;
                width: tier-text.width + 12px;
                tier-text := Text {
                    // Delivered tier while downgraded (#638 fix 1); catalog
                    // tier otherwise.
                    text: root.show-delivered ? root.delivered-tier-label : root.tier-label;
                    font-size: 10px;
                    font-weight: 800;
                    color: Theme.accent-text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    letter-spacing: 0.5px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            // Downgrade arrow (glyph, not a pill — ADR-008): the delivered
            // stream is below the track's catalog max. Amber so it reads as
            // "adjusted", not as an error.
            if NowPlayingState.quality-downgraded: Text {
                text: "↓";
                font-size: 11px;
                font-weight: 700;
                color: #eab308;
                vertical-alignment: center;
            }
            Text {
                // Delivered detail while downgraded; catalog detail otherwise.
                text: root.show-delivered
                    ? NowPlayingState.quality-true-detail
                    : NowPlayingState.quality-detail;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
