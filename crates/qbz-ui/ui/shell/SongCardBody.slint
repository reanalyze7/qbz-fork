// SongCard's cover + song-info row (everything BEFORE the audio stamp, which
// is pinned absolutely by the parent). x/y/width/height are set by the
// parent instance, mirroring the original inline HorizontalLayout's geometry
// (cover | gap | song info, stopping before the stamp's reserved width).

import { SongCardArt } from "SongCardArt.slint";
import { SongCardInfoDefault } from "SongCardInfoDefault.slint";
import { SongCardInfoCentered } from "SongCardInfoCentered.slint";

export component SongCardBody inherits HorizontalLayout {
    in property <bool> show-art: true;
    in property <length> art-size: 60px;
    in property <length> art-border-width: 0px;
    in property <color> art-border-color: transparent;
    in property <length> art-text-gap: 11px;
    in property <bool> text-center: false;
    in property <length> title-font-size;
    in property <length> meta-font-size: 11px;
    in property <length> title-meta-gap: 4px;
    in property <length> title-avail;
    in property <string> ctx-kind;
    in property <string> ctx-id;
    callback open-context(string /* kind */, string /* id */);
    callback open-artist(string);
    callback open-album(string);
    callback track-info();

    spacing: 0px;

    // --- Cover / idle cat ------------------------------------------------
    if root.show-art: SongCardArt {
        art-size: root.art-size;
        art-border-width: root.art-border-width;
        art-border-color: root.art-border-color;
    }

    // Fixed gap: cover -> song info.
    if root.show-art: Rectangle { width: root.art-text-gap; }

    // --- Title + context/artist/album + renderer badge -------------------
    VerticalLayout {
        horizontal-stretch: 1;
        // Allow this column to shrink fully so it can never push the audio
        // stamp past the song-card / controls wall.
        min-width: 0px;
        alignment: center;
        spacing: root.title-meta-gap;

        // text-center ON (Small bar): tight centred title+meta block.
        if root.text-center: SongCardInfoCentered {
            title-avail: root.title-avail;
            title-font-size: root.title-font-size;
            meta-font-size: root.meta-font-size;
            art-size: root.art-size;
            art-border-width: root.art-border-width;
            ctx-kind: root.ctx-kind;
            ctx-id: root.ctx-id;
            open-context(kind, id) => { root.open-context(kind, id); }
            open-artist(id) => { root.open-artist(id); }
            open-album(id) => { root.open-album(id); }
            track-info => { root.track-info(); }
        }
        // text-center OFF (New/Classic, unchanged): full-row layout.
        if !root.text-center: SongCardInfoDefault {
            title-avail: root.title-avail;
            title-font-size: root.title-font-size;
            meta-font-size: root.meta-font-size;
            title-meta-gap: root.title-meta-gap;
            ctx-kind: root.ctx-kind;
            ctx-id: root.ctx-id;
            open-context(kind, id) => { root.open-context(kind, id); }
            open-artist(id) => { root.open-artist(id); }
            open-album(id) => { root.open-album(id); }
            track-info => { root.track-info(); }
        }
    }
}
