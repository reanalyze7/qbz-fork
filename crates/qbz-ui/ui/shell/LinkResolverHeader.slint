// LinkResolverModal header row: title + close X. Extracted verbatim — no id
// coupling with the parent (close-x is only referenced within itself).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { LinkResolverActions } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component LinkResolverHeader inherits HorizontalLayout {
    Text {
        text: @tr("Open Qobuz Link");
        color: Theme.text-primary;
        font-size: Typography.heading;
        font-weight: Typography.semibold;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    close-x := TouchArea {
        width: 28px;
        height: 28px;
        mouse-cursor: pointer;
        clicked => {
            LinkResolverActions.close();
        }
        QbzIcon {
            source: @image-url("../assets/icons/x.svg");
            width: 17px;
            height: 17px;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            tint: close-x.has-hover ? Theme.text-primary : Theme.text-muted;
        }
    }
}
