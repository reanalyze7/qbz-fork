// Closed-sidebar playlists flyout, opened by the header's CompactPlaylistsBtn:
// search header, SidebarState's entries (six rows visible, scrolls beyond),
// footer with Import + Manage playlists. Rendered at AppShell level (header
// clips overflow).

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { LineEdit } from "std-widgets.slint";
import { SidebarPlaylistsPopupState, SidebarState, SidebarActions, UiFocusState } from "../state.slint";
import { SidebarPlaylistsRow } from "SidebarPlaylistsRow.slint";
import { SidebarPlaylistsPopupFooter } from "SidebarPlaylistsPopupFooter.slint";

export component SidebarPlaylistsPopup inherits Rectangle {
    visible: SidebarPlaylistsPopupState.open;

    property <length> row-h: 32px;
    property <int> visible-rows: Math.min(SidebarState.entries.length, 6);
    property <length> list-h: Math.max(root.row-h, root.visible-rows * root.row-h);

    // Shared close-and-clear-filter sequence — popup lifecycle state that the
    // extracted footer component doesn't own.
    function close-and-clear-filter() {
        SidebarPlaylistsPopupState.open = false;
        SidebarState.search-query = "";
        SidebarActions.search-changed("");
    }

    // Scrim — a click anywhere outside the panel closes the popup.
    if SidebarPlaylistsPopupState.open: TouchArea {
        clicked => { root.close-and-clear-filter(); }
    }

    if SidebarPlaylistsPopupState.open: Rectangle {
        x: SidebarPlaylistsPopupState.anchor-x;
        y: SidebarPlaylistsPopupState.anchor-y;
        width: 248px;
        // search(34) + list + divider(1) + import(40) + manage(40) + paddings(8).
        height: 34px + root.list-h + 1px + 40px + 40px + 8px;

        Rectangle {
            background: Theme.surface-main;
            border-radius: Radius.sm;
            border-width: 1px;
            border-color: Theme.border-muted;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.card-shadow;
            drop-shadow-offset-y: 6px;

            // Swallow clicks so the scrim doesn't close while interacting.
            TouchArea { }

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;

                // Search header — filters entries as you type (Rust-side
                // filter shared with the sidebar; SidebarState.entries below
                // is already the filtered set). Always visible. Auto-focus
                // deferred via 1ms Timer: focusing during mount/layout panics
                // with "Recursion detected" (i-slint-core properties.rs) —
                // LineEdit + Timer MUST stay colocated (do not extract).
                Rectangle {
                    height: 34px;
                    pp-search := LineEdit {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 16px;
                        height: 26px;
                        placeholder-text: @tr("Search playlists");
                        // Hotkey-guard probe: use-site `changed has-focus` never fires on
                        // std-widgets (aliases the inner TextInput) — observe locally (#619).
                        property <bool> guard-focused: self.has-focus;
                        changed guard-focused => { UiFocusState.text-input-focused = self.guard-focused; }
                        text <=> SidebarState.search-query;
                        edited => { SidebarActions.search-changed(self.text); }
                    }
                    pp-focus-timer := Timer {
                        interval: 1ms;
                        running: true;
                        triggered => { pp-search.focus(); self.running = false; }
                    }
                }

                // Entries — six rows visible, scrolls beyond. Flickable is
                // unconditional so sibling ListScrollbar can ref `pp-flick`
                // (an `if`-scoped id isn't visible to a sibling `if`).
                Rectangle {
                    height: root.list-h;
                    pp-flick := Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-width: self.width;
                        viewport-height: SidebarState.entries.length * root.row-h;
                        VerticalLayout {
                            width: parent.width;
                            alignment: start;
                            for entry in SidebarState.entries: SidebarPlaylistsRow { entry: entry; }
                        }
                    }
                    if SidebarState.entries.length > 6: ListScrollbar {
                        x: parent.width - self.width;
                        width: 10px;
                        height: 100%;
                        viewport-height: pp-flick.viewport-height;
                        visible-height: pp-flick.height;
                        viewport-y <=> pp-flick.viewport-y;
                    }
                    if SidebarState.entries.length == 0: Text {
                        x: 12px;
                        y: 8px;
                        text: @tr("No playlists yet.");
                        color: Theme.text-muted;
                        font-size: 12px;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Import + Manage — popup owns the close-and-clear sequence.
                SidebarPlaylistsPopupFooter {
                    import-clicked => { SidebarActions.import-playlist(); root.close-and-clear-filter(); }
                    manage-clicked => { SidebarActions.manage-playlists(); root.close-and-clear-filter(); }
                }
            }
        }
    }
}
