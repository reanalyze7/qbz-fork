// Now-playing transport cluster: shuffle, previous, play/pause, next, repeat,
// and a trailing add affordance. Extracted from PlayerBar so the same cluster
// can sit in the CENTRE column (New layout) or the LEFT column (Classic layout)
// without duplicating popups.
//
// `play-circle`   = New filled disc vs Classic plain glyph.
// `classic-actions` = both New and Classic use the grouped "+" add flyout;
//                     Classic ADDS an inline favorite toggle (filled-heart state,
//                     see ClassicFavoriteToggle.slint) next to it.
// Track info (2026-08-21): moved OFF this row entirely — see
// SidebarNowPlayingDock.slint / PlayerBarLeftColumn.
//
// Reads NowPlayingState directly; bubbles add/menu actions via `media-action`.

import { IconButton, PlayButton } from "../primitives/BarControls.slint";
import { NowPlayingState } from "../state.slint";
import { AddToMenuPopup } from "AddToMenu.slint";
import { ClassicFavoriteToggle } from "ClassicFavoriteToggle.slint";

export component TransportControls inherits HorizontalLayout {
    // New layout = filled white disc; Classic = plain glyph.
    in property <bool> play-circle: true;
    // Classic = inline add-to-playlist + favorite; New = grouped "+" menu.
    in property <bool> classic-actions: false;
    callback media-action(string /* kind */, string /* id */, string /* action */);

    spacing: 2px;

    VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("../assets/icons/shuffle.svg");
            icon-size: 24px;
            tooltip: @tr("Shuffle");
            active: NowPlayingState.shuffle;
            enabled: NowPlayingState.has-track;
            clicked => {
                NowPlayingState.toggle-shuffle();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("../assets/icons/skip-back.svg");
            tooltip: @tr("Previous");
            enabled: NowPlayingState.has-track;
            clicked => {
                NowPlayingState.previous();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        PlayButton {
            circle: root.play-circle;
            loading: NowPlayingState.loading;
            icon: NowPlayingState.playing
                ? @image-url("../assets/icons/pause.svg")
                : @image-url("../assets/icons/play-fill.svg");
            tooltip: NowPlayingState.playing ? @tr("Pause") : @tr("Play");
            enabled: NowPlayingState.has-track;
            clicked => {
                NowPlayingState.toggle-play();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("../assets/icons/skip-forward.svg");
            tooltip: @tr("Next");
            enabled: NowPlayingState.has-track;
            clicked => {
                NowPlayingState.next();
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: NowPlayingState.repeat-mode == 2
                ? @image-url("../assets/icons/repeat-1.svg")
                : @image-url("../assets/icons/repeat.svg");
            icon-size: 24px;
            tooltip: @tr("Repeat");
            active: NowPlayingState.repeat-mode != 0;
            enabled: NowPlayingState.has-track;
            clicked => {
                NowPlayingState.cycle-repeat();
            }
        }
    }

    // "+" — grouped add menu. Both New AND Classic open this same flyout (Classic
    // used to fire a one-click add-to-playlist; owner wants the flyout instead).
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 36px;
            height: 36px;
            IconButton {
                icon: @image-url("../assets/icons/plus.svg");
                icon-size: 24px;
                tooltip: @tr("Add to…");
                enabled: NowPlayingState.has-track;
                clicked => {
                    add-menu.show();
                }
            }
            add-menu := AddToMenuPopup {
                track-id: NowPlayingState.track-id;
                album-favorite: NowPlayingState.album-favorite;
                album-id: NowPlayingState.album-id;
                media-action(kind, id, action) => {
                    root.media-action(kind, id, action);
                }
            }
        }
    }

    // Classic: inline favorite toggle (filled-heart state) — 1:1 with Tauri.
    if root.classic-actions: VerticalLayout {
        alignment: center;
        ClassicFavoriteToggle {
            has-track: NowPlayingState.has-track;
        }
    }
}
