// Large NPB (mode 3) cover dock — the L's vertical arm. Mounted as a ROOT
// overlay by AppShell, pinned flush to the window bottom-left (NOT inside the
// sidebar VL anymore — that floated it above the bar). Layout: a square album
// cover (= the fed width) flush to the bottom.
//
// Owner refinements (2026-08-21): the spectrum/waveform visualizer band that
// used to sit above the cover (with its eye-icon show/hide toggle) was
// removed entirely — deemed unnecessary. `ShellState.large-visualizer-on` /
// `large-spectrum-mode` stay defined (Rust/ui_prefs still round-trip them)
// but nothing here reads them any more.
//
// Owner refinements (2026-06-21):
//  - The cover sits FLUSH to the window bottom-left, equal L/R gutters (the
//    AppShell overlay feeds x=16, width=240-32). art-size = root.width.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { Spacing } from "../foundation/spacing.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { NowPlayingState, QueueState, ShellState, AppearanceState } from "../state.slint";

export component SidebarNowPlayingDock inherits Rectangle {
    callback media-action(string, string, string);

    // Square cover = the dock's (sidebar content) width.
    property <length> art-size: root.width;
    // Cover + Spacing.md top/bottom pad — same breathing room as the
    // sidebar list above it (Sidebar.slint's padding-top/bottom: Spacing.md).
    height: root.art-size + 2 * Spacing.md;

    // Top hairline divider between the playlists and the dock.
    Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: 1px;
        background: Theme.border-subtle;
    }

    VerticalLayout {
        padding-top: Spacing.md;
        padding-bottom: Spacing.md;

        // ---- Album cover (square) -------------------------------------------
        art := Rectangle {
            height: root.art-size;
            border-radius: Radius.md;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 4px;
            background: ShellState.app-background-active
                ? Theme.surface-main.with-alpha(AppearanceState.app-background-surface-alpha)
                : Theme.surface-main;

            if NowPlayingState.has-track
                && (NowPlayingState.artwork-large.width > 0 || NowPlayingState.artwork.width > 0): Image {
                source: NowPlayingState.artwork-large.width > 0
                    ? NowPlayingState.artwork-large
                    : NowPlayingState.artwork;
                image-fit: cover;
                width: parent.width;
                height: parent.height;
            }
            // Placeholder glyph when no cover yet.
            if !(NowPlayingState.artwork-large.width > 0 || NowPlayingState.artwork.width > 0): QbzIcon {
                source: @image-url("../assets/icons/music.svg");
                width: root.art-size * 0.32;
                height: root.art-size * 0.32;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: Theme.text-muted;
            }

            // Hover tracker over the whole cover — reveals the track-info
            // button on hover (mirrors the old eye-toggle's reveal pattern).
            cover-ta := TouchArea {
                mouse-cursor: default;
            }

            // Track info — top-right overlay button, same trigger as the
            // song-card's (i) icon / title click, just directly on the cover.
            // Qobuz-only (no info page for local/ephemeral tracks).
            if NowPlayingState.has-track && NowPlayingState.source == "qobuz": Rectangle {
                width: 28px;
                height: 28px;
                x: parent.width - self.width - 8px;
                y: 8px;
                border-radius: 8px;
                background: it.has-hover ? #ffffff2e : #00000080;
                border-width: 1px;
                border-color: #ffffff33;
                opacity: (cover-ta.has-hover || it.has-hover) ? 1.0 : 0.0;
                animate opacity { duration: 140ms; }
                QbzIcon {
                    source: @image-url("../assets/icons/info.svg");
                    width: 15px;
                    height: 15px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: #ffffff;
                }
                accessible-role: button;
                accessible-label: @tr("Track info");
                it := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.media-action("track", NowPlayingState.track-id, "track-info");
                    }
                }
            }

            // Favorite heart — top-LEFT overlay button (mirrors the (i)
            // button's top-right position), same toggle as the transport
            // row's classic inline heart.
            if NowPlayingState.has-track: Rectangle {
                width: 28px;
                height: 28px;
                x: 8px;
                y: 8px;
                border-radius: 8px;
                background: ft.has-hover ? #ffffff2e : #00000080;
                border-width: 1px;
                border-color: #ffffff33;
                opacity: (cover-ta.has-hover || ft.has-hover || QueueState.now-playing-favorite) ? 1.0 : 0.0;
                animate opacity { duration: 140ms; }
                QbzIcon {
                    source: QueueState.now-playing-favorite
                        ? @image-url("../assets/icons/heart-filled.svg")
                        : @image-url("../assets/icons/heart.svg");
                    width: 15px;
                    height: 15px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: QueueState.now-playing-favorite ? Theme.favorite : #ffffff;
                }
                accessible-role: button;
                accessible-label: QueueState.now-playing-favorite
                    ? @tr("Remove from library")
                    : @tr("Add to library");
                ft := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        QueueState.toggle-now-playing-favorite();
                    }
                }
            }
        }
    }
}
