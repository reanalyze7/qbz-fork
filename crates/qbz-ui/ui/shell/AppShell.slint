// App shell — the post-login frame: header bar, sidebar, content region, and
// player bar, driven by NavState.
//
// Z-ORDER IS DECLARATION ORDER (ADR-009/010): GestureLayer -> DynamicBackground
// -> VerticalLayout (header/main-row/player) -> Large-NPB dock ->
// GlobalOverlaysA -> GlobalOverlaysB -> TrackMenu. Split across sibling
// AppShell*.slint files by visual region (Gesture/DynamicBackground; MainRow
// -> ContentFrame -> ContentRegion + its own view-group sub-split, and
// QueuePanel; GlobalOverlaysA/B; TrackMenu) — instantiated below in this
// SAME order (reordering breaks stacking silently, no compile error). This
// file is the ONE import surface (`app.slint` imports only `AppShell`).

import { Theme } from "../foundation/semantic-colors.slint";
import { NavState, ContentView, ShellState, SearchActions, VisualizerState, NowPlayingState, AppearanceState } from "../state.slint";
import { HeaderBar } from "HeaderBar.slint";
import { NowPlayingBar } from "NowPlayingBar.slint";
import { AppShellGestureLayer } from "AppShellGestureLayer.slint";
import { AppShellDynamicBackground } from "AppShellDynamicBackground.slint";
import { AppShellMainRow } from "AppShellMainRow.slint";
import { AppShellLargeDock } from "AppShellLargeDock.slint";
import { AppShellGlobalOverlaysA } from "AppShellGlobalOverlaysA.slint";
import { AppShellGlobalOverlaysB } from "AppShellGlobalOverlaysB.slint";
import { AppShellTrackMenu } from "AppShellTrackMenu.slint";

export component AppShell inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);
    callback header-menu-navigate(string);
    callback discover-view-all(string, string);
    callback settings-bool(string, bool);
    callback settings-select(string, int);
    callback settings-slider(string, int);
    callback settings-string(string, string);
    callback settings-reset();
    callback settings-release-device();
    callback logout();
    callback close-app();
    // D2 recovery sign-in with the saved token — the header status badge's flyout.
    callback recovery-login();

    background: Theme.surface-main;

    // Close the live search "cortinilla" on ANY view change (the one
    // chokepoint every navigation path funnels through via NavState.view).
    // The cortinilla's own handlers still close it directly; this adds the
    // "navigated away by other means" case.
    property <ContentView> tracked-view: NavState.view;
    changed tracked-view => {
        SearchActions.cortinilla-dismiss();
        // "Startup page = where you left off" (Rust filters safe views).
        ShellState.persist-view();
    }

    // FFT visualizer tap — runs whenever the sidebar dock shows a spectrum,
    // or the app-wide Ambient background (mode 1) needs its shader drain;
    // idle otherwise. This `changed` catches every transition.
    property <bool> viz-should-run: (ShellState.large-active && ShellState.large-visualizer-on)
        || (AppearanceState.app-background-mode-index == 1
            && AppearanceState.app-background-available
            && NowPlayingState.has-track);
    changed viz-should-run => {
        VisualizerState.set-enabled(self.viz-should-run);
    }

    // Reduce-motion clock: on the GL/software tiers, advances a coarse
    // ~8fps ms counter loading indicators / eq bars use instead of
    // display-rate animation-tick(); also ticks while audio plays on the
    // strong tier (equalizer bars). Wraps daily to avoid overflow.
    Timer {
        interval: 125ms;
        running: ShellState.reduce-motion || NowPlayingState.playing;
        triggered => {
            ShellState.coarse-tick-ms = Math.mod(ShellState.coarse-tick-ms + 125, 86400000);
        }
    }

    AppShellDynamicBackground { shell-width: root.width; shell-height: root.height; }
    AppShellGestureLayer { }

    VerticalLayout {
        spacing: 0px;

        // Header spans the full width at the top; the sidebar starts below it.
        HeaderBar {
            logout => { root.logout(); }
            close-app => { root.close-app(); }
            recovery-login => { root.recovery-login(); }
            navigate(route) => { root.header-menu-navigate(route); }
        }

        AppShellMainRow {
            shell-height: root.height;
            header-menu-navigate(route) => { root.header-menu-navigate(route); }
            open-album(id) => { root.open-album(id); }
            open-artist(id) => { root.open-artist(id); }
            media-action(kind, id, action) => { root.media-action(kind, id, action); }
            discover-view-all(e, t) => { root.discover-view-all(e, t); }
            settings-bool(k, v) => { root.settings-bool(k, v); }
            settings-select(k, i) => { root.settings-select(k, i); }
            settings-slider(k, v) => { root.settings-slider(k, v); }
            settings-string(k, s) => { root.settings-string(k, s); }
            settings-reset => { root.settings-reset(); }
            settings-release-device => { root.settings-release-device(); }
        }

        // Mode-aware bottom bar shell: New/Classic -> PlayerBar, Small -> PlayerBarSmall.
        NowPlayingBar {
            open-album(id) => { root.open-album(id); }
            open-artist(id) => { root.open-artist(id); }
            media-action(kind, id, action) => { root.media-action(kind, id, action); }
            settings-bool(k, v) => { root.settings-bool(k, v); }
        }
    }

    AppShellLargeDock {
        shell-height: root.height;
        media-action(k, i, a) => { root.media-action(k, i, a); }
    }

    AppShellGlobalOverlaysA {
        header-menu-navigate(route) => { root.header-menu-navigate(route); }
    }
    AppShellGlobalOverlaysB { }
    AppShellTrackMenu {
        media-action(k, i, a) => { root.media-action(k, i, a); }
    }
}
