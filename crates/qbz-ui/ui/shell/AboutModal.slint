// About QBZ modal — the native port of Tauri's AboutModal.svelte.
//
// Opened from the header hamburger menu ("About Qoqobuz"). Static content seeded
// by crate::about into AboutState: app branding + version, the description,
// the Qobuz legal notice, an external-links row, the build-info grid, a
// one-line acknowledgments paragraph, the author + contributors (clickable
// chips with GitHub avatars that open the profile), and the signature footer.
//
// Layout mirrors LogViewerModal / QconnectDevModal: a dimmed full-window
// backdrop that closes on click, a centered card that swallows clicks, a
// header (branding + X), and a scrolling body. Mounted in AppShell in
// declaration order so its z-order is the mount order (ADR-009);
// conditional-mounted on AboutState.open (ADR-010). No pills (ADR-008): the
// author + contributor rows are bordered Radius.sm chips, not pills.
//
// Split across sibling files: LinkButton, HandleChip, SectionHeading
// (small shared components), AboutHeader (branding + close X), AboutBody
// (the scrolling content, itself split into AboutBuildInfo/
// AboutContributors/AboutSignature). This file stays the public surface and
// owns the backdrop/card shell.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { AboutState } from "../state.slint";
import { AboutHeader } from "AboutHeader.slint";
import { AboutBody } from "AboutBody.slint";

export component AboutModal inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: AboutState.open;

    if AboutState.open: Rectangle {
        background: #000000bf;
        TouchArea {
            mouse-cursor: default;
            clicked => {
                AboutState.open = false;
            }
        }

        Rectangle {
            width: Math.min(root.width - 80px, 840px);
            height: Math.min(root.height - 80px, 770px);
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            border-radius: Radius.md;
            background: Theme.surface-card;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;
            // Swallow clicks so they don't reach the closing backdrop.
            TouchArea { }

            VerticalLayout {
                padding: 24px;
                spacing: 0px;

                AboutHeader { }

                Rectangle { height: 16px; }
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }
                Rectangle { height: 16px; }

                // ---- Scrolling body.
                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: about-body.preferred-height;

                    about-body := AboutBody {
                        width: parent.width;
                    }
                }
            }
        }
    }
}
