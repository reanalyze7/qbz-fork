// Bottom now-playing / transport bar — Mode C "Small" (redesigned).
//
// One bar, header-height tall (42px). A THIN top seekbar strip (3px) sits over
// the controls row which fills the rest (~39px) — NO band bump. The large
// album art (37px, flush to the left edge with a 2px border) is the dominant
// element that defines the visual height.
//
//   ┌──────────────────────────────────────────────────────────────────┐
//   │ ▰▰▰▰▰▰▰▰▰▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱▱  ← top seekbar  │  (3px, full width)
//   ├──────────────────────────────────────────────────────────────────┤
//   │[art] title  00:02 (i)⏮ ⏪ ▶ ⏩ ⏭ +   STAMP view cast lyr ⚙ vol q  │  (~39px)
//   │      artist 04:32                                                   │
//   └──────────────────────────────────────────────────────────────────┘
//
// A SYMMETRIC 3-column controls row mirrors PlayerBar's New/Classic
// mechanism: LEFT (art · 2-line title/artist · time column) and RIGHT
// (AudioStamp · ViewMode · Connect · Cast · Lyrics · Settings · Volume ·
// Queue) share ONE responsive `side-frac`, so CENTER (transport) is
// window-centred and PLAY lands on the window centre at every width.
//
// Mounted by NowPlayingBar.slint when ShellState.npb-mode == 2. Reads
// NowPlayingState directly; bubbles album/artist/media actions up to the shell.
//
// Split into playerbar/ sub-components on 2026-08-20 (was a single
// 1000-line file), mirroring PlayerBar.slint's split: this file only owns
// the bar chrome (top seekbar strip), the responsive column math (39/22/39,
// 30/40/30, 25/50/25 — identical formula to PlayerBar's) and the volume
// lock. Everything else is a self-contained component in playerbar/,
// reusing PlayerBar's ConnectButton and the Qconnect device-picker
// sub-components verbatim where geometry allows (see each
// playerbar/PlayerBarSmall*.slint header for what could and couldn't be
// shared byte-for-byte).

import { Theme } from "../foundation/semantic-colors.slint";
import { PlayerBarSmallTopSeekbar } from "playerbar/PlayerBarSmallTopSeekbar.slint";
import { PlayerBarSmallLeftColumn } from "playerbar/PlayerBarSmallLeftColumn.slint";
import { PlayerBarSmallCentreColumn } from "playerbar/PlayerBarSmallCentreColumn.slint";
import { PlayerBarSmallRightColumn } from "playerbar/PlayerBarSmallRightColumn.slint";
import { NowPlayingState, ShellState, SettingsState, AppearanceState } from "../state.slint";

export component PlayerBarSmall inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);
    callback settings-bool(string, bool);

    // One bar, header-height tall: a 3px top seekbar strip + the controls row
    // that fills the rest (no band bump — the large album art defines the height).
    // macOS: taller by ShellState.npb-small-extra (Rust-set, default 6px) so
    // the meta line never clips at the window's bottom edge/bezel; the song
    // card below keeps its 39px top-anchored geometry, so the extra height
    // lands as bottom clearance.
    height: ShellState.npb-small-height;
    background: ShellState.app-background-active
        ? Theme.surface-card.with-alpha(AppearanceState.app-background-surface-alpha)
        : Theme.surface-card;

    // Responsive side fraction — IDENTICAL to PlayerBar's New mechanism
    // (PlayerBar.slint:44-46). LEFT and RIGHT columns share this fraction so
    // they are symmetric, which puts the CENTER transport column dead-centre
    // and lands PLAY on the window centre (aligned with the header search).
    //   width <  1366  -> 39% | 22% | 39%
    //   1366..<1920    -> 30% | 40% | 30%
    //   width >= 1920  -> 25% | 50% | 25%
    property <float> side-frac: root.width >= 1920px
        ? 0.25
        : (root.width >= 1366px ? 0.30 : 0.39);
    property <float> col-centre: 1.0 - 2.0 * root.side-frac;

    // WIDE = inline horizontal volume slider; NARROW = a button opening a
    // vertical slider flyout. Same 1366px breakpoint family as the side-frac.
    property <bool> volume-wide: root.width >= 1366px;

    // Volume lock, mirroring PlayerBar's vol-locked: the local ALSA-Direct
    // (bit-perfect) lock is LIFTED while controlling a peer, plus the
    // sink-pushed remote lock. When locked, the volume control dims + no-ops.
    property <bool> vol-locked: (SettingsState.backend-is-alsa && SettingsState.alsa-plugin-is-hw && !NowPlayingState.is-remote)
        || NowPlayingState.volume-locked;

    VerticalLayout {
        spacing: 0px;

        // === A. TOP full-width seekbar (the content/bar divider) ===========
        PlayerBarSmallTopSeekbar { }

        // === B. CONTROLS ROW — symmetric 3 columns (39/22/39 …) ============
        // Fills the bar height left over after the 3px seekbar (~39px) via
        // vertical-stretch instead of an explicit height, so the total is exactly
        // header-height with no bump.
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 0px;
            padding-right: 6px;
            spacing: 0px;

            PlayerBarSmallLeftColumn {
                width: (parent.width - 6px) * root.side-frac;
                open-album(id) => {
                    root.open-album(id);
                }
                open-artist(id) => {
                    root.open-artist(id);
                }
                media-action(k, i, a) => {
                    root.media-action(k, i, a);
                }
            }

            PlayerBarSmallCentreColumn {
                width: (parent.width - 6px) * root.col-centre;
                media-action(k, i, a) => {
                    root.media-action(k, i, a);
                }
            }

            PlayerBarSmallRightColumn {
                width: (parent.width - 6px) * root.side-frac;
                volume-locked: root.vol-locked;
                volume-wide: root.volume-wide;
                media-action(k, i, a) => {
                    root.media-action(k, i, a);
                }
                settings-bool(k, v) => {
                    root.settings-bool(k, v);
                }
            }
        }
    }
}
