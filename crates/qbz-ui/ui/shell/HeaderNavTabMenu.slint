// A nav tab plus its dropdown menu.
//
// The menu is an ACCORDION: a click opens this tab's section, a second
// click on the same tab closes it. It is not hover-driven — that made the
// menu appear whenever the pointer merely crossed a nav item.
//
// The tab does not own a PopupWindow (one would grab the pointer). Clicking
// writes this tab's identity (index, header x-position, menu rows,
// home-item) into the HeaderMenuState global; the panel itself is drawn by
// HeaderMenuOverlay, a late child of the AppShell root, so it renders above
// the content area. Single-open is automatic — there is one global
// `open-index`, so opening a section closes any other.
// Split out of HeaderBar.slint (with NavTab itself in HeaderNavTabs.slint).
import { HeaderMenuState, NavMenuEntry } from "../state.slint";
import { NavTab } from "HeaderNavTabs.slint";

export component NavTabWithMenu inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> show-icon: true;
    // Forwarded to the inner NavTab. NOTE: no longer used for offline
    // gating (offline tabs are hidden at the mount site). Kept for future use.
    in property <bool> disabled: false;
    in property <[NavMenuEntry]> items;
    // This tab's index (0..3) — written into HeaderMenuState.open-index.
    in property <int> tab-index;
    // Index of the row wired to Home (-1 = none). Clicking it switches
    // to ContentView.home; all other rows are harmless no-ops.
    in property <int> home-item: -1;

    width: tab.width;
    height: 30px;

    // Publishes this tab's menu into the shared overlay state. The
    // overlay aligns the panel under `anchor-x`; `absolute-position`
    // resolves to a window-relative coordinate, which is what the
    // AppShell-level overlay needs (the tab itself sits inside the
    // header's tab-row layout, several offsets deep).
    function open-menu() {
        HeaderMenuState.open-index = root.tab-index;
        HeaderMenuState.anchor-x = root.absolute-position.x;
        // Header dropdown — NOT a sidebar flyout. Resetting these is what
        // glues the panel under the tab: a stale from-sidebar/anchor-y from a
        // previous sidebar flyout would otherwise fling it far away.
        HeaderMenuState.from-sidebar = false;
        HeaderMenuState.title = "";
        HeaderMenuState.items = root.items;
        HeaderMenuState.home-item = root.home-item;
    }

    tab := NavTab {
        icon: root.icon;
        label: root.label;
        active: root.active;
        show-icon: root.show-icon;
        disabled: root.disabled;
        // Accordion: click opens this section, clicking it again closes it.
        // Deliberately NOT hover-driven — a menu that opened whenever the
        // pointer crossed a nav item fired constantly on the way to
        // somewhere else.
        clicked => {
            if (HeaderMenuState.open-index == root.tab-index) {
                HeaderMenuState.open-index = -1;
            } else {
                root.open-menu();
            }
        }
    }
}
