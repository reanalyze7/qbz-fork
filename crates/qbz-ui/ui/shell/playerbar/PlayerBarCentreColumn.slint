// PlayerBar CENTRE column — the transport cluster (symmetric, filled disc,
// absolutely centred).
// Extracted from PlayerBar.slint (2026-08-20) — same markup, own component.

import { TransportControls } from "../TransportControls.slint";

export component PlayerBarCentreColumn inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    clip: true;

    // Centred transport, PLAY on the window centre (the AudioStamp lives on
    // the right column's left wall, NOT in this centred group).
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            TransportControls {
                play-circle: true;
                media-action(k, i, a) => { root.media-action(k, i, a); }
            }
        }
    }
}
