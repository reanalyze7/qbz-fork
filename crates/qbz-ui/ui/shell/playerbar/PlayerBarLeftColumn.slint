// PlayerBar LEFT column — the song card (audio stamp floats to its right
// wall). The cover lives in the sidebar dock, so the card hides its art.
// Extracted from PlayerBar.slint (2026-08-20) — same markup, own component.
// Width is set by the caller (the responsive side-fraction lives in
// PlayerBar.slint, the only place that owns the 39/30/25% breakpoints).

import { Layout } from "../../foundation/layout.slint";
import { SongCard } from "../SongCard.slint";
import { ShellState, NowPlayingState } from "../../state.slint";

export component PlayerBarLeftColumn inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    clip: true;

    SongCard {
        // EXPLICIT height (= controls-row height). Without it the inner
        // `height: root.height` formed a binding loop that sized the card to
        // the TEXT content (~50px) instead of the cover (72px).
        height: Layout.player-bar-height - 38px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        art-size: Layout.player-bar-height - 38px;
        // The cover is docked in the sidebar, so drop it here.
        show-art: false;
        // The quality badge + LEDs live in the SMALL inline AudioStamp on the
        // right column's left wall, not in the song card.
        show-badges: false;
        // Shift the card RIGHT so it clears the docked cover overlay
        // (which occupies the bottom-left ~sidebar-width). The row itself is
        // NOT inset (PLAY stays window-centred), so only this card's content
        // moves.
        x: ShellState.large-active ? (ShellState.sidebar-rendered-width + 8px) : 0px;
        width: ShellState.large-active
            ? (parent.width - (ShellState.sidebar-rendered-width + 8px))
            : parent.width;
        compact-stamp: false;
        dot-leds: true;
        open-album(id) => { root.open-album(id); }
        open-artist(id) => { root.open-artist(id); }
        open-context(kind, id) => { root.media-action(kind, id, "open"); }
        track-info() => {
            // Track info is a Qobuz-only feature — disable the trigger for
            // local / ephemeral tracks (no DB row / no Qobuz page).
            if (NowPlayingState.source == "qobuz") {
                root.media-action("track", NowPlayingState.track-id, "track-info");
            }
        }
    }
}
