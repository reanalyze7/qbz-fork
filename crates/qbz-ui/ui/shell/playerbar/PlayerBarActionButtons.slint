// PlayerBar secondary action buttons — the audio-settings popover trigger,
// with the small AudioStamp docked to its left.
// Extracted from PlayerBar.slint (2026-08-20) — same markup, own component.

import { IconButton } from "../../primitives/BarControls.slint";
import { AudioStamp } from "../AudioStamp.slint";
import { AudioSettingsPopover } from "AudioSettingsPopover.slint";
import { SettingsState } from "../../state.slint";

export component PlayerBarActionButtons inherits HorizontalLayout {
    callback settings-bool(string, bool);

    spacing: 1px;

    // The SMALL AudioStamp sits just LEFT of the icon cluster, separated by
    // a FIXED gap (so its distance to the buttons stays constant at any
    // window width).
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        AudioStamp {
            max-width: 140px;
        }
    }
    Rectangle {
        width: 12px;
        horizontal-stretch: 0;
    }

    // Audio settings — normalization + gapless.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            IconButton {
                icon: @image-url("../../assets/icons/settings-2.svg");
                icon-size: 16px;
                btn-width: 32px;
                tooltip: @tr("Audio settings");
                active: SettingsState.normalization;
                clicked => { audio-popover.show(); }
            }
            audio-popover := AudioSettingsPopover {
                settings-bool(k, v) => { root.settings-bool(k, v); }
            }
        }
    }
}
