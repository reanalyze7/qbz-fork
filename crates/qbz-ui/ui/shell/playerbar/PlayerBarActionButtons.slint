// PlayerBar secondary action buttons — Connect, Cast, audio settings,
// now-playing view. Popovers now live in their own files
// (QconnectFlyout, AudioSettingsPopover, NowPlayingViewMenu); this component
// just owns the buttons that open them.
// Extracted from PlayerBar.slint (2026-08-20) — same markup, own component.

import { IconButton } from "../../primitives/BarControls.slint";
import { AudioStamp } from "../AudioStamp.slint";
import { ConnectButton } from "ConnectButton.slint";
import { QconnectFlyout } from "QconnectFlyout.slint";
import { AudioSettingsPopover } from "AudioSettingsPopover.slint";
import { NowPlayingViewMenu } from "NowPlayingViewMenu.slint";
import { ShellState, NowPlayingState, SettingsState, CastState, CastActions } from "../../state.slint";

export component PlayerBarActionButtons inherits HorizontalLayout {
    callback media-action(string, string, string);
    callback settings-bool(string, bool);

    spacing: 1px;

    // Large: the SMALL AudioStamp sits just LEFT of the icon cluster,
    // separated by a FIXED gap (so its distance to the buttons stays
    // constant at any window width).
    if ShellState.npb-mode == 3: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        AudioStamp {
            max-width: 140px;
        }
    }
    if ShellState.npb-mode == 3: Rectangle {
        width: 12px;
        horizontal-stretch: 0;
    }

    // Qobuz Connect — golden when remote; opens the connect flyout.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            ConnectButton {
                // Golden whenever a Qobuz Connect session is on — whether
                // qbz is the renderer or controlling a peer.
                active: NowPlayingState.qconnect-connected;
                tooltip: NowPlayingState.qconnect-connected
                    ? @tr("Qobuz Connect: On")
                    : @tr("Qobuz Connect: Off");
                clicked => { qconnect-flyout.show(); }
            }
            qconnect-flyout := QconnectFlyout { }
        }
    }

    // Cast (Chromecast / DLNA) — opens the cast picker modal.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            IconButton {
                icon: @image-url("../../assets/icons/cast.svg");
                icon-size: 16px;
                btn-width: 32px;
                tooltip: @tr("Cast");
                active: NowPlayingState.cast-active;
                clicked => {
                    CastState.picker-open = true;
                    CastActions.open();
                }
            }
        }
    }

    // Audio settings — normalization + gapless.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            IconButton {
                icon: @image-url("../../assets/icons/settings-2.svg");
                icon-size: 16px;
                btn-width: 32px;
                tooltip: @tr("Audio settings");
                active: SettingsState.normalization;
                clicked => { audio-popover.show(); }
            }
            audio-popover := AudioSettingsPopover {
                settings-bool(k, v) => { root.settings-bool(k, v); }
            }
        }
    }

    // Now-Playing view — layout mode + window mode switch.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            IconButton {
                icon: @image-url("../../assets/icons/layout-grid.svg");
                icon-size: 16px;
                btn-width: 32px;
                tooltip: @tr("Now Playing view");
                clicked => { npb-view-menu.show(); }
            }
            npb-view-menu := NowPlayingViewMenu {
                media-action(k, i, a) => { root.media-action(k, i, a); }
            }
        }
    }
}
