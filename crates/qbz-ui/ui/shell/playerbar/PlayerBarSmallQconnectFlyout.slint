// PlayerBarSmall Qobuz Connect flyout — status, device picker,
// connect/disconnect toggle. Reuses the same QconnectStatusHeader /
// QconnectDeviceList / QconnectToggleButton sub-components as PlayerBar's
// QconnectFlyout.slint, but keeps Small's own homologated position (bottom
// flush just above the 3px seekbar strip, bar top edge ≈ -6.5) instead of
// PlayerBar's full-height-bar position — the two bars differ by 1px here,
// so the wrapper stays separate while the guts are shared.
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own file.

import { Theme } from "../../foundation/semantic-colors.slint";
import { Radius } from "../../foundation/radius.slint";
import { QconnectStatusHeader } from "QconnectStatusHeader.slint";
import { QconnectDeviceList } from "QconnectDeviceList.slint";
import { QconnectToggleButton } from "QconnectToggleButton.slint";

export component PlayerBarSmallQconnectFlyout inherits PopupWindow {
    // Inner Rectangle FILLS the popup, so the visible bottom == y + height.
    // Homologated to -7 (flush just above the 3px seekbar; bar top ≈ -6.5).
    x: 32px - 280px;
    y: -251px;
    width: 280px;
    height: 244px;
    close-policy: close-on-click-outside;

    // True while a Connect click is discovering renderers (the flyout stays
    // open and shows a spinner until devices arrive or the 8s timer bounds
    // it). UI-only — there is no `discovering` flag in QconnectDevState.
    property <bool> connecting: false;

    Rectangle {
        background: Theme.surface-main;
        border-radius: Radius.sm;
        border-width: 1px;
        border-color: Theme.border-muted;
        drop-shadow-blur: 22px;
        drop-shadow-color: Theme.card-shadow;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            QconnectStatusHeader { }

            // Discovery timer — bounds the spinner so the "no devices" empty
            // state shows if none appear within ~8s. Started on a Connect
            // click; reset on disconnect (see the toggle button below).
            qc-discover-timer := Timer {
                interval: 8s;
                running: false;
                triggered => {
                    root.connecting = false;
                    self.running = false;
                }
            }

            QconnectDeviceList {
                connecting: root.connecting;
                device-picked(id) => {
                    root.close();
                }
            }

            QconnectToggleButton {
                connected => {
                    root.connecting = true;
                    qc-discover-timer.running = true;
                }
                disconnected => {
                    root.connecting = false;
                    qc-discover-timer.running = false;
                    root.close();
                }
            }
        }
    }
}
