// PlayerBarSmall now-playing view menu — layout mode + window mode switch.
// Unlike PlayerBar's NowPlayingViewMenu.slint (unconditional full item
// list), Small's menu GATES the New/Classic/Small/Large rows (and the
// divider) behind `!ShellState.kiosk-profile` — in kiosk the button itself
// short-circuits straight to "Desktop mode" (see
// PlayerBarSmallActionButtons.slint) rather than opening a one-item menu.
// Own homologated geometry (content-sized: 6 rows + divider), so this stays
// a separate file rather than the shared NowPlayingViewMenu.
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own file.

import { Theme } from "../../foundation/semantic-colors.slint";
import { ContextMenu } from "../../primitives/ContextMenu.slint";
import { ContextMenuItem } from "../../primitives/ContextMenuItem.slint";
import { ShellState } from "../../state.slint";

export component PlayerBarSmallViewModeMenu inherits PopupWindow {
    callback media-action(string, string, string);

    // Anchored just above the button at its natural content height. The
    // inner ContextMenu is CONTENT-sized (6 rows × 33px + a 7px divider +
    // the ContextMenu's 5px+5px vertical padding = 215px), so the popup
    // height MUST match that content height — otherwise the rows top-align
    // and leave empty slack at the bottom, floating the visible menu high
    // above the bar. With height == content, `y + height` is the true
    // visible bottom, homologated to the other flyouts at -7 (bottom flush
    // just above the 3px seekbar; bar top edge sits at ≈ -6.5).
    x: 32px - 196px;
    y: -222px;
    width: 196px;
    height: 215px;
    close-policy: close-on-click;

    ContextMenu {
        if !ShellState.kiosk-profile: ContextMenuItem {
            icon: @image-url("../../assets/icons/panel-left.svg");
            label: @tr("New");
            selected: ShellState.npb-mode == 0;
            clicked => {
                root.media-action("npb-view", "", "new");
            }
        }
        if !ShellState.kiosk-profile: ContextMenuItem {
            icon: @image-url("../../assets/icons/panel-right-close.svg");
            label: @tr("Classic");
            selected: ShellState.npb-mode == 1;
            clicked => {
                root.media-action("npb-view", "", "classic");
            }
        }
        if !ShellState.kiosk-profile: ContextMenuItem {
            icon: @image-url("../../assets/icons/rows-3.svg");
            label: @tr("Small");
            selected: ShellState.npb-mode == 2;
            clicked => {
                root.media-action("npb-view", "", "small");
            }
        }
        if !ShellState.kiosk-profile: ContextMenuItem {
            icon: @image-url("../../assets/icons/layout-grid.svg");
            label: @tr("Large");
            selected: ShellState.npb-mode == 3;
            // Large is gated on the open sidebar (the cover + spectrum dock
            // there). Switching from Small forces the sidebar open (Rust
            // npb-view "large" arm), so it stays selectable regardless of
            // the current sidebar state.
            enabled: true;
            clicked => {
                root.media-action("npb-view", "", "large");
            }
        }
        if !ShellState.kiosk-profile: Rectangle {
            height: 7px;
            Rectangle {
                height: 1px;
                y: 3px;
                background: Theme.border-subtle;
            }
        }
        if !ShellState.kiosk-profile: ContextMenuItem {
            icon: @image-url("../../assets/icons/picture-in-picture-2.svg");
            label: @tr("Miniplayer");
            clicked => {
                root.media-action("npb-view", "", "miniplayer");
            }
        }
        if !ShellState.kiosk-profile: ContextMenuItem {
            icon: @image-url("../../assets/icons/maximize-2.svg");
            label: @tr("Immersive");
            clicked => {
                root.media-action("npb-view", "", "immersive");
            }
        }
        ContextMenuItem {
            icon: @image-url("../../assets/icons/hard-drive.svg");
            label: ShellState.kiosk-profile ? @tr("Desktop mode") : @tr("Kiosk mode");
            clicked => {
                root.media-action("npb-view", "", "toggle-profile");
            }
        }
    }
}
