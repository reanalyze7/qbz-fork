// PlayerBarSmall separator — thin vertical line reused inside the controls
// row (left zone: song-card vs time column; right zone: AudioStamp vs the
// icon cluster). A 1px line, border-subtle, ~60% of the row height,
// vertically centred. The horizontal spacing on each side is the caller's
// responsibility (gap property) so #6 can breathe more than #5.
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own file.

import { Theme } from "../../foundation/semantic-colors.slint";

export component PlayerBarSmallSep inherits HorizontalLayout {
    in property <length> gap: 6px;
    // Per-side overrides (default to `gap`) so a separator can sit a bit
    // closer to one neighbour than the other.
    in property <length> gap-left: root.gap;
    in property <length> gap-right: root.gap;
    // A NESTED layout defaults to horizontal-stretch:1 (greedy) in Slint —
    // without this the Sep ATE the row's spare width, centring its 1px line
    // in a huge box ("un chingo de espacio") and starving the song card so
    // its text elided early with lots of empty space to the right. Pin it to
    // 0 so the Sep is exactly `gap-left + 1px + gap-right` and the card
    // keeps the rest.
    horizontal-stretch: 0;
    alignment: center;
    padding-left: root.gap-left;
    padding-right: root.gap-right;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 1px;
            // ~60% of the ~39px controls row.
            height: 24px;
            background: Theme.border-subtle;
        }
    }
}
