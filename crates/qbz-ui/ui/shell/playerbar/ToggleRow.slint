// A labelled toggle row for the audio-settings popover.
// Extracted from PlayerBar.slint (2026-08-20) — same component, new file.

import { Theme } from "../../foundation/semantic-colors.slint";
import { QbzToggle } from "../../primitives/QbzToggle.slint";

export component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);

    height: 44px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: 13px;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.text-muted;
                font-size: 10px;
            }
        }
        VerticalLayout {
            alignment: center;
            QbzToggle {
                checked: root.checked;
                toggled(v) => {
                    root.toggled(v);
                }
            }
        }
    }
}
