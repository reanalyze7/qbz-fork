// PlayerBarSmall secondary action buttons — Connect, Cast, audio settings,
// now-playing view, lyrics. Popovers live in their own files
// (PlayerBarSmallQconnectFlyout, PlayerBarSmallAudioSettingsPopover,
// PlayerBarSmallViewModeMenu); this component just owns the buttons that
// open them. The Connect button itself IS the shared ConnectButton.slint
// (byte-for-byte identical need — tooltip left unset/empty, matching Small's
// original no-tooltip behaviour); the popovers stay Small-specific because
// their geometry/gating differs from PlayerBar's (see each file's header).
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own file.

import { IconButton } from "../../primitives/BarControls.slint";
import { ConnectButton } from "ConnectButton.slint";
import { PlayerBarSmallQconnectFlyout } from "PlayerBarSmallQconnectFlyout.slint";
import { PlayerBarSmallAudioSettingsPopover } from "PlayerBarSmallAudioSettingsPopover.slint";
import { PlayerBarSmallViewModeButton } from "PlayerBarSmallViewModeButton.slint";
import { ShellState, NowPlayingState, CastState, CastActions } from "../../state.slint";

export component PlayerBarSmallActionButtons inherits HorizontalLayout {
    callback media-action(string, string, string);
    callback settings-bool(string, bool);

    spacing: 1px;

    // Connect — golden when a session is on; opens the connect flyout
    // (self-contained upward PopupWindow, verbatim from PlayerBar so Small
    // drives the same device picker path).
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            ConnectButton {
                active: NowPlayingState.qconnect-connected;
                clicked => {
                    qconnect-menu.show();
                }
            }
            qconnect-menu := PlayerBarSmallQconnectFlyout { }
        }
    }

    // Cast (Chromecast / DLNA) — opens the cast picker modal.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            IconButton {
                icon: @image-url("../../assets/icons/cast.svg");
                icon-size: 16px;
                btn-width: 32px;
                tooltip: @tr("Cast");
                active: NowPlayingState.cast-active;
                clicked => {
                    CastState.picker-open = true;
                    CastActions.open();
                }
            }
        }
    }

    // Settings — the SAME audio-menu flyout as New/Classic (Normalization +
    // Gapless), a popup not a single toggle.
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            IconButton {
                icon: @image-url("../../assets/icons/settings-2.svg");
                icon-size: 16px;
                btn-width: 32px;
                tooltip: @tr("Audio settings");
                // Neutral always: this button opens a flyout, so its colour
                // should NOT reflect a toggle (normalization).
                active: false;
                clicked => {
                    audio-menu.show();
                }
            }
            audio-menu := PlayerBarSmallAudioSettingsPopover {
                settings-bool(k, v) => {
                    root.settings-bool(k, v);
                }
            }
        }
    }

    // ViewMode — the layout-menu flyout (how you exit Small).
    PlayerBarSmallViewModeButton {
        media-action(k, i, a) => {
            root.media-action(k, i, a);
        }
    }

    // Lyrics — desktop-only. In kiosk the panel isn't mounted and the
    // Playing view carries a Cover<->Lyrics toggle instead.
    if !ShellState.kiosk-profile: VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("../../assets/icons/mic-vocal.svg");
            icon-size: 16px;
            btn-width: 32px;
            tooltip: @tr("Lyrics");
            active: ShellState.lyrics-open;
            clicked => {
                ShellState.lyrics-open = !ShellState.lyrics-open;
            }
        }
    }
}
