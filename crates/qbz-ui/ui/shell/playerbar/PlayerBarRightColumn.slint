// PlayerBar RIGHT column — secondary actions + volume + queue toggle.
// Extracted from PlayerBar.slint (2026-08-20), mirrors
// PlayerBarLeftColumn/PlayerBarCentreColumn.
//
// Owner change (2026-08-21): the component root IS the HorizontalLayout now
// (was a Rectangle wrapping one). Its width is bound (in PlayerBar.slint) to
// the SAME value as the left column so the centre transport cluster stays
// exactly window-centred. The LEADING filler below packs this column's real
// content (badge/volume/queue) against the right window wall (owner
// preference — tried packing it against the controls instead, owner wanted
// it back at the wall).

import { IconButton } from "../../primitives/BarControls.slint";
import { PlayerBarActionButtons } from "PlayerBarActionButtons.slint";
import { VolumeCluster } from "VolumeCluster.slint";
import { ShellState } from "../../state.slint";

export component PlayerBarRightColumn inherits HorizontalLayout {
    in property <bool> volume-locked: false;
    callback settings-bool(string, bool);

    spacing: 1px;
    Rectangle { horizontal-stretch: 1; }
    PlayerBarActionButtons {
        settings-bool(k, v) => { root.settings-bool(k, v); }
    }
    Rectangle { width: 6px; }
    VolumeCluster {
        locked: root.volume-locked;
    }
    Rectangle { width: 6px; }
    // Queue panel toggle.
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("../../assets/icons/list-ordered.svg");
            icon-size: 24px;
            tooltip: @tr("Queue");
            active: ShellState.queue-open;
            clicked => {
                ShellState.queue-open = !ShellState.queue-open;
            }
        }
    }
}
