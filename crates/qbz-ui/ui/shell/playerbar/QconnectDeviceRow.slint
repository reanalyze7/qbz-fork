// One row of the Qobuz Connect device picker — icon by device type, name (or
// "Play here" for the local device), active dot.
// Extracted from PlayerBar.slint (2026-08-20) — same markup, new file.

import { Theme } from "../../foundation/semantic-colors.slint";
import { Radius } from "../../foundation/radius.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";
import { QconnectDevice } from "../../state.slint";

export component QconnectDeviceRow inherits Rectangle {
    in property <QconnectDevice> device;
    callback clicked();

    height: 34px;
    border-radius: Radius.sm;
    background: row-ta.has-hover ? Theme.surface-hover : transparent;
    row-ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                // Device-type icon, mirroring Qobuz Connect (computer / web /
                // mobile / speaker). @image-url needs a literal, so pick
                // among the four by the device's icon key.
                source: root.device.icon == "mobile"
                    ? @image-url("../../assets/icons/smartphone.svg")
                    : root.device.icon == "speaker"
                        ? @image-url("../../assets/icons/speaker.svg")
                        : root.device.icon == "web"
                            ? @image-url("../../assets/icons/globe.svg")
                            : @image-url("../../assets/icons/monitor.svg");
                width: 14px;
                height: 14px;
                tint: root.device.is-active ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            text: root.device.is-local ? @tr("Play here") : root.device.name;
            color: root.device.is-active ? Theme.text-primary : Theme.text-secondary;
            font-size: 12px;
            font-weight: root.device.is-active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Active indicator dot (no pill).
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.device.is-active ? Theme.accent : transparent;
            }
        }
    }
}
