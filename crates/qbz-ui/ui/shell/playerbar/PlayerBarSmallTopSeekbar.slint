// PlayerBarSmall top full-width seekbar — the content/bar divider. No side
// padding so it spans edge-to-edge; show-times:false hides the labels (the
// controls row carries its own time column). Centred in the thin 3px strip;
// same NowPlayingState seek wiring as New.
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own file.

import { SeekBar } from "../SeekBar.slint";
import { NowPlayingState } from "../../state.slint";

export component PlayerBarSmallTopSeekbar inherits Rectangle {
    height: 3px;
    clip: false;
    VerticalLayout {
        // Pull the seekbar ~2px UP so the progress line hugs the very top
        // edge of the bar (the content/NPB divider) instead of sitting
        // centred with slack above it.
        y: -2px;
        alignment: center;
        SeekBar {
            show-times: false;
            progress: NowPlayingState.progress;
            cache: NowPlayingState.cache;
            seekable-max: NowPlayingState.seekable-max;
            elapsed: NowPlayingState.elapsed;
            remaining: NowPlayingState.remaining;
            duration-secs: NowPlayingState.duration-secs;
            seek(fraction) => {
                NowPlayingState.seek(fraction);
            }
        }
    }
}
