// Qobuz Connect / Disconnect button. Extracted from QconnectFlyout.slint
// (2026-08-20) — the connecting/timer state stays owned by the flyout, this
// component only toggles the session and reports which direction happened.

import { Theme } from "../../foundation/semantic-colors.slint";
import { Radius } from "../../foundation/radius.slint";
import { NowPlayingState } from "../../state.slint";

export component QconnectToggleButton inherits Rectangle {
    callback connected();
    callback disconnected();

    height: 34px;
    border-radius: Radius.sm;
    background: ta.pressed
        ? Theme.accent-pressed
        : ta.has-hover ? Theme.accent-hover : Theme.accent;
    ta := TouchArea {
        clicked => {
            // Read the PRE-toggle state first: it decides which direction
            // just happened. Reading it after qconnect-toggle() would see
            // the new value and invert the branch.
            if (NowPlayingState.qconnect-connected) {
                NowPlayingState.qconnect-toggle();
                root.disconnected();
            } else {
                NowPlayingState.qconnect-toggle();
                root.connected();
            }
        }
    }
    Text {
        text: NowPlayingState.qconnect-connected
            ? @tr("Disconnect")
            : @tr("Connect");
        color: Theme.accent-text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
