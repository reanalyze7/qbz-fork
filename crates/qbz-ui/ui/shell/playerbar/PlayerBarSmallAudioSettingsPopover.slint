// PlayerBarSmall audio settings popover — Normalization + Gapless toggles.
// Same audio-menu flyout as New/Classic, but Small keeps its own
// homologated geometry (a shorter popup nudged to bite the 3px seekbar) so
// it is not the shared AudioSettingsPopover.slint (that one is homologated
// for the full-height PlayerBar and sits 9px higher).
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own file.

import { Theme } from "../../foundation/semantic-colors.slint";
import { Radius } from "../../foundation/radius.slint";
import { QbzToggle } from "../../primitives/QbzToggle.slint";
import { SettingsState } from "../../state.slint";

export component PlayerBarSmallAudioSettingsPopover inherits PopupWindow {
    callback settings-bool(string, bool);

    // Anchored just above the button (bottom ~-8) at its NATURAL height —
    // the two toggle rows only, NO inflated envelope/header (owner: the
    // homologation is the Y anchor, not the size; keep it short like it
    // was). ToggleRow is file-private to PlayerBar, so the rows are built
    // inline with QbzToggle. Inner Rectangle FILLS the popup, so the
    // visible bottom == y + height. Reference flyout: nudged 1px DOWN
    // (-126 -> -125) so the bottom lands at -7, flush just above the 3px
    // seekbar (bar top edge ≈ -6.5) — matching cast/qconnect/layout.
    x: 32px - 252px;
    // Pushed down ~8px vs the computed -125 so it renders biting the
    // seekbar like cast/qconnect/layout (same computed bottom rendered
    // higher for this short popup — homologated empirically).
    y: -117px;
    width: 252px;
    height: 118px;
    close-policy: close-on-click-outside;

    Rectangle {
        background: Theme.surface-main;
        border-radius: Radius.sm;
        border-width: 1px;
        border-color: Theme.border-muted;
        drop-shadow-blur: 22px;
        drop-shadow-color: Theme.card-shadow;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            HorizontalLayout {
                height: 44px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text {
                        text: @tr("Normalization");
                        color: Theme.text-primary;
                        font-size: 13px;
                    }
                    Text {
                        text: @tr("Level loudness across tracks");
                        color: Theme.text-muted;
                        font-size: 10px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    QbzToggle {
                        checked: SettingsState.normalization;
                        toggled(v) => {
                            root.settings-bool("normalization", v);
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 44px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text {
                        text: @tr("Gapless");
                        color: Theme.text-primary;
                        font-size: 13px;
                    }
                    Text {
                        text: @tr("Seamless track transitions");
                        color: Theme.text-muted;
                        font-size: 10px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    QbzToggle {
                        checked: SettingsState.gapless;
                        toggled(v) => {
                            root.settings-bool("gapless", v);
                        }
                    }
                }
            }
        }
    }
}
