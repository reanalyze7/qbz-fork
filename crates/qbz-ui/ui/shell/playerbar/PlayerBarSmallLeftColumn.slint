// PlayerBarSmall LEFT column — album art + 2-line title/artist (SongCard) +
// a fixed 2-row time column (elapsed / duration), separated by PlayerBarSmallSep.
// Extracted from PlayerBarSmall.slint (2026-08-20) — same markup, own component.
// Width is set by the caller (the responsive side-fraction lives in
// PlayerBarSmall.slint, the only place that owns the 39/30/25% breakpoints).

import { Theme } from "../../foundation/semantic-colors.slint";
import { Layout } from "../../foundation/layout.slint";
import { SongCard } from "../SongCard.slint";
import { PlayerBarSmallSep } from "PlayerBarSmallSep.slint";
import { NowPlayingState, AppearanceState } from "../../state.slint";

export component PlayerBarSmallLeftColumn inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    clip: true;
    HorizontalLayout {
        // Zeroed so the Sep owns its full symmetric gap (the layout spacing
        // was DOUBLING the separator gap — adding to the Sep's own padding).
        // The Sep#5 now owns the full 10px reference gap on each side; the
        // song card stretches to fill the rest.
        spacing: 0px;
        // No left inset: the album art is FLUSH to the window's left edge;
        // its 2px border provides the visual edge instead of a margin. On
        // macOS the native window's rounded bottom-left corner (~10pt since
        // Big Sur) masks content at the very corner, so inset the flush-left
        // art there to clear the curve; Linux no-frame corners are square
        // (keep 0).
        padding-left: AppearanceState.is-macos ? 8px : 0px;

        // Art (37px, fits the ~39px controls row + leaves a hair of
        // breathing room) + 2-line title/artist via SongCard. The art gets a
        // 2px subtle border (defines it while flush-left). show-badges
        // false (the AudioStamp lives in the RIGHT set now); the smaller
        // title via the new title-font-size prop. The wrapper takes the
        // row's vertical stretch; the card itself is pinned to the
        // pre-2.0.2 39px top-anchored geometry (Layout.header-height − 3px
        // seekbar) so macOS's taller bar (ShellState.npb-small-extra,
        // Rust-set) lands BELOW the card: the art keeps its exact
        // top-relative position and the meta line gains the extra as bottom
        // clearance (owner ask 2026-07-21). Linux: wrapper height == card
        // height → pixel-identical to before.
        Rectangle {
            horizontal-stretch: 1;
            SongCard {
                width: 100%;
                height: Layout.header-height - 3px;
                y: 0px;
                art-size: 37px;
                art-border-width: 3px;
                art-border-color: Theme.surface-card;
                show-badges: false;
                title-font-size: 13px;
                // Tighten the art -> text gap by 2px (11 -> 9) for Small.
                art-text-gap: 9px;
                text-center: true;
                open-album(id) => {
                    root.open-album(id);
                }
                open-artist(id) => {
                    root.open-artist(id);
                }
                open-context(kind, id) => {
                    root.media-action(kind, id, "open");
                }
                track-info() => {
                    if (!NowPlayingState.is-ephemeral) {
                        root.media-action("track", NowPlayingState.track-id, "track-info");
                    }
                }
            }
        }

        // Separator: song-card (art+text) | time column. 8px toward the
        // song card, +2px (10px) toward the timer (owner ask).
        if NowPlayingState.has-track: PlayerBarSmallSep {
            gap: 8px;
            gap-right: 10px;
        }

        // Time column — a fixed-width 2-row block (elapsed / total), where
        // the quality badge used to sit. Uses EXISTING state only:
        // NowPlayingState.elapsed (already MM:SS) for row 1 and
        // duration-secs formatted MM:SS for row 2.
        if NowPlayingState.has-track: VerticalLayout {
            alignment: center;
            spacing: 1px;
            width: 40px;
            Text {
                text: NowPlayingState.elapsed;
                // Monospace so each digit + the colon hold the SAME
                // position as values change (tabular, alarm-clock style —
                // the proportional UI font shifted the colon).
                font-family: "monospace";
                font-size: 10px;
                color: Theme.text-muted;
                horizontal-alignment: left;
            }
            Text {
                // MM:SS from duration-secs (same arithmetic as SeekBar.fmt).
                text: "\{Math.floor(NowPlayingState.duration-secs / 60)}:\{Math.mod(NowPlayingState.duration-secs, 60) < 10 ? "0" : ""}\{Math.mod(NowPlayingState.duration-secs, 60)}";
                // Monospace for stable digit/colon positions (see above).
                font-family: "monospace";
                font-size: 10px;
                color: Theme.text-muted;
                horizontal-alignment: left;
            }
        }
    }
}
