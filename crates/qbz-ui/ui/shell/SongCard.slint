// Now-playing song card — cover (or a sleeping cat when idle) + title /
// artist·album / optional remote-renderer badge, with the AUDIO STAMP (the
// quality badge stacked over the backend + mode leds) to the right — a fixed
// rectangle. Shared by the now-playing modes and later the miniplayer. Reads
// NowPlayingState + SettingsState directly. Hover tooltips report to the
// global TooltipState (rendered by TooltipOverlay), so this card may be
// clipped without losing them.
//
// `title-avail` (in SongCardGeometry; the title's explicit elide width) is
// `root.width` minus the cover and stamp reservation — layout auto-fill
// failed both ways: content-sized too narrow, or width:100% overflowed the stamp.
//
// Split by visual region across sibling files: SongCardGeometry (derived
// geometry/quality properties), SongCardHelpers (MetaLink + DotLed),
// SongCardArt (cover/idle/spinner/hover-preview) + SongCardBody (composes
// SongCardArt with SongCardInfoDefault/SongCardInfoCentered, the two
// title+meta layouts), SongCardStamp (the audio stamp). This file keeps the
// full public property/callback surface unchanged — every call site needs
// zero edits — and composes the regions.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { NowPlayingState, ShellState } from "../state.slint";
import { SongCardGeometry } from "SongCardGeometry.slint";
import { SongCardBody } from "SongCardBody.slint";
import { SongCardStamp } from "SongCardStamp.slint";

export component SongCard inherits Rectangle {
    in property <length> art-size: 60px;
    in property <bool> show-art: true;
    in property <bool> show-badges: true;
    // Cover border: OFF by default (New/Classic); Small passes a 2px subtle border.
    in property <length> art-border-width: 0px;
    in property <color> art-border-color: transparent;
    // Title font size: Typography.body by default; Small passes smaller.
    in property <length> title-font-size: Typography.body;
    // Artist·album meta line size: 11px by default; PlayerBar bumps it up.
    in property <length> meta-font-size: 11px;
    // Gap between title and artist/album lines; PlayerBar tightens it.
    in property <length> title-meta-gap: 4px;
    // Gap between album art and the title/meta column; Small tightens it.
    in property <length> art-text-gap: 11px;
    // Constrains title+artist to the art image's inner height, vertically
    // CENTRED as a tight group (Small bar). OFF keeps New/Classic's
    // full-height, space-distributed layout.
    in property <bool> text-center: false;
    // Below the responsive break the stamp shrinks 10% to clear the controls
    // column; above it, full size.
    in property <bool> narrow: false;
    // Classic: contained card (elevated bg + shadow, no border). New stays
    // edge-to-edge transparent.
    in property <bool> glass: false;
    // Classic non-responsive uses the FULL-size stamp (1:1 Tauri); New and
    // responsive (narrow) keep the compact stamp.
    in property <bool> compact-stamp: true;
    // New renders output indicators as dot LEDs instead of Classic's chips;
    // the stamp is widened so the longest labels fit.
    in property <bool> dot-leds: false;

    callback open-album(string);
    callback open-artist(string);
    callback open-context(string /* kind */, string /* id */);
    // Tauri fires this from the title click; the bar surfaces it as an
    // explicit small (i) affordance instead.
    callback track-info();

    geom := SongCardGeometry {
        card-width: root.width;
        art-size: root.art-size;
        art-text-gap: root.art-text-gap;
        show-art: root.show-art;
        show-badges: root.show-badges;
        glass: root.glass;
        dot-leds: root.dot-leds;
        compact-stamp: root.compact-stamp;
        narrow: root.narrow;
    }

    // Transparent when the app-wide background is active so the card blends
    // into the translucent player bar instead of an opaque slab.
    background: ShellState.app-background-active
        ? transparent
        : (root.glass ? Theme.surface-elevated : transparent);
    border-radius: root.glass ? 8px : 0px;
    // No border: keeps the album art flush with the card (Tauri parity).
    drop-shadow-blur: root.glass ? 8px : 0px;
    drop-shadow-color: root.glass ? Theme.card-shadow : transparent;

    // Cover + song info ONLY, stopping BEFORE the audio stamp (pinned
    // absolutely below). The 4px gap to the stamp is reserved by the width formula.
    SongCardBody {
        x: geom.pad;
        y: 0;
        height: root.height;
        width: geom.has-stamp
            ? root.width - 2 * geom.pad - geom.stamp-w - 4px
            : root.width - 2 * geom.pad;
        show-art: root.show-art;
        art-size: root.art-size;
        art-border-width: root.art-border-width;
        art-border-color: root.art-border-color;
        art-text-gap: root.art-text-gap;
        text-center: root.text-center;
        title-font-size: root.title-font-size;
        meta-font-size: root.meta-font-size;
        title-meta-gap: root.title-meta-gap;
        title-avail: geom.title-avail;
        ctx-kind: geom.ctx-kind;
        ctx-id: geom.ctx-id;
        open-context(kind, id) => { root.open-context(kind, id); }
        open-artist(id) => { root.open-artist(id); }
        open-album(id) => { root.open-album(id); }
        track-info => { root.track-info(); }
    }

    // Audio stamp: quality badge over two leds, ABSOLUTELY pinned to the
    // card's right edge so it stays flush right regardless of column layout.
    if geom.has-stamp: SongCardStamp {
        x: root.width - geom.pad - geom.stamp-right-margin - geom.stamp-w;
        // Fills the card height so `alignment: center` middle-aligns the badge+LEDs.
        y: 0;
        height: root.height;
        width: geom.stamp-w;
        compact-stamp: root.compact-stamp;
        narrow: root.narrow;
        dot-leds: root.dot-leds;
        show-delivered: geom.show-delivered;
        quality-stamp-tooltip: geom.quality-stamp-tooltip;
    }
}
