// Top header bar — nav tabs left, user element right, search absolutely
// centered on the window (not in a layout column, so it stays centered
// regardless of tab-row/user-element width). Responsive: first breakpoint
// drops tab icons, second narrows the search field.
//
// Thin composer/import surface: keeps the export surface, the
// window-chrome drag/traffic-light math (cross-references
// root.chrome-controls/root.wc-on-left, and HeaderLeft/RightControls read
// the same derivations — so the math stays here while the chrome MARKUP
// lives in HeaderWindowChrome.slint), the responsive properties, and `cache-rendering-hint`
// (perf-critical, must stay on the root — spec 2026-07-19-cpu-idle-
// repaint-617 §9.2). Search/nav/left/right-controls/menu live in sibling
// shell/Header* files.

import { Theme } from "../foundation/semantic-colors.slint";
import { Spacing } from "../foundation/spacing.slint";
import { Layout } from "../foundation/layout.slint";
import { NavState, ContentView, ShellState, AppearanceState } from "../state.slint";
import { HeaderWindowChrome } from "HeaderWindowChrome.slint";
import { HeaderSearch } from "HeaderSearch.slint";
import { HeaderLeftControls } from "HeaderLeftControls.slint";
import { HeaderRightControls } from "HeaderRightControls.slint";

export component HeaderBar inherits Rectangle {
    callback logout();
    callback close-app();
    // Forwarded up to AppShell — the badge flyout's "Sign in" (saved-token
    // re-login while unauthenticated + offline).
    callback recovery-login();
    // Direct route navigation — same `header-menu-navigate` route handler
    // the dropdown menus use.
    callback navigate(string /* route */);

    // #617 per-frame cost: femtovg has no partial rendering, so the animated
    // now-playing equalizer bars repaint the WHOLE window ~8x/sec. This header
    // is static at idle (search cortinilla is a separate AppShell overlay), so
    // cache its subtree to a persistent texture — repaints then blit the cache
    // instead of re-walking + re-tessellating. Invalidates only on real change
    // (typing, hover, resize), not per frame. See spec 2026-07-19-cpu-idle-
    // repaint-617 §9.2.
    cache-rendering-hint: true;

    height: Layout.header-height;
    background: ShellState.app-background-active
        ? Theme.surface-card.with-alpha(AppearanceState.app-background-surface-alpha)
        : Theme.surface-card;

    // Responsive breakpoints.
    property <bool> show-tab-icons: root.width >= 1140px;
    // 80% of the prior search width (was 224px / 320px). When the section nav
    // is in the header (nav-in-sidebar off) it gives up 60px to make room.
    property <length> search-width:
        (root.width < 960px ? 179px : 256px) - (ShellState.nav-in-sidebar ? 0px : 60px);

    // Defensive hotkey-guard hygiene on every page change: release the search
    // field's keyboard focus (a click that navigates does NOT steal focus from
    // a TextInput, so single-key hotkeys stayed dead after a search until the
    // user clicked elsewhere) — an unmounted input's `changed has-focus` never
    // fires false, so this would otherwise leave the guard stuck true.
    property <ContentView> nav-view-probe: NavState.view;
    changed nav-view-probe => {
        header-search.release-focus();
    }

    // --- Custom window chrome (the header IS the title bar) ----------------
    // The header is always present; custom chrome only adds the window
    // controls + drag to it. Linux draws the min/max/close cluster; macOS
    // keeps the native traffic lights (winit overlay attributes) and only
    // needs the drag surface + a left inset under the lights.
    property <bool> chrome-drag-enabled:
        !AppearanceState.system-title-bar-active && !AppearanceState.hide-title-bar;
    property <bool> chrome-controls:
        root.chrome-drag-enabled && !AppearanceState.is-macos
        && AppearanceState.show-window-controls;
    property <bool> wc-on-left: AppearanceState.wc-position-index == 0;
    // 3 × 34px buttons + 2 × 2px spacing (WindowControls.slint).
    property <length> wc-cluster-width: 106px;
    // Left inset: the macOS traffic-light band, or the drawn cluster if left.
    property <length> chrome-left-inset:
        AppearanceState.is-macos && !AppearanceState.system-title-bar-active ? 78px
        : (root.chrome-controls && root.wc-on-left ? root.wc-cluster-width + 6px : 0px);

    // Custom window chrome (drag surface + drawn controls). Instantiated
    // FIRST so every interactive element declared after it wins hit-testing.
    // width/height MUST be pinned: a user-defined component does not inherit
    // the parent's size, and without this the drag surface collapses.
    HeaderWindowChrome {
        width: root.width;
        height: root.height;
        chrome-drag-enabled: root.chrome-drag-enabled;
        chrome-controls: root.chrome-controls;
        wc-on-left: root.wc-on-left;
    }

    // --- Search (absolutely centered on the window) ------------------------
    header-search := HeaderSearch {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        search-width: root.search-width;
    }

    // --- Left controls: history nav + section nav (anchored left) ----------
    HeaderLeftControls {
        x: Spacing.md + root.chrome-left-inset;
        y: (root.height - self.height) / 2;
        show-tab-icons: root.show-tab-icons;
    }

    // --- Right controls: status badge + app menu (anchored right) ----------
    HeaderRightControls {
        x: root.width - self.width - Spacing.md + 2px
            - (root.chrome-controls && !root.wc-on-left ? root.wc-cluster-width + 4px : 0px);
        y: (root.height - self.height) / 2;
        chrome-controls: root.chrome-controls;
        wc-on-left: root.wc-on-left;
        wc-cluster-width: root.wc-cluster-width;
        header-width: root.width;
        recovery-login => { root.recovery-login(); }
        logout => { root.logout(); }
        close-app => { root.close-app(); }
    }
}
