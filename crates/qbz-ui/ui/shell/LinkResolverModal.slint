// "Open Qobuz Link" modal — 1:1 with Tauri's LinkResolverModal.svelte.
// Triggered by Ctrl+L. Paste a Qobuz / Spotify / Apple Music / Tidal /
// Deezer / song.link URL, hit Go; the controller resolves it and navigates.
// A playlist link surfaces a banner handing off to the Playlist Importer.
// The url field sets UiFocusState.text-input-focused on `changed has-focus`
// so single-key global hotkeys don't fire while the user types a URL.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { Spacing } from "../foundation/spacing.slint";
import { LinkResolverState, LinkResolverActions } from "../state.slint";
import { LinkResolverHeader } from "LinkResolverHeader.slint";
import { LinkResolverInputRow } from "LinkResolverInputRow.slint";
import { LinkResolverPlaylistBanner } from "LinkResolverPlaylistBanner.slint";

export component LinkResolverModal inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: LinkResolverState.open;

    if LinkResolverState.open: Rectangle {
        // Scrim — click-outside closes.
        background: #000000bf;
        TouchArea {
            mouse-cursor: default;
            clicked => { LinkResolverActions.close(); }
        }

        // Card-sized FocusScope so Escape closes; locals live on the
        // `if open:` subtree so each remount resets cleanly.
        keys := FocusScope {
            width: Math.min(root.width - 80px, 520px);
            height: panel.preferred-height;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            // NOTE: forward-focus can't target url-input any more now that it
            // lives in LinkResolverInputRow.slint (forward-focus needs its
            // target in the same file). The focus-timer below calls
            // `input-row.focus-input()` instead — same effect.

            key-pressed(event) => {
                if (event.text == Key.Escape) { LinkResolverActions.close(); return accept; }
                return reject;
            }

            // Deferred mount focus — synchronous focus during the remount
            // races layout; a one-shot timer grabs it a tick later.
            focus-timer := Timer {
                interval: 30ms;
                running: true;
                triggered => { self.running = false; input-row.focus-input(); }
            }

            Rectangle {
                border-radius: Radius.md;
                background: Theme.surface-card;
                border-width: 1px;
                border-color: Theme.border-subtle;
                drop-shadow-blur: 32px;
                drop-shadow-color: #00000080;
                // Block scrim click-through.
                TouchArea { }

                panel := VerticalLayout {
                    padding: Spacing.lg;
                    spacing: Spacing.md;

                    // Header: title + close X.
                    LinkResolverHeader { }

                    // Input row: [platform icon][url input][Go].
                    input-row := LinkResolverInputRow { }

                    // Error line.
                    if LinkResolverState.error != "": Text {
                        text: LinkResolverState.error;
                        color: Theme.danger;
                        font-size: Typography.legal;
                        wrap: word-wrap;
                    }

                    // Playlist banner — hand off to the Playlist Importer.
                    if LinkResolverState.playlist-detected: LinkResolverPlaylistBanner { }
                }
            }
        }
    }
}
