// AboutModal header: app branding (logo + name + version) + close X.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { AboutState } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component AboutHeader inherits HorizontalLayout {
    spacing: 16px;
    Image {
        // 128px source (not the 512px original): a ~2.3x downscale renders
        // crisp at 56px, where the 9x downscale from 512 aliased badly
        // (femtovg has no mipmaps).
        source: @image-url("../assets/qoqobuz-logo-128.png");
        width: 56px;
        height: 56px;
        image-fit: contain;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: "Qoqobuz";
            color: Theme.text-primary;
            font-size: Typography.title;
            font-weight: Typography.bold;
        }
        Text {
            text: "v" + AboutState.version;
            color: Theme.text-muted;
            font-size: Typography.legal;
        }
    }
    close-x := TouchArea {
        width: 28px;
        height: 28px;
        mouse-cursor: pointer;
        clicked => {
            AboutState.open = false;
        }
        QbzIcon {
            source: @image-url("../assets/icons/x.svg");
            width: 17px;
            height: 17px;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            tint: close-x.has-hover ? Theme.text-primary : Theme.text-muted;
        }
    }
}
