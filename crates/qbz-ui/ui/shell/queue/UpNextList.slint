// The "UP NEXT" section: the page of upcoming QueueRows, the drag-reorder
// drop-indicator overlay, and the paginator controls.
//
// The drag-reorder state (reorder-active/from/over) lives on the top-level
// QueueSidebar root, NOT here — it's threaded in as `in` properties for
// rendering, and the row gesture callbacks are re-declared and bubbled
// further up via drag-begin/drag-update/drag-end. Get this wrong and
// drag-reorder silently breaks or drags the wrong row (see QueueRow.slint's
// header comment — same risk, one layer further out).
import { Theme } from "../../foundation/semantic-colors.slint";
import { Spacing } from "../../foundation/spacing.slint";
import { Typography } from "../../foundation/typography.slint";
import { QueueState } from "../../state.slint";
import { QueueRow } from "QueueRow.slint";
import { IconButton } from "QueueControls.slint";

export component UpNextList inherits VerticalLayout {
    in property <bool> reorder-active: false;
    in property <int> reorder-from: -1;
    in property <int> reorder-over: -1;
    callback drag-begin(int /* page-local index */, length /* row window-top */);
    callback drag-update(length /* pointer window-y */);
    callback drag-end();

    spacing: 8px;
    // Section header — the count lives in the fixed footer.
    Text {
        text: @tr("UP NEXT");
        color: Theme.text-muted;
        font-size: 11px;
        font-weight: Typography.semibold;
        letter-spacing: 0.5px;
    }
    // Page of upcoming rows + drop-indicator overlay. Explicit height (rows
    // are a fixed 44px, spacing 0) so the wrapping Rectangle does not
    // collapse — a VerticalLayout does not auto-size its parent Rectangle.
    Rectangle {
        height: QueueState.upcoming-page.length * 44px;
        VerticalLayout {
            spacing: 0px;
            for item[idx] in QueueState.upcoming-page: QueueRow {
                item: item;
                index: QueueState.page-start - 1 + idx;
                page-local-index: idx;
                show-number: true;
                removable: true;
                drag-source: root.reorder-active && root.reorder-from == idx;
                clicked => {
                    QueueState.play-upcoming(idx);
                }
                remove => {
                    QueueState.remove-upcoming(idx);
                }
                remove-all-after => {
                    QueueState.remove-all-after(idx);
                }
                add-to-playlist => {
                    QueueState.add-to-playlist(idx);
                }
                drag-begin(local-idx, row-top) => {
                    root.drag-begin(local-idx, row-top);
                }
                drag-update(pointer-y) => {
                    root.drag-update(pointer-y);
                }
                drag-end => {
                    root.drag-end();
                }
            }
        }
        // Drop indicator: a 2px accent line at the insertion slot, hidden
        // for the two no-op slots (from, from+1).
        if root.reorder-active
            && root.reorder-over != root.reorder-from
            && root.reorder-over != root.reorder-from + 1: Rectangle {
            x: 0;
            y: root.reorder-over * 44px - 1px;
            width: parent.width;
            height: 2px;
            background: Theme.accent;
            border-radius: 1px;
        }
    }
    // Paginator — plain text controls, no pills. Only shown when the
    // upcoming list spans >1 page.
    if QueueState.page-count > 1: HorizontalLayout {
        padding-top: 4px;
        alignment: center;
        spacing: Spacing.md;
        IconButton {
            icon: @image-url("../../assets/icons/chevron-left.svg");
            icon-size: 15px;
            enabled: QueueState.page > 0;
            clicked => {
                QueueState.prev-page();
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: @tr("Page {} of {}",
                    QueueState.page + 1,
                    QueueState.page-count);
                color: Theme.text-muted;
                font-size: 12px;
            }
        }
        IconButton {
            icon: @image-url("../../assets/icons/chevron-right.svg");
            icon-size: 15px;
            enabled: QueueState.page < QueueState.page-count - 1;
            clicked => {
                QueueState.next-page();
            }
        }
    }
}
