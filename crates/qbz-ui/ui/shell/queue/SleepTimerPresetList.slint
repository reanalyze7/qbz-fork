// The idle sleep-timer preset picker rows (30 min / 1 hr / ... / Custom).
// Split out of SleepTimerPopover.slint. Rendered inline (not a QbzSelect)
// because a QbzSelect here would nest a PopupWindow inside the sleep-timer
// PopupWindow, which Slint can't open. Reads/writes SleepTimerState
// directly (already a global) — no props needed.
import { Theme } from "../../foundation/semantic-colors.slint";
import { Radius } from "../../foundation/radius.slint";
import { SleepTimerState } from "../../state.slint";

export component SleepTimerPresetList inherits VerticalLayout {
    spacing: 2px;
    for opt[i] in [@tr("30 min"), @tr("1 hr"), @tr("2 hr"), @tr("3 hr"), @tr("5 hr"), @tr("Custom…")]: Rectangle {
        height: 30px;
        border-radius: Radius.sm;
        background: SleepTimerState.selected-index == i
            ? Theme.accent
            : (preset-ta.has-hover ? Theme.surface-hover : transparent);
        Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            text: opt;
            color: SleepTimerState.selected-index == i
                ? Theme.accent-text
                : Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
        }
        preset-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                SleepTimerState.selected-index = i;
            }
        }
    }
}
