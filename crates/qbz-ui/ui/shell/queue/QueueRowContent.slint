// Visual content of a QueueRow: leading track-number/thumbnail, title +
// artist + explicit badge, duration, and the trailing context-menu
// trigger. Pure layout/visuals with no absolute-position or drag-gesture
// coupling, so it's safe to split out of QueueRow.slint (unlike the
// TouchArea drag-reorder logic, which stays there — see that file's
// header comment).
import { Theme } from "../../foundation/semantic-colors.slint";
import { Spacing } from "../../foundation/spacing.slint";
import { Typography } from "../../foundation/typography.slint";
import { Radius } from "../../foundation/radius.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";
import { QueueState, QueueItem } from "../../state.slint";
import { ExplicitBadge } from "QueueControls.slint";

export component QueueRowContent inherits HorizontalLayout {
    in property <QueueItem> item;
    in property <int> index;
    in property <bool> show-number: true;
    in property <bool> removable: false;
    callback menu-requested();

    padding-left: Spacing.sm;
    padding-right: Spacing.xs;
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 9px;

    // Leading: track number (UP NEXT) or thumbnail (History).
    if root.show-number: VerticalLayout {
        alignment: center;
        width: 22px;
        // "Stop after this song" marker replaces the track number on the
        // marked row; otherwise the 1-based track number.
        if root.item.id != QueueState.stop-after-id: Text {
            text: (root.index + 1);
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
        }
        if root.item.id == QueueState.stop-after-id: HorizontalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../../assets/icons/circle-stop.svg");
                width: 13px;
                height: 13px;
                tint: Theme.accent;
            }
        }
    }
    if !root.show-number: Rectangle {
        width: 34px;
        height: 34px;
        border-radius: 4px;
        background: Theme.surface-elevated;
        clip: true;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        if root.item.artwork.width > 0: Image {
            source: root.item.artwork;
            width: 100%;
            height: 100%;
            image-fit: cover;
        }
    }

    // Title + artist.
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.item.title;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: Typography.medium;
                overflow: elide;
            }
            if root.item.explicit: VerticalLayout {
                alignment: center;
                ExplicitBadge {}
            }
        }
        Text {
            text: root.item.artist;
            color: Theme.text-muted;
            font-size: 10px;
            overflow: elide;
        }
    }

    // Duration.
    VerticalLayout {
        alignment: center;
        Text {
            text: root.item.duration;
            color: Theme.text-muted;
            font-size: 11px;
        }
    }

    // Context-menu trigger — UP NEXT rows. Always visible, with a proper
    // 32px hit area (matching the album track rows) so a near-miss never
    // falls through to the row and skips the queue.
    if root.removable: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Radius.sm;
            background: mta.has-hover ? Theme.surface-elevated : transparent;
            QbzIcon {
                source: @image-url("../../assets/icons/ellipsis.svg");
                width: 16px;
                height: 16px;
                x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                tint: mta.has-hover ? Theme.text-primary : Theme.text-muted;
            }
            mta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.menu-requested();
                }
            }
        }
    }
}
