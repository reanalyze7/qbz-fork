// LogViewerModal body: column header + scrolling per-level-colored ListView
// of log rows + empty state.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { LogViewerState } from "../state.slint";
import { ListView } from "std-widgets.slint";

export component LogViewerList inherits VerticalLayout {
    spacing: 14px;

    // ---- Column header (compact, muted).
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            text: @tr("Time");
            width: 80px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
        }
        Text {
            text: @tr("Level");
            width: 48px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
        }
        Text {
            text: @tr("Target");
            width: 140px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
        }
        Text {
            text: @tr("Message");
            horizontal-stretch: 1;
            color: Theme.text-muted;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
        }
    }

    // ---- Body: per-level-colored, scrolling log rows.
    Rectangle {
        vertical-stretch: 1;
        background: Theme.surface-main;
        border-radius: Radius.sm;
        border-width: 1px;
        border-color: Theme.border-subtle;
        clip: true;

        ListView {
            width: 100%;
            height: 100%;
            for row in LogViewerState.rows: Rectangle {
                // Delegate height tracks the wrapped message so long lines
                // aren't clipped (parent reads child preferred height — the
                // supported, non-looping direction).
                height: line.preferred-height;
                line := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    spacing: 10px;
                    Text {
                        text: row.ts;
                        width: 80px;
                        color: Theme.text-muted;
                        font-size: 11px;
                        overflow: elide;
                    }
                    Text {
                        text: row.level;
                        width: 48px;
                        font-size: 11px;
                        font-weight: Typography.semibold;
                        color: row.level == "ERROR" ? #f44336
                            : row.level == "WARN" ? #e0a030
                            : (row.level == "DEBUG" || row.level == "TRACE") ? Theme.text-muted
                            : Theme.text-secondary;
                    }
                    Text {
                        text: row.target;
                        width: 140px;
                        color: Theme.text-muted;
                        font-size: 11px;
                        overflow: elide;
                    }
                    Text {
                        text: row.message;
                        horizontal-stretch: 1;
                        color: Theme.text-primary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Empty-state placeholder.
        if LogViewerState.rows.length == 0: Text {
            text: @tr("No log entries.");
            color: Theme.text-muted;
            font-size: Typography.body;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        }
    }
}
