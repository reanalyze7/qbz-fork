// A single context-menu item row, used by the sort/actions popup in
// SidebarHeader.slint.
import { Theme } from "../../foundation/semantic-colors.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";

export component SidebarMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> selected: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    // When false the row is muted and ignores clicks (Import while
    // offline). Same pattern as ContextMenuItem's enabled.
    in property <bool> enabled: true;
    callback activated();
    height: 30px;
    border-radius: 5px;
    background: (mi-ta.has-hover && root.enabled) ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            QbzIcon {
                source: root.icon;
                width: 14px;
                height: 14px;
                tint: root.danger ? #ef4444 : Theme.text-secondary;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? #ef4444 : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Selected check (sort options).
        if root.selected: VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../../assets/icons/check.svg");
                width: 13px;
                height: 13px;
                tint: Theme.accent;
            }
        }
    }
    mi-ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.activated();
            }
        }
    }
}
