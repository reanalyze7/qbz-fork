// One section-nav row in the sidebar, as an ACCORDION: clicking unrolls its
// destinations directly underneath, and clicking again folds them away.
//
// It used to open a flyout panel to the right, on hover. Two problems with
// that: the panel appeared whenever the pointer merely crossed a nav item on
// its way somewhere else, and it covered the content instead of living in the
// sidebar where the section is.
//
// The MINI sidebar keeps the flyout, because there is nowhere to unroll to —
// the rail is icon-width. So: expanded sidebar accordions, mini sidebar flies
// out. That is why HeaderMenuState is still used below.
//
// Open state is SidebarState.nav-open-index, deliberately NOT
// HeaderMenuState.open-index: the latter is what makes the flyout overlay
// visible, so reusing it would draw the panel on top of the accordion.

import { Theme } from "../../foundation/semantic-colors.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";
import { ShellState, HeaderMenuState, SidebarState, NavMenuEntry } from "../../state.slint";
import { SidebarNavSubRow } from "SidebarNavSubRow.slint";

export component SidebarNavRow inherits VerticalLayout {
    in property <image> icon;
    in property <string> label;
    in property <int> tab-index;
    in property <[NavMenuEntry]> items;
    in property <int> home-item: -1;
    // Leading icon rendered as-is (no theme tint) — the My QBZ custom glyph.
    in property <bool> raw-icon: false;
    in property <bool> disabled: false;
    // A destination was picked. Bubbles to Sidebar, which already owns a
    // `navigate` callback into the shell.
    callback navigate(string /* route */);

    property <bool> open: SidebarState.nav-open-index == root.tab-index;

    spacing: 2px;

    row := Rectangle {
        height: 34px;
        border-radius: 6px;
        background: root.open
            ? Theme.surface-elevated
            : (nav-ta.has-hover ? Theme.surface-hover : transparent);

        HorizontalLayout {
            padding-left: ShellState.sidebar-mini ? 0px : 8px;
            padding-right: ShellState.sidebar-mini ? 0px : 8px;
            spacing: 10px;
            alignment: ShellState.sidebar-mini ? center : stretch;
            VerticalLayout {
                alignment: center;
                if root.raw-icon: Image {
                    source: root.icon;
                    image-fit: contain;
                    width: 16px;
                    height: 16px;
                }
                if !root.raw-icon: QbzIcon {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    tint: root.open || nav-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                }
            }
            if !ShellState.sidebar-mini: Text {
                text: root.label;
                color: root.open || nav-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // Points down when unrolled, right when folded — the affordance
            // that says this row expands rather than navigates.
            if !ShellState.sidebar-mini: VerticalLayout {
                alignment: center;
                QbzIcon {
                    source: root.open
                        ? @image-url("../../assets/icons/chevron-down.svg")
                        : @image-url("../../assets/icons/chevron-right.svg");
                    width: 13px;
                    height: 13px;
                    tint: nav-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                }
            }
        }

        nav-ta := TouchArea {
            enabled: !root.disabled;
            mouse-cursor: pointer;
            clicked => {
                if (ShellState.sidebar-mini) {
                    // No room to unroll — fall back to the flyout. Anchored on
                    // the ROW, not on root: root is the whole accordion now.
                    if (HeaderMenuState.open-index == root.tab-index) {
                        HeaderMenuState.open-index = -1;
                    } else {
                        HeaderMenuState.open-index = root.tab-index;
                        HeaderMenuState.anchor-x = row.absolute-position.x + row.width + 6px;
                        HeaderMenuState.anchor-y = row.absolute-position.y;
                        HeaderMenuState.items = root.items;
                        HeaderMenuState.home-item = root.home-item;
                        HeaderMenuState.from-sidebar = true;
                        HeaderMenuState.title = root.label;
                    }
                } else {
                    SidebarState.nav-open-index = root.open ? -1 : root.tab-index;
                }
            }
        }
    }

    // --- the unrolled destinations ------------------------------------
    if root.open && !ShellState.sidebar-mini: VerticalLayout {
        spacing: 1px;
        for entry[i] in root.items: SidebarNavSubRow {
            entry: entry;
            clicked => {
                if (entry.route != "") {
                    root.navigate(entry.route);
                }
            }
        }
    }
}
