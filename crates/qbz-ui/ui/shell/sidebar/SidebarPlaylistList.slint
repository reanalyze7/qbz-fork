// The scrollable playlist list: a wheel-scrolled Flickable (interactive
// only while NOT dragging, so a playlist drag-and-drop is never hijacked
// into a scroll) + the thin auto-hiding scrollbar pinned to the sidebar's
// right edge. Split out of Sidebar.slint's root VerticalLayout.
//
// Always reserves vertical-stretch:1 so the layout keeps stretching even
// while SidebarState.playlists-collapsed is true (the Flickable/scrollbar
// just aren't mounted in that case — same visual result as the original
// two-sibling-if version, one Rectangle instead of two).
import { Theme } from "../../foundation/semantic-colors.slint";
import { Spacing } from "../../foundation/spacing.slint";
import { ShellState, SidebarState, SidebarActions, DragState } from "../../state.slint";
import { SidebarRow } from "SidebarRow.slint";
import { SidebarScrollbar } from "SidebarScrollbar.slint";

export component SidebarPlaylistList inherits Rectangle {
    vertical-stretch: 1;
    // Both the Flickable and its scrollbar must be siblings under the SAME
    // `if`, not two separate top-level `if`s — a named id (`pl-flick`) is
    // only reachable from within its own conditional's scope.
    if !SidebarState.playlists-collapsed: Rectangle {
        pl-flick := Flickable {
            width: 100%;
            height: 100%;
            interactive: !DragState.active;
            viewport-width: self.width;
            viewport-height: pl-content.preferred-height;
            pl-content := VerticalLayout {
                width: parent.width;
                spacing: 2px;
                alignment: start;
                for entry in SidebarState.entries: SidebarRow {
                    entry: entry;
                    active: entry.kind == "playlist" && entry.id == SidebarState.active-id;
                    show-collage: SidebarState.playlist-collage;
                    open-playlist(id) => { SidebarActions.open-playlist(id); }
                    toggle-folder(id) => { SidebarActions.toggle-folder(id); }
                    move-playlist(pid, fid) => { SidebarActions.move-playlist(pid, fid); }
                    delete-folder(id) => { SidebarActions.delete-folder(id); }
                    edit-playlist(id) => { SidebarActions.edit-playlist(id); }
                    edit-folder(id) => { SidebarActions.edit-folder(id); }
                    hide-playlist(id) => { SidebarActions.hide-playlist(id); }
                    hide-folder(id) => { SidebarActions.hide-folder(id); }
                    add-to-mixtape(id) => { SidebarActions.add-to-mixtape(id); }
                    hover-changed(h) => {
                        pl-sb.hover-rows = h ? pl-sb.hover-rows + 1 : Math.max(0, pl-sb.hover-rows - 1);
                    }
                }
                if SidebarState.entries.length == 0 && !SidebarState.loading: Text {
                    text: @tr("No playlists yet.");
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        // Thin scrollbar pinned to the sidebar's RIGHT EDGE. The +Spacing.md
        // offset cancels the list's right padding so the gutter sits flush
        // against the sidebar border. It appears whenever the pointer is
        // over the scrollable list (hover-rows) or the gutter itself.
        pl-sb := SidebarScrollbar {
            x: parent.width - self.width + (ShellState.sidebar-mini ? 8px : Spacing.md);
            viewport-height: pl-flick.viewport-height;
            flick-height: pl-flick.height;
            viewport-y <=> pl-flick.viewport-y;
        }
    }
}
