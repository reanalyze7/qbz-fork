// Bottom now-playing / transport bar — Default mode.
//
// Three clusters over a full-width seek bar: the SONG CARD (left), the INFO +
// TRANSPORT cluster (absolutely centred so it never drifts with the song-card
// width), and the SECONDARY actions + volume cluster (right).
//
// Split into playerbar/ sub-components on 2026-08-20 (was a single 921-line
// file): this file now only owns the responsive column math (the 39/22/39,
// 30/40/30, 25/50/25 breakpoints) and the ALSA-Direct volume lock — the one
// piece of state genuinely shared by more than one child. Everything else is
// a self-contained component in playerbar/.

import { Theme } from "../foundation/semantic-colors.slint";
import { Layout } from "../foundation/layout.slint";
import { SeekBar } from "SeekBar.slint";
import { PlayerBarLeftColumn } from "playerbar/PlayerBarLeftColumn.slint";
import { PlayerBarCentreColumn } from "playerbar/PlayerBarCentreColumn.slint";
import { PlayerBarRightColumn } from "playerbar/PlayerBarRightColumn.slint";
import { NowPlayingState, ShellState, AppearanceState, SettingsState } from "../state.slint";

export component PlayerBar inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);
    callback settings-bool(string, bool);

    // Mode-aware bar height: Small (npb-mode 2) collapses to one header-tall
    // row (42px); New/Classic keep the full 112px. Computed inline (not on
    // the Layout global) so `Layout` stays a pure leaf with no dependency on
    // the stateful ShellState.
    height: ShellState.npb-mode == 2 ? ShellState.npb-small-height : Layout.player-bar-height;
    background: ShellState.app-background-active
        ? Theme.surface-card.with-alpha(AppearanceState.app-background-surface-alpha)
        : Theme.surface-card;

    // Responsive column zones. The song-card (left) and the buttons (right)
    // share the SAME fraction so they are symmetric — which makes the centre
    // transport column absolutely centred (PLAY lands on the window centre)
    // at every width. The side fraction shrinks as the window grows so the
    // song card / buttons never sprawl on wide screens.
    //   width <  1366  -> 39% | 22% | 39%
    //   1366..<1920    -> 30% | 40% | 30%
    //   width >= 1920  -> 25% | 50% | 25%
    property <float> side-frac: root.width >= 1920px
        ? 0.25
        : (root.width >= 1366px ? 0.30 : 0.39);
    // Classic uses a fixed ~32.4/35.2/32.4 split (the centre song card is
    // 12% narrower than a plain 40% so it isn't oversized in the open view);
    // New uses the responsive side fraction above. BOTH modes keep the two
    // side columns equal so the centre column stays dead centre.
    property <float> col-side: ShellState.npb-mode == 1 ? 0.324 : root.side-frac;
    property <float> col-centre: 1.0 - 2.0 * root.col-side;

    // Volume lock: the local ALSA-Direct (bit-perfect hw) path cannot take
    // a software volume change.
    property <bool> vol-locked: SettingsState.backend-is-alsa && SettingsState.alsa-plugin-is-hw;

    VerticalLayout {
        Rectangle { height: 6px; }

        // Full-width seek bar (6px side margins, times at the ends). In
        // Large the seek arm is LEFT-INSET by the sidebar/cover column width
        // so the bar begins to the right of the docked cover.
        HorizontalLayout {
            padding-left: ShellState.large-active ? ShellState.sidebar-rendered-width : 6px;
            padding-right: 6px;
            SeekBar {
                height: 20px;
                progress: NowPlayingState.progress;
                cache: NowPlayingState.cache;
                seekable-max: NowPlayingState.seekable-max;
                elapsed: NowPlayingState.elapsed;
                remaining: NowPlayingState.remaining;
                duration-secs: NowPlayingState.duration-secs;
                seek(fraction) => { NowPlayingState.seek(fraction); }
            }
        }

        Rectangle { height: 6px; }

        // Row is NOT inset (padding-left == padding-right == 6px): that is
        // what keeps the centre transport on the WINDOW centre (symmetric
        // side columns). In Large only the LEFT song card's CONTENT is
        // shifted right to clear the docked cover (handled inside
        // PlayerBarLeftColumn) — the row itself stays symmetric so PLAY
        // stays dead-centre.
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 0px;

            PlayerBarLeftColumn {
                width: (parent.width - 12px) * root.col-side;
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
                media-action(k, i, a) => { root.media-action(k, i, a); }
            }

            PlayerBarCentreColumn {
                width: (parent.width - 12px) * root.col-centre;
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
                media-action(k, i, a) => { root.media-action(k, i, a); }
            }

            PlayerBarRightColumn {
                width: (parent.width - 12px) * root.col-side;
                volume-locked: root.vol-locked;
                media-action(k, i, a) => { root.media-action(k, i, a); }
                settings-bool(k, v) => { root.settings-bool(k, v); }
            }
        }
        Rectangle { height: 6px; }
    }
}
