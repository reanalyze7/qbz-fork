// Bottom now-playing / transport bar — the single Large layout.
//
// Three clusters over a full-width seek bar: the SONG CARD (left, STRETCHES
// to fill all leftover width so a long title gets real room), the INFO +
// TRANSPORT cluster (centre, hugs its own content — no longer forced to a
// wide fixed-fraction box), and the SECONDARY actions + volume cluster
// (right, also content-hugging).
//
// Owner change (2026-08-21): dropped the old symmetric 39/22/39 (etc.)
// column-fraction system in favour of a two-step one: the centre column
// hugs its OWN content (just the transport cluster's real width, not a wide
// fixed fraction), then BOTH side columns get bound to the exact same
// computed width — (row width − centre's actual width − gaps) / 2 — so
// PLAY stays dead-centre (equal side columns) while the freed-up space
// (the old fraction minus the cluster's real width) goes to the title AND
// the right cluster equally. A plain `horizontal-stretch: 1` on both sides
// does NOT do this: stretch adds extra space on TOP of each side's own
// preferred width, and the right column's preferred width (real buttons +
// slider) is much bigger than the title's (min-width: 0px), so equal
// stretch factors still produced very unequal final widths.
//
// Split into playerbar/ sub-components on 2026-08-20 (was a single 921-line
// file): this file owns the ALSA-Direct volume lock — the one piece of state
// genuinely shared by more than one child. Everything else is a
// self-contained component in playerbar/.

import { Theme } from "../foundation/semantic-colors.slint";
import { Layout } from "../foundation/layout.slint";
import { SeekBar } from "SeekBar.slint";
import { PlayerBarLeftColumn } from "playerbar/PlayerBarLeftColumn.slint";
import { PlayerBarCentreColumn } from "playerbar/PlayerBarCentreColumn.slint";
import { PlayerBarRightColumn } from "playerbar/PlayerBarRightColumn.slint";
import { NowPlayingState, ShellState, AppearanceState, SettingsState } from "../state.slint";

export component PlayerBar inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);
    callback settings-bool(string, bool);

    height: Layout.player-bar-height;
    background: ShellState.app-background-active
        ? Theme.surface-card.with-alpha(AppearanceState.app-background-surface-alpha)
        : Theme.surface-card;

    // Volume lock: the local ALSA-Direct (bit-perfect hw) path cannot take
    // a software volume change.
    property <bool> vol-locked: SettingsState.backend-is-alsa && SettingsState.alsa-plugin-is-hw;

    // Equal width for BOTH side columns: whatever the row has left after the
    // centre cluster's own real width (centre-col.width) and the row's
    // padding (2 * 6px) + the two 24px inter-column gaps, split in half.
    // This — not `horizontal-stretch` — is what keeps the transport cluster
    // exactly window-centred while still freeing up real space for the
    // title (see the header note above).
    // `preferred-width` (the cluster's intrinsic content size), NOT `width`
    // — binding a sibling's explicit width to another sibling's LAYOUT-
    // RESOLVED width inside the same HorizontalLayout is a cycle (the layout
    // pass needs left/right's widths to resolve centre's width, and vice
    // versa). `preferred-width` is the bottom-up intrinsic size, computed
    // independently of that pass, so it breaks the loop.
    property <length> col-side-width: Math.max(0px,
        (root.width - 12px - 48px - centre-col.preferred-width) / 2);

    VerticalLayout {
        Rectangle { height: 6px; }

        // Full-width seek bar (6px side margins, times at the ends). In
        // Large the seek arm is LEFT-INSET by the sidebar/cover column width
        // so the bar begins to the right of the docked cover.
        HorizontalLayout {
            padding-left: ShellState.large-active ? ShellState.sidebar-rendered-width : 6px;
            padding-right: 6px;
            SeekBar {
                height: 20px;
                progress: NowPlayingState.progress;
                cache: NowPlayingState.cache;
                seekable-max: NowPlayingState.seekable-max;
                elapsed: NowPlayingState.elapsed;
                remaining: NowPlayingState.remaining;
                duration-secs: NowPlayingState.duration-secs;
                seek(fraction) => { NowPlayingState.seek(fraction); }
            }
        }

        Rectangle { height: 6px; }

        // Row is NOT inset (padding-left == padding-right == 6px): that is
        // what keeps the centre/right columns content-hugging. In Large the
        // LEFT song card's CONTENT is additionally shifted right to clear
        // the docked cover (handled inside PlayerBarLeftColumn).
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 6px;
            padding-right: 6px;
            // Breathing room between the title and the transport cluster
            // (and symmetrically, transport and the right cluster). 12->24.
            spacing: 24px;

            PlayerBarLeftColumn {
                // Bound to the SAME width as the right column (below) so
                // the centre cluster — sized to its own real content — is
                // exactly window-centred, whatever that shared width works
                // out to.
                width: root.col-side-width;
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
                media-action(k, i, a) => { root.media-action(k, i, a); }
            }

            centre-col := PlayerBarCentreColumn {
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
                media-action(k, i, a) => { root.media-action(k, i, a); }
            }

            PlayerBarRightColumn {
                width: root.col-side-width;
                volume-locked: root.vol-locked;
                settings-bool(k, v) => { root.settings-bool(k, v); }
            }
        }
        Rectangle { height: 6px; }
    }
}
