// DiscoverBrowseView's scrolling content: loading spinner, empty-search
// state, the album grid/list itself (viewport-windowed), and the bottom
// load-more spinner. Extracted so the parent stays under the line budget;
// lives inside the parent's Flickable, so windowing inputs (visible-top/
// visible-height) are forwarded in rather than read from `flick` directly.

import { Theme } from "../foundation/semantic-colors.slint";
import { DiscoverBrowseState } from "../state.slint";
import { AlbumCollectionView } from "AlbumCollectionView.slint";
import { LoadingSpinner } from "../primitives/LoadingSpinner.slint";

export component DiscoverBrowseListBody inherits VerticalLayout {
    in property <length> album-w: 200px;
    in property <length> album-h: 266px;
    in property <length> gap: 24px;
    in property <length> list-row-gap: 4px;
    in property <length> visible-top: 0px;
    in property <length> visible-height: 0px;
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    padding-left: 32px;
    padding-right: 32px;
    padding-top: 8px;
    padding-bottom: 100px;
    spacing: 0px;
    alignment: start;

    if DiscoverBrowseState.loading: HorizontalLayout {
        alignment: center;
        LoadingSpinner { size: 36px; }
    }

    // Empty-state when a search filters everything out.
    if !DiscoverBrowseState.loading
        && DiscoverBrowseState.visible.length == 0
        && DiscoverBrowseState.search-query != "": HorizontalLayout {
        alignment: center;
        Text {
            text: @tr("No results found.");
            color: Theme.text-muted;
            font-size: 14px;
        }
    }

    // --- Album collection (grid / list) --------------------
    if !DiscoverBrowseState.loading: AlbumCollectionView {
        albums: DiscoverBrowseState.visible;
        view-mode: DiscoverBrowseState.view-mode;
        is-grouped: false;
        show-source: false;
        card-width: root.album-w;
        card-height: root.album-h;
        card-gap: root.gap;
        list-row-gap: root.list-row-gap;
        // Viewport windowing (Phase 1): only cards near the visible band
        // mount. The offset is the page's padding-top (8px) — the
        // spinner / empty branches are mutually exclusive with the grid,
        // so nothing else sits above it; the grid's one-viewport margin
        // absorbs any small error.
        windowed: true;
        visible-top: root.visible-top;
        visible-height: root.visible-height;
        content-offset: 8px;
        // Element windowing only; artwork stays per-page — pages arrive
        // index-keyed with covers already on the model (id-keyed banding
        // is a future migration).
        open-album(id) => { root.open-album(id); }
        open-artist(id) => { root.open-artist(id); }
        media-action(kind, id, action) => {
            root.media-action(kind, id, action);
        }
    }

    // Bottom load-more spinner while the next page is in flight.
    if DiscoverBrowseState.loading-more: HorizontalLayout {
        alignment: center;
        Rectangle { height: 24px; }
        LoadingSpinner { size: 28px; }
    }
}
