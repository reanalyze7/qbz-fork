// Discover "Customize" modal — Recommendations-tab body: an explainer of
// what the section does plus the cache-window select + refresh-now control.
// Shown only when DiscoverState.active-tab == "recommendations".

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { ExternalRecoState, ExternalRecoActions } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { QbzSelect } from "../primitives/QbzSelect.slint";

export component DiscoverRecoConfig inherits VerticalLayout {
    spacing: 14px;

    // Explainer — what this section is + how the cache window below works
    // (Last.fm / ListenBrainz enrichment).
    Text {
        text: @tr("Qoqobuz uses your Last.fm and ListenBrainz account data when they're connected (if they aren't, we recommend connecting them to enrich this section). Here you set how often that data is fetched — it defaults to 48 hours, or you can request an update right now.");
        color: Theme.text-secondary;
        font-size: Typography.body;
        wrap: word-wrap;
    }

    // Cache window + Refresh now. Reuses the SAME ExternalRecoState.cache-
    // ttl-index binding and the SAME ExternalRecoActions callbacks
    // (set-cache-ttl / refresh-now) as the old floating ExternalRecoView.
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Text {
                text: @tr("Cache window");
                color: Theme.text-muted;
                font-size: Typography.body;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            QbzSelect {
                sm: true;
                menu-width: 140px;
                options: [@tr("24 hours"), @tr("36 hours"), @tr("48 hours"), @tr("72 hours")];
                current-index: ExternalRecoState.cache-ttl-index;
                selected(i) => {
                    ExternalRecoActions.set-cache-ttl(i);
                }
            }
        }
        // Spacer pushes Refresh now to the right edge.
        Rectangle {
            horizontal-stretch: 1;
        }
        refresh-btn := Rectangle {
            width: refresh-row.preferred-width + 24px;
            height: 34px;
            border-radius: Radius.sm;
            border-width: 1px;
            border-color: Theme.border-subtle;
            background: refresh-ta.has-hover ? Theme.surface-hover : Theme.surface-elevated;
            refresh-row := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    QbzIcon {
                        source: @image-url("../assets/icons/refresh-cw.svg");
                        width: 15px;
                        height: 15px;
                        tint: Theme.text-secondary;
                    }
                }
                Text {
                    text: @tr("Refresh now");
                    color: Theme.text-primary;
                    font-size: Typography.body;
                    vertical-alignment: center;
                }
            }
            refresh-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ExternalRecoActions.refresh-now();
                }
            }
        }
    }
}
