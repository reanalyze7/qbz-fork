// Standalone per-row skeletons (Discover > Recommendations) ───────────────
//
// Each owns its own breathing Timer so it can drop into a layout in place
// of a row whose builder has not resolved yet. Shapes mirror the real
// rows: a card carousel (artists/albums) and a slim 4-wide track grid
// (Weekly playlists). Split out of HomeSkeleton.slint (line budget only);
// see that file for the shared Shimmer primitive these compose.
//
// PERFORMANCE NOTE: each of these owns an independent 900ms Timer with its
// own local `phase` (not synchronized with siblings or with HomeSkeleton's
// own timer). If Discover > Recommendations mounts several instances at
// once (one per not-yet-resolved row), that's N independent timers all
// firing `animate opacity` on every Shimmer child, all slightly
// desynchronized — flagged as a possible contributor to reported
// loading-transition jank; not something this split should "fix" silently.

import { Shimmer } from "HomeSkeleton.slint";

// Card-carousel placeholder: title bar + a row of card blocks (art + 2 lines).
export component SkeletonCarouselRow inherits VerticalLayout {
    in property <length> card-size: 180px;
    property <bool> phase: false;
    spacing: 12px;

    Timer {
        interval: 900ms;
        running: true;
        triggered => {
            root.phase = !root.phase;
        }
    }

    Shimmer {
        phase: root.phase;
        width: 180px;
        height: 22px;
    }
    HorizontalLayout {
        spacing: 24px;
        for _ in [0, 1, 2, 3, 4, 5]: VerticalLayout {
            spacing: 8px;
            Shimmer {
                phase: root.phase;
                width: root.card-size;
                height: root.card-size;
            }
            Shimmer {
                phase: root.phase;
                width: root.card-size * 0.7;
                height: 14px;
            }
            Shimmer {
                phase: root.phase;
                width: root.card-size * 0.45;
                height: 12px;
            }
        }
    }
}

// Slim-grid placeholder: title bar + a 4-column x 3-row grid of slim row
// blocks, matching SlimCarousel's 4x3 layout (the Weekly Exploration/Jams rows).
export component SkeletonSlimRow inherits VerticalLayout {
    property <bool> phase: false;
    spacing: 12px;

    Timer {
        interval: 900ms;
        running: true;
        triggered => {
            root.phase = !root.phase;
        }
    }

    Shimmer {
        phase: root.phase;
        width: 180px;
        height: 22px;
    }
    HorizontalLayout {
        spacing: 8px;
        for _ in [0, 1, 2, 3]: Shimmer {
            phase: root.phase;
            height: 60px;
            horizontal-stretch: 1;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        for _ in [0, 1, 2, 3]: Shimmer {
            phase: root.phase;
            height: 60px;
            horizontal-stretch: 1;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        for _ in [0, 1, 2, 3]: Shimmer {
            phase: root.phase;
            height: 60px;
            horizontal-stretch: 1;
        }
    }
}
