// GenreFilterPopup advanced view — search box + scrollable 3-level genre
// tree. Shown when GenreFilterState.advanced is true.

import { Theme } from "../foundation/semantic-colors.slint";
import { GenreFilterState, GenreFilterActions, UiFocusState } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { GenreTreeRowItem } from "GenreTreeRowItem.slint";

export component GenreAdvancedView inherits VerticalLayout {
    spacing: 10px;

    // Search box.
    Rectangle {
        height: 34px;
        border-radius: 6px;
        background: Theme.surface-elevated;
        border-width: 1px;
        border-color: search-input.has-focus ? Theme.border-subtle : Theme.surface-elevated;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                QbzIcon {
                    source: @image-url("../assets/icons/search.svg");
                    width: 14px;
                    height: 14px;
                    tint: Theme.text-muted;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                search-input := TextInput {
                    width: 100%;
                    height: 100%;
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                    text <=> GenreFilterState.search-query;
                    changed has-focus => { UiFocusState.text-input-focused = self.has-focus; }
                    edited => {
                        GenreFilterActions.search(self.text);
                    }
                }
                Text {
                    visible: search-input.text == "";
                    text: @tr("Search genres…");
                    color: Theme.text-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Tree (scrollable).
    Flickable {
        height: 320px;
        viewport-width: self.width;
        viewport-height: tree-col.preferred-height;
        tree-col := VerticalLayout {
            spacing: 1px;
            for entry in GenreFilterState.tree: GenreTreeRowItem {
                node: entry;
                toggle(id) => {
                    GenreFilterActions.toggle(id);
                }
                toggle-expand(id) => {
                    GenreFilterActions.toggle-expand(id);
                }
            }
        }
    }
}
