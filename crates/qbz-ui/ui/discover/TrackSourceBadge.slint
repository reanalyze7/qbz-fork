// Always-visible source badge on TrackCard's artwork — bottom-right, a
// small rounded square (ADR-008: not a pill) showing local (hard-drive) or
// Qobuz (logo) as the track's source.

export component TrackSourceBadge inherits Rectangle {
    in property <string> source;

    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: #000000b3;
    Image {
        source: root.source == "qobuz"
            ? @image-url("../assets/icons/qobuz-logo-filled.svg")
            : @image-url("../assets/icons/hard-drive.svg");
        colorize: root.source == "local" ? #ffffff : transparent;
        width: root.source == "qobuz" ? 18px : 14px;
        height: self.width;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        image-fit: contain;
    }
}
