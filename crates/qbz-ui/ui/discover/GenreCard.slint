// A single genre chip in the GenreFilterPopup simple-grid view.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { GenreChip } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component GenreCard inherits Rectangle {
    in property <GenreChip> chip;
    callback clicked(string);

    height: 38px;
    border-radius: 6px;
    background: root.chip.selected
        ? Theme.accent
        : (ta.has-hover ? Theme.surface-hover : Theme.surface-elevated);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.chip.name;
            color: root.chip.selected ? #ffffff : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.chip.selected ? Typography.medium : Typography.regular;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Check circle.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: root.chip.selected ? #ffffff : Theme.border-muted;
                background: root.chip.selected ? #ffffff : transparent;
                QbzIcon {
                    visible: root.chip.selected;
                    source: @image-url("../assets/icons/check.svg");
                    width: 11px;
                    height: 11px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: Theme.accent;
                }
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked(root.chip.id);
        }
    }
}
