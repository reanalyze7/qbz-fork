// Discover section configurator (Slice 5) — the per-tab "Customize" modal:
// reorder + show/hide the active tab's Discover sections, with a perf-warning
// banner, an enabled/total count, and a Reset-to-defaults footer. No Save
// button — every toggle / move / reset persists live (the controller re-pushes
// config-rows immediately, so the list stays authoritative).
//
// Reuses the codebase modal idiom (self-contained Rectangle, full-window scrim +
// centered panel; mounted LAST in AppShell so declaration order = top z-stack,
// satisfying ADR-009 >= 3000 structurally). There is NO shared Modal component.
//
// Labels are resolved in Rust (DiscoverState.config-rows[].label) — Slint @tr
// needs a literal key and the gettext pipeline is unwired, so section labels are
// English strings (consistent with every other Slint section title). The modal's
// own chrome strings use @tr literals (passthrough today).
//
// The body is one of two mutually-exclusive modes, split into their own
// files: DiscoverSectionConfig.slint (every tab except Recommendations) and
// DiscoverRecoConfig.slint (the Recommendations tab). This file is just the
// scrim + panel chrome (title row + close button) that picks between them.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { DiscoverState, DiscoverActions } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { DiscoverSectionConfig } from "DiscoverSectionConfig.slint";
import { DiscoverRecoConfig } from "DiscoverRecoConfig.slint";

export component DiscoverConfigModal inherits Rectangle {
    visible: DiscoverState.configurator-open;

    if DiscoverState.configurator-open: Rectangle {
        // Scrim — closes on outside click.
        background: #000000bf;
        TouchArea {
            mouse-cursor: default;
            clicked => {
                DiscoverActions.close-configurator();
            }
        }

        // Panel.
        Rectangle {
            width: Math.min(root.width - 80px, 520px);
            height: Math.min(panel.preferred-height, root.height * 0.78);
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            border-radius: Radius.md;
            background: Theme.surface-card;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;
            clip: true;
            // Swallow clicks so they do not fall through to the scrim.
            TouchArea { }

            panel := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Title row + close.
                HorizontalLayout {
                    Text {
                        text: @tr("Customize");
                        color: Theme.text-primary;
                        font-size: Typography.heading;
                        font-weight: Typography.semibold;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    close-x := TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => {
                            DiscoverActions.close-configurator();
                        }
                        QbzIcon {
                            source: @image-url("../assets/icons/x.svg");
                            width: 17px;
                            height: 17px;
                            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                            tint: close-x.has-hover ? Theme.text-primary : Theme.text-muted;
                        }
                    }
                }

                // Section-config body — every tab except Recommendations.
                if DiscoverState.active-tab != "recommendations": DiscoverSectionConfig {
                    // Same cap the inline version used: root.height * 0.78 is
                    // the panel's own height ceiling; 260px approximates the
                    // header + padding chrome above the list.
                    list-max-height: root.height * 0.78 - 260px;
                }

                // Recommendations-tab body.
                if DiscoverState.active-tab == "recommendations": DiscoverRecoConfig { }
            }
        }
    }
}
