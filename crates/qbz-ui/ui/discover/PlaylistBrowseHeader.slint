// PlaylistBrowseView's fixed 56px header — identical geometry to
// DiscoverBrowseHeader: NavButtons + title on the LEFT; search / genre /
// grid-list tools as one group anchored RIGHT at the 32px gutter. Reads
// all state through globals directly (no prop-threading needed).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PlaylistBrowseState, PlaylistBrowseActions, GenreFilterState, GenreFilterActions, ShellState, AppearanceState } from "../state.slint";
import { BrowseSearch, GenreButton, ViewModeToggle } from "BrowseHeaderTools.slint";
import { NavButtons } from "../shell/NavButtons.slint";

export component PlaylistBrowseHeader inherits Rectangle {
    height: 56px;
    background: ShellState.app-background-active ? Theme.surface-main.with-alpha(AppearanceState.app-background-bar-alpha) : Theme.surface-main;

    // Left cluster — nav buttons then the title, inline.
    HorizontalLayout {
        x: 32px;
        y: 25px - self.height / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            NavButtons { }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: PlaylistBrowseState.title;
                color: Theme.text-primary;
                font-size: Typography.section;
                font-weight: Typography.bold;
                vertical-alignment: center;
            }
        }
    }

    // Right cluster — the header tools as one group, anchored right.
    HorizontalLayout {
        x: parent.width - self.preferred-width - 32px;
        y: 25px - self.height / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            BrowseSearch {
                text <=> PlaylistBrowseState.search-query;
                edited => {
                    PlaylistBrowseActions.search-changed();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            GenreButton {
                clicked => {
                    GenreFilterActions.set-context("discover");
                    GenreFilterState.open = !GenreFilterState.open;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            ViewModeToggle {
                mode <=> PlaylistBrowseState.view-mode;
            }
        }
    }
}
