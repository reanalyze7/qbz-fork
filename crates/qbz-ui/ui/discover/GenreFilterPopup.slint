// Filter-by-genre popup — ported from Tauri's GenreFilterPopup.
// Simple grid view (parent genres as selectable chips) plus the Advanced
// view (search + 3-level tree + counts). The selection is shared across
// the three Discover tabs and re-fetches the discover index.
//
// Body views live in GenreAdvancedView.slint / GenreSimpleGrid.slint (which
// in turn use GenreTreeRowItem.slint / GenreCard.slint); this file is the
// popup chrome (header, options row, footer) that composes them.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { GenreFilterState, GenreFilterActions } from "../state.slint";
import { GenreFilterHeader } from "GenreFilterHeader.slint";
import { GenreAdvancedView } from "GenreAdvancedView.slint";
import { GenreSimpleGrid } from "GenreSimpleGrid.slint";

export component GenreFilterPopup inherits Rectangle {
    width: 470px;
    // Hug the content vertically — without an explicit height a
    // Rectangle child fills its parent (the whole view), which made
    // the popup grow to full window height.
    height: content.preferred-height;
    background: Theme.surface-main;
    border-radius: Radius.md;
    border-width: 1px;
    border-color: Theme.border-muted;
    drop-shadow-blur: 28px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 8px;

    content := VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // --- Title row, close button, Remember/Advanced toggles ------
        GenreFilterHeader { }

        // --- Advanced view: search + 3-level genre tree -------------
        if GenreFilterState.advanced: GenreAdvancedView { }

        // --- Simple grid: parent genres as chips ---------------------
        if !GenreFilterState.advanced: GenreSimpleGrid { }

        // --- Footer: Clear filter ------------------------------------
        Rectangle {
            height: 34px;
            border-radius: 6px;
            background: clear-ta.has-hover && GenreFilterState.selected-count > 0
                ? Theme.surface-hover
                : Theme.surface-elevated;
            opacity: GenreFilterState.selected-count > 0 ? 1.0 : 0.5;
            Text {
                text: @tr("Clear filter");
                color: Theme.text-secondary;
                font-size: 13px;
                x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            }
            clear-ta := TouchArea {
                mouse-cursor: GenreFilterState.selected-count > 0 ? pointer : default;
                clicked => {
                    if (GenreFilterState.selected-count > 0) {
                        GenreFilterActions.clear();
                    }
                }
            }
        }
    }
}
