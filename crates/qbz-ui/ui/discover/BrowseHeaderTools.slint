// Shared "View all" header tools — the search box, the genre-filter
// trigger and the grid/list toggle used by the browse pages
// (DiscoverBrowseView, PlaylistBrowseView). Each is a fully self-contained
// component, split one-per-file; this barrel re-exports all three so
// existing `import { BrowseSearch, GenreButton, ViewModeToggle } from
// "discover/BrowseHeaderTools.slint";` call sites keep working unchanged
// (ui-control-alignment-standard: 34px controls, Radius.sm). Each page
// binds its own state: the search text and the view mode are two-way
// properties; GenreButton reads the SHARED GenreFilterState.

export { BrowseSearch } from "BrowseSearchField.slint";
export { GenreButton } from "GenreButton.slint";
export { ViewModeToggle } from "ViewModeToggle.slint";
