// One row of the GenreFilterPopup advanced-view tree: indent + expand
// arrow + checkbox + name + child count.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { GenreTreeRow } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component GenreTreeRowItem inherits Rectangle {
    in property <GenreTreeRow> node;
    callback toggle(string);
    callback toggle-expand(string);

    height: 34px;
    border-radius: 6px;
    background: ta.has-hover || arrow-ta.has-hover ? Theme.surface-hover : transparent;

    // Row click (outside the arrow) toggles selection. Declared FIRST so it
    // sits BELOW the arrow's TouchArea in z-order (later siblings are on top
    // in Slint) — otherwise it swallows the chevron click and sub-genres
    // never expand (#545).
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle(root.node.id);
        }
    }

    HorizontalLayout {
        padding-left: 6px + root.node.level * 18px;
        padding-right: 10px;
        spacing: 6px;

        // Expand arrow (parents / children with kids).
        Rectangle {
            width: 20px;
            VerticalLayout {
                alignment: center;
                if root.node.has-children: QbzIcon {
                    source: root.node.expanded
                        ? @image-url("../assets/icons/chevron-down.svg")
                        : @image-url("../assets/icons/chevron-right.svg");
                    width: 13px;
                    height: 13px;
                    tint: Theme.text-muted;
                }
            }
            arrow-ta := TouchArea {
                // Disabled on leaf rows so the click falls through to the
                // row TouchArea (an enabled TouchArea consumes it even with
                // a no-op handler — 20px selection dead-zone otherwise).
                enabled: root.node.has-children;
                mouse-cursor: root.node.has-children ? pointer : default;
                clicked => {
                    if (root.node.has-children) {
                        root.toggle-expand(root.node.id);
                    }
                }
            }
        }

        // Checkbox.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: root.node.selected ? Theme.accent : Theme.border-muted;
                background: root.node.selected ? Theme.accent : transparent;
                QbzIcon {
                    visible: root.node.selected;
                    source: @image-url("../assets/icons/check.svg");
                    width: 11px;
                    height: 11px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: #ffffff;
                }
            }
        }

        Text {
            text: root.node.name;
            color: root.node.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.node.level == 0 ? Typography.medium : Typography.regular;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.node.count > 0: Text {
            text: root.node.count;
            color: Theme.text-muted;
            font-size: Typography.legal;
            vertical-alignment: center;
        }
    }

}
