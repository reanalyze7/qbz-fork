// ArtistGridCard hover action buttons — follow / play / more — plus the
// "more" button's context menu. Kept together since the menu is a fixed-
// offset PopupWindow anchored inside this row's own coordinate space.

import { SlimItem } from "../state.slint";
import { OverlayButton } from "ArtistGridCardOverlayButton.slint";
import { ContextMenu } from "../primitives/ContextMenu.slint";
import { ContextMenuItem } from "../primitives/ContextMenuItem.slint";

export component ArtistGridCardActions inherits HorizontalLayout {
    in property <SlimItem> artist;
    in property <bool> show-follow: true;
    in property <string> follow-kind: "artist";
    in property <bool> overlay-on: false;
    out property <bool> any-hovered: follow-btn.hovered || play-btn.hovered || more-btn.hovered;
    callback clicked(string);
    callback media-action(string, string, string);

    x: 0px;
    y: 113px;
    width: 190px;
    height: 44px;
    alignment: center;
    spacing: 12px;
    opacity: root.overlay-on ? 1.0 : 0.0;
    animate opacity { duration: 150ms; }

    VerticalLayout {
        alignment: center;
        follow-btn := OverlayButton {
            visible: root.show-follow;
            icon: root.artist.following
                ? @image-url("../assets/icons/check.svg")
                : @image-url("../assets/icons/user-plus.svg");
            active: root.artist.following;
            clicked => {
                root.media-action(root.follow-kind, root.artist.id, "follow");
            }
        }
    }
    play-btn := OverlayButton {
        icon: @image-url("../assets/icons/play-fill.svg");
        primary: true;
        diameter: 44px;
        icon-size: 18px;
        clicked => {
            root.media-action("artist", root.artist.id, "play");
        }
    }
    VerticalLayout {
        alignment: center;
        more-btn := OverlayButton {
            icon: @image-url("../assets/icons/ellipsis.svg");
            clicked => {
                artist-menu.show();
            }
        }
    }

    // Context menu for the "more" button.
    artist-menu := PopupWindow {
        x: 21px;
        y: 143px;
        width: 196px;
        height: 4 * 33px + 10px;
        ContextMenu {
            ContextMenuItem {
                icon: @image-url("../assets/icons/user.svg");
                label: @tr("Open artist");
                clicked => {
                    root.clicked(root.artist.id);
                }
            }
            ContextMenuItem {
                icon: @image-url("../assets/icons/play.svg");
                label: @tr("Play");
                clicked => {
                    root.media-action("artist", root.artist.id, "play");
                }
            }
            if root.show-follow: ContextMenuItem {
                icon: root.artist.following
                    ? @image-url("../assets/icons/check.svg")
                    : @image-url("../assets/icons/user-plus.svg");
                label: root.artist.following ? @tr("Following") : @tr("Follow");
                clicked => {
                    root.media-action(root.follow-kind, root.artist.id, "follow");
                }
            }
            // Reco-scoped dismissal (NOT the blacklist): the artist leaves
            // the Recommendations rails only.
            ContextMenuItem {
                icon: @image-url("../assets/icons/thumbs-down.svg");
                label: @tr("Not interested");
                clicked => {
                    root.media-action("artist", root.artist.id, "not-interested");
                }
            }
        }
    }
}
