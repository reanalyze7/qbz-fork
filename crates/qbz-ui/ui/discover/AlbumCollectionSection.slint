// One group-by section (title + its list rows or card grid) inside
// AlbumCollectionView's grouped mode. Extracted so the parent's grouped/
// flat-grid/flat-list dispatch stays under the line budget.
//
// Grid sections use FULL mounts, NOT windowed — see the comment at the
// `AlbumGrid` instantiation below for why (a proven "Recursion detected"
// runtime panic class tied to absolute-position-based section offsets).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { AlbumCardItem, DiscoverSection } from "../state.slint";
import { AlbumListRow } from "../primitives/AlbumListRow.slint";
import { AlbumGrid } from "AlbumGrid.slint";

export component AlbumCollectionSection inherits VerticalLayout {
    in property <DiscoverSection> section;
    in property <bool> is-first: false;
    in property <string> view-mode: "grid";
    in property <bool> show-source: false;
    in property <bool> show-favorite: true;
    in property <bool> show-source-badge: false;
    in property <bool> select-mode: false;
    in property <length> card-width: 200px;
    in property <length> card-height: 246px;
    in property <length> card-gap: 24px;
    in property <length> list-row-gap: 4px;
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    spacing: 12px;
    if !root.is-first: Rectangle { height: 24px; }
    Text {
        text: root.section.title;
        color: Theme.text-primary;
        font-size: Typography.heading;
        font-weight: Typography.semibold;
    }
    // List view: rows for this section.
    if root.view-mode == "list": VerticalLayout {
        spacing: root.list-row-gap;
        for album[i] in root.section.albums: AlbumListRow {
            album: album;
            index: i;
            show-source: root.show-source;
            select-mode: root.select-mode;
            clicked(id) => {
                root.open-album(id);
            }
            media-action(kind, id, action) => {
                if (kind == "artist") {
                    root.open-artist(id);
                } else {
                    root.media-action(kind, id, action);
                }
            }
        }
    }
    // Grid view: a card grid for this section — FULL mounts, NOT windowed.
    // Windowing a section needs its y inside the scroll content, and
    // measuring that with an absolute-position BINDING is a proven runtime
    // panic ("Recursion detected", field-hit on LL Albums grouped
    // 2026-07-07): evaluating the target-row chain through absolute-
    // position can re-enter the parent layout solver mid-pass (the grid's
    // own height/columns read back self.width). A safe grouped windowing
    // needs Rust-computed per-section offsets — backlog; sections are the
    // smaller win.
    if root.view-mode != "list": AlbumGrid {
        albums: root.section.albums;
        show-favorite: root.show-favorite;
        show-source-badge: root.show-source-badge;
        select-mode: root.select-mode;
        card-width: root.card-width;
        card-height: root.card-height;
        card-gap: root.card-gap;
        open-album(id) => {
            root.open-album(id);
        }
        open-artist(id) => {
            root.open-artist(id);
        }
        media-action(kind, id, action) => {
            root.media-action(kind, id, action);
        }
    }
}
