// Discover > For You "Spotlight" — port of Tauri's SpotlightLite.
// One favorite artist highlighted: a header, a hero (portrait +
// ARTIST + name + play-top-tracks / open-artist circle buttons), and
// a draggable row mixing a TOP TRACKS card and the artist's albums.
// Split into SpotlightHero and SpotlightContentRow (both sibling files);
// this file keeps the header and composes the two.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { ForYouState } from "../state.slint";
import { SpotlightHero } from "SpotlightHero.slint";
import { SpotlightContentRow } from "SpotlightContentRow.slint";

export component Spotlight inherits VerticalLayout {
    callback open-artist(string);
    callback open-album(string);
    callback play-top-tracks(string);
    callback media-action(string, string, string);

    property <length> gap: 24px;
    // Row content width: TopTracks(200) + albums(200 each) + gaps.
    // has-top-tracks toggles the first card.
    property <length> top-tracks-width:
        ForYouState.spotlight-has-top-tracks ? 200px + root.gap : 0px;
    property <int> album-count: ForYouState.spotlight-albums.length;
    property <length> content-width:
        root.top-tracks-width
        + root.album-count * (200px + root.gap);

    spacing: 12px;

    // Header.
    VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Spotlight");
            color: Theme.text-primary;
            font-size: 18px;
            font-weight: Typography.semibold;
        }
        Text {
            text: @tr("Shine a light on one of your favourite artists.");
            color: Theme.text-muted;
            font-size: Typography.legal;
        }
    }

    SpotlightHero {
        open-artist(id) => { root.open-artist(id); }
        play-top-tracks(id) => { root.play-top-tracks(id); }
    }

    Rectangle { height: 4px; }

    SpotlightContentRow {
        content-width: root.content-width;
        gap: root.gap;
        open-album(id) => { root.open-album(id); }
        play-top-tracks(id) => { root.play-top-tracks(id); }
        media-action(kind, id, action) => {
            root.media-action(kind, id, action);
        }
    }
}
