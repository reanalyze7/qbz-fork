// AlbumCard's 200x200 artwork box: cover image, hover scrim, hover meta
// (genre/year), the card-open touch target, checkbox/pin badges, hover
// action buttons + "more" menu, award ribbon, and source badge. Extracted
// so AlbumCard itself stays a thin composition shell (artwork + footer).

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { AlbumCardItem } from "../state.slint";
import { AlbumCardHoverMeta } from "AlbumCardHoverMeta.slint";
import { AlbumCardBadges } from "AlbumCardBadges.slint";
import { AlbumCardRibbon } from "AlbumCardRibbon.slint";
import { AlbumCardSourceBadge } from "AlbumCardSourceBadge.slint";
import { AlbumCardActions } from "AlbumCardActions.slint";

export component AlbumCardArtwork inherits Rectangle {
    in property <AlbumCardItem> album;
    in property <bool> show-favorite: true;
    in property <bool> show-source-badge: false;
    in property <bool> select-mode: false;
    callback clicked(string);
    callback media-action(string, string, string);

    width: 200px;
    height: 200px;
    border-radius: Radius.sm;
    background: Theme.surface-elevated;
    clip: true;

    // The overlay stays up while the pointer is anywhere over the artwork
    // OR over one of its buttons. A child button steals `has-hover` from
    // the artwork detector, so the states are OR-combined.
    property <bool> overlay-on: hover.has-hover
        || badges.pin-hovered || actions.any-hovered;

    // Cover art. Empty until the artwork pipeline resolves it, leaving the
    // elevated placeholder visible underneath.
    Image {
        width: 100%;
        height: 100%;
        source: root.album.artwork;
        image-fit: cover;
    }

    // Hover scrim.
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000;
        opacity: root.overlay-on ? 0.6 : 0.0;
        animate opacity { duration: 150ms; }
    }

    AlbumCardHoverMeta {
        album: root.album;
        overlay-on: root.overlay-on;
    }

    // Card-open + hover detector. Declared before the action buttons so
    // those, when interactive, win the pointer.
    hover := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if (root.select-mode) {
                root.media-action("album", root.album.id, "toggle-select");
            } else {
                root.clicked(root.album.id);
            }
        }
    }

    // Checkbox + pin badge.
    badges := AlbumCardBadges {
        width: 200px;
        height: 200px;
        album: root.album;
        select-mode: root.select-mode;
        overlay-on: root.overlay-on;
    }

    actions := AlbumCardActions {
        album: root.album;
        show-favorite: root.show-favorite;
        select-mode: root.select-mode;
        overlay-on: root.overlay-on;
        clicked(id) => {
            root.clicked(id);
        }
        media-action(kind, id, action) => {
            root.media-action(kind, id, action);
        }
    }

    if root.album.ribbon != "": AlbumCardRibbon {
        y: parent.height - self.height - 8px;
        album: root.album;
    }

    if root.show-source-badge && root.album.source != "": AlbumCardSourceBadge {
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 6px;
        album: root.album;
    }
}
