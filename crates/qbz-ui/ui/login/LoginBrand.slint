// Login screen — brand block (logo + wordmark + subtitle).
// Split out of LoginScreen.slint to keep files under the 130-line cap.

import { Theme } from "../foundation/semantic-colors.slint";
import { Spacing } from "../foundation/spacing.slint";
import { Typography } from "../foundation/typography.slint";

export component LoginBrand inherits VerticalLayout {
    HorizontalLayout {
        alignment: center;
        Image {
            source: @image-url("../assets/qoqobuz-logo.png");
            width: 140px;
            height: 140px;
            image-fit: contain;
        }
    }
    Rectangle { height: Spacing.sm; }
    Text {
        text: @tr("Qoqobuz");
        color: Theme.text-primary;
        font-size: Typography.wordmark;
        font-weight: Typography.semibold;
        letter-spacing: 8px;
        horizontal-alignment: center;
    }
    Rectangle { height: 2px; }
    Text {
        text: @tr("QOBUZ™ PLAYER");
        color: Theme.text-muted;
        font-size: Typography.subtitle;
        letter-spacing: 4px;
        horizontal-alignment: center;
    }
}
