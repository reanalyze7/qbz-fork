// QBZ login screen — first feature screen of the Slint POC.
//
// Visual parity target: the current Svelte `LoginView.svelte` on the QBZ
// dark theme — centered card, logo, wordmark, ToS checkbox, browser
// sign-in button, secondary links, and the legal disclaimer.
//
// No domain logic here: the buttons emit callbacks that the Rust layer
// turns into typed commands (see `src/commands.rs`).
//
// Split into sibling files by visual section to stay under the 130-line
// cap: LoginBrand (logo/wordmark), LoginTosAndAction (checkbox + sign-in
// button), LoginStatusPanel (phase status / error box), and
// LoginOfflineCallouts (offline-boot / init-error / start-offline link).

import { Theme } from "../foundation/semantic-colors.slint";
import { Spacing } from "../foundation/spacing.slint";
import { Radius } from "../foundation/radius.slint";
import { Typography } from "../foundation/typography.slint";
import { LoginBrand } from "LoginBrand.slint";
import { LoginTosAndAction } from "LoginTosAndAction.slint";
import { LoginStatusPanel } from "LoginStatusPanel.slint";
import { LoginOfflineCallouts } from "LoginOfflineCallouts.slint";

export component LoginScreen inherits Rectangle {
    in-out property <bool> tos-accepted: true;

    callback sign-in-via-browser();
    callback cancel-login();
    callback start-offline();
    callback open-tos();

    background: Theme.surface-main;

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 720px;
                background: Theme.surface-card;
                border-radius: Radius.lg;
                drop-shadow-blur: 32px;
                drop-shadow-color: Theme.card-shadow;
                drop-shadow-offset-y: 8px;

                VerticalLayout {
                    padding: Spacing.card-padding;
                    spacing: 0px;

                    LoginBrand { }

                    Rectangle { height: Spacing.xl; }

                    LoginTosAndAction {
                        tos-accepted <=> root.tos-accepted;
                        sign-in-via-browser => { root.sign-in-via-browser(); }
                        open-tos => { root.open-tos(); }
                    }

                    Rectangle { height: Spacing.md; }

                    LoginStatusPanel {
                        cancel-login => { root.cancel-login(); }
                    }

                    Rectangle { height: 10px; }

                    LoginOfflineCallouts {
                        start-offline => { root.start-offline(); }
                    }

                    Rectangle { height: Spacing.xl; }

                    // --- Legal disclaimer ------------------------------------
                    Text {
                        text: @tr("QBZ requires an active Qobuz™ subscription. Your credentials are sent directly to Qobuz™.")
                            + "\n"
                            + @tr("QBZ can be used as an offline player without a Qobuz™ account (no access to the Qobuz™ library).")
                            + "\n"
                            + @tr("This application uses the Qobuz API but is not certified by Qobuz.")
                            + " "
                            + @tr("Qobuz™ is a trademark of Qobuz. QBZ is an open-source application licensed under the MIT License and is not affiliated with, endorsed by, or certified by Qobuz.");
                        color: Theme.text-muted;
                        font-size: Typography.legal;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
