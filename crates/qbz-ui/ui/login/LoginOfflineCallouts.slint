// Login screen — offline-boot callout, init-error callout, and the
// "Start offline" link. Split out of LoginScreen.slint to keep files
// under the 130-line cap.

import { Theme } from "../foundation/semantic-colors.slint";
import { Spacing } from "../foundation/spacing.slint";
import { Radius } from "../foundation/radius.slint";
import { Typography } from "../foundation/typography.slint";
import { QbzTextLink } from "../primitives/QbzTextLink.slint";
import { OfflineState } from "../state.slint";

export component LoginOfflineCallouts inherits VerticalLayout {
    callback start-offline();

    // --- Offline-boot callout (spec §4.1) --------------------
    // No connectivity: point the user at the Start-offline link
    // right below. Gated on has-previous-session too — the link
    // it points at is hidden without prior user data.
    if OfflineState.has-previous-session && OfflineState.connectivity == 2: VerticalLayout {
        spacing: 2px;
        Rectangle {
            background: Theme.surface-elevated;
            border-radius: Radius.sm;
            border-width: 1px;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: @tr("No internet connection — you can start in offline mode with your local library and downloads");
                    color: Theme.text-secondary;
                    font-size: Typography.body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if OfflineState.captive-portal: Text {
                    text: @tr("A network sign-in page may be blocking the connection");
                    color: Theme.text-muted;
                    font-size: Typography.legal;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // Caret pointing at the Start-offline link below.
        Text {
            text: "▼";
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-alignment: center;
        }
    }

    // Init-error variant of the same box (session restore
    // failed for a non-connectivity reason). Hidden while the
    // connectivity box shows — never two boxes at once.
    if OfflineState.login-error != "" && OfflineState.connectivity != 2: VerticalLayout {
        spacing: 0px;
        Rectangle {
            background: Theme.surface-elevated;
            border-radius: Radius.sm;
            border-width: 1px;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: @tr("Could not restore your session");
                    color: Theme.text-primary;
                    font-size: Typography.body;
                    font-weight: Typography.medium;
                    horizontal-alignment: center;
                }
                Text {
                    text: OfflineState.login-error;
                    color: Theme.text-muted;
                    font-size: Typography.legal;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { height: Spacing.sm; }
    }

    // Always visible (#553): without a previous session this
    // opens the GUEST profile (user 0) — Local Library only,
    // adopted by the account on the first real login.
    HorizontalLayout {
        alignment: center;
        QbzTextLink {
            label: @tr("Start offline (no access to Qobuz™ services)");
            clicked => {
                root.start-offline();
            }
        }
    }
}
