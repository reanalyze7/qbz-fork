// AlbumPageView bottom carousels (1:1 with the Qobuz webplayer): "More from
// <artist>" with a View-all link to the artist's releases, then
// "Suggestions" (Qobuz + a second Last.fm-similar-artists row, deduped and
// grouped under the same heading). Each row is gated independently by the
// Rust controller.

import { AlbumState } from "../state.slint";
import { Carousel } from "../discover/Carousel.slint";

export component AlbumCarousels inherits VerticalLayout {
    callback media-action(string, string, string);
    spacing: 0px;

    if AlbumState.show-more-from-artist: Rectangle { height: 40px; }
    if AlbumState.show-more-from-artist: Carousel {
        section: AlbumState.more-from-artist;
        show-view-all: true;
        album-clicked(id) => {
            root.media-action("album", id, "open");
        }
        view-all-clicked => {
            root.media-action("artist", AlbumState.artist-id, "releases");
        }
        media-action(k, i, a) => {
            root.media-action(k, i, a);
        }
    }

    if AlbumState.show-suggestions: Rectangle { height: 40px; }
    if AlbumState.show-suggestions: Carousel {
        section: AlbumState.suggestions-section;
        show-view-all: false;
        album-clicked(id) => {
            root.media-action("album", id, "open");
        }
        media-action(k, i, a) => {
            root.media-action(k, i, a);
        }
    }

    // Second suggestions row, from Last.fm similar artists (one album
    // each), deduped against the Qobuz row above. Hidden unless Last.fm is
    // connected and the row resolved at least one album.
    if AlbumState.show-lastfm-suggestions: Rectangle { height: 14px; }
    if AlbumState.show-lastfm-suggestions: Carousel {
        section: AlbumState.lastfm-suggestions-section;
        show-view-all: false;
        album-clicked(id) => {
            root.media-action("album", id, "open");
        }
        media-action(k, i, a) => {
            root.media-action(k, i, a);
        }
    }
}
