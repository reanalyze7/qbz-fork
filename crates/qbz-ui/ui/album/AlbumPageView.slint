// Album detail page. Mirrors the Svelte AlbumDetailView: back button, an
// album header, a divider, and the track list with a column header.
//
// Split into sibling files under album/ — AlbumPageContent.slint (page
// scaffolding: nav/header/divider/track-section/carousels),
// AlbumHeaderAtmosphere.slint (background), AlbumDescriptionModal.slint;
// several of those further split, see their own doc comments. This file
// stays the single import surface other pages/the shell import.

import { Theme } from "../foundation/semantic-colors.slint";
import { AlbumState, NavState, DragState, ShellState, AppearanceState } from "../state.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { AlbumPageContent } from "./AlbumPageContent.slint";
import { AlbumHeaderAtmosphere } from "./AlbumHeaderAtmosphere.slint";
import { AlbumDescriptionModal } from "./AlbumDescriptionModal.slint";

export component AlbumPageView inherits Rectangle {
    callback open-artist(string);
    callback media-action(string, string, string);

    // Whether the full-description modal is open.
    property <bool> show-description: false;
    // Header description picks the SHORTER cutoff when the content area is
    // space-constrained (window <1366 AND a right panel open), so the tracks
    // keep priority; back to the full short text when there's room.
    property <string> desc-display:
        ShellState.content-constrained
            ? AlbumState.description-shorter
            : AlbumState.description-short;
    // Bound to root.width (not the parent layout) to avoid a binding loop:
    // page padding 32+32, artwork 224, header gap 32.
    property <length> desc-width: root.width - 320px;

    // Header text colors: the header sits on a DARK backdrop when either the
    // album-header-gradient atmosphere is on OR the app-wide dynamic background
    // is active — in both cases the text must be light regardless of theme.
    // `header-atmo-on` gates the album's OWN blurred atmosphere: it is suppressed
    // under the dynamic background (they clash — owner 2026-07-17), so the header
    // shows the dynamic background instead.
    property <bool> header-light: AppearanceState.album-header-gradient || ShellState.app-background-active;
    property <bool> header-atmo-on: AppearanceState.album-header-gradient && !ShellState.app-background-active;
    property <color> hdr-strong: header-light
        ? #ffffff : Theme.text-primary;
    property <color> hdr-body: header-light
        ? #ffffff.with-alpha(0.88) : Theme.text-secondary;

    // With no dark header backdrop the CircleActions sit on the plain theme
    // surface — switch them to the theme-aware on-surface variant so they stay
    // visible on light themes (their default palette is white-on-dark).
    property <bool> hdr-on-surface: !header-light;

    // Atmosphere/gradient extent: the background must end EXACTLY at the
    // header/track-list divider — the header height varies (long editorial
    // descriptions), so a fixed px either overshoots into the track list or
    // fades early. `page.divider-y` is exposed by AlbumPageContent.slint
    // (computed there from its own header-divider element, unreachable by
    // id across this file boundary). The background is absolutely
    // positioned and doesn't participate in the page layout, so this
    // cannot form a binding loop.
    property <length> atmo-height: page.y + page.divider-y;

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    flick := Flickable {
        // Full-width: the background bleeds edge-to-edge so there is no
        // dark right gutter. Content stays clear of the scrollbar via the
        // page's 32px right padding.
        width: parent.width;
        // Freeze scroll during a track drag so the ghost doesn't drift.
        interactive: !DragState.active;
        viewport-width: self.width;
        viewport-height: page.preferred-height;
        // Scroll-position restore on back/forward (see nav::scope_for).
        property <string> sr-armed: NavState.restore-scope;
        function sr-restore() {
            if (NavState.restore-scope == "album" && self.viewport-height > self.height) {
                self.viewport-y = NavState.scroll-restore;
                NavState.restore-scope = "";
            }
        }
        init => { self.sr-restore(); }
        changed sr-armed => { self.sr-restore(); }
        changed viewport-height => { self.sr-restore(); }
        changed viewport-y => { NavState.report-scroll(self.viewport-y); }

        AlbumHeaderAtmosphere {
            x: 0;
            y: 0;
            width: parent.width;
            atmo-on: root.header-atmo-on;
            atmo-height: root.atmo-height;
        }

        page := AlbumPageContent {
            width: parent.width;
            hdr-strong: root.hdr-strong;
            hdr-body: root.hdr-body;
            hdr-on-surface: root.hdr-on-surface;
            desc-width: root.desc-width;
            desc-display: root.desc-display;
            open-artist(id) => { root.open-artist(id); }
            media-action(k, i, a) => { root.media-action(k, i, a); }
            read-more => { root.show-description = true; }
        }
    }

    // Shared scrollbar in the right gutter (homologated cross-view).
    ListScrollbar {
        x: parent.width - self.width - 4px;
        width: 14px;
        height: 100%;
        viewport-height: flick.viewport-height;
        visible-height: flick.height;
        viewport-y <=> flick.viewport-y;
        auto-hide: true;
        hover-active: ShellState.pointer-in-window
            && ShellState.pointer-x >= flick.absolute-position.x
            && ShellState.pointer-x <= flick.absolute-position.x + flick.width
            && ShellState.pointer-y >= flick.absolute-position.y
            && ShellState.pointer-y <= flick.absolute-position.y + flick.height;
    }

    // --- Full-description modal --------------------------------------------
    if root.show-description: AlbumDescriptionModal {
        show <=> root.show-description;
    }
}
