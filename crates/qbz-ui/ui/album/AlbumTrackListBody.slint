// AlbumPageView track list body — one iteration per track, each a thin
// column wrapper so a "Disc N" divider or classical "work" section header
// can precede the row when the model marks it. Mirrors the Tauri
// PurchaseAlbumDetailView groupByDisc + isMultiDisc markup.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { AlbumState, AlbumActions } from "../state.slint";
import { TrackRow } from "../primitives/TrackRow.slint";
import { DiscHeaderMenu } from "../primitives/DiscHeaderMenu.slint";

export component AlbumTrackListBody inherits VerticalLayout {
    in property <bool> hires-only;
    callback media-action(string, string, string);

    spacing: 0px;
    alignment: start;

    for track[index] in AlbumState.tracks: VerticalLayout {
        spacing: 0px;
        // "Hi-Res only" filter: `visible` ONLY — a self-referential height
        // binding here previously corrupted the list's layout. Headers stay
        // even when every track under them is filtered out (blank gap
        // instead of compacting) — an acceptable trade-off to keep it safe.
        visible: !root.hires-only || track.quality-tier == "hires";
        if track.disc-header-number > 0: Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;
                Text {
                    text: @tr("Disc") + " \{track.disc-header-number}";
                    color: Theme.text-muted;
                    font-size: Typography.legal;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    horizontal-stretch: 1;
                }
                // Per-disc ⋯ menu — actions scoped to this disc's tracks
                // only (the column header reserves a 32px more-button slot
                // on the right; this aligns with it).
                VerticalLayout {
                    alignment: center;
                    DiscHeaderMenu {
                        disc: track.disc-header-number;
                        disc-action(d, a) => {
                            AlbumActions.disc-action(d, a);
                        }
                    }
                }
            }
        }
        // Classical "work" section header — rendered above the first row
        // of each consecutive same-work run on albums that carry work
        // metadata (PR #536, mirroring the official Qobuz player). Sits
        // BELOW the disc header so a box set reads disc → work → tracks.
        // Non-classical albums leave work-header "" and this never
        // renders, so the list stays flat — unchanged from before.
        if track.work-header != "": Rectangle {
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 14px;
                padding-bottom: 4px;
                alignment: start;
                Text {
                    text: track.work-header;
                    color: Theme.text-primary;
                    font-size: Typography.body;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                // " (Composer)" — the composer name links to its artist
                // page (E3). Hidden when the work carries no composer.
                if track.work-composer-name != "": Text {
                    text: " (";
                    color: Theme.text-secondary;
                    font-size: Typography.body;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if track.work-composer-name != "": composer-ta := TouchArea {
                    width: composer-text.preferred-width;
                    height: composer-text.preferred-height;
                    mouse-cursor: track.work-composer-id != "" ? pointer : default;
                    enabled: track.work-composer-id != "";
                    clicked => {
                        root.media-action("artist", track.work-composer-id, "open");
                    }
                    composer-text := Text {
                        text: track.work-composer-name;
                        color: composer-ta.has-hover && track.work-composer-id != ""
                            ? Theme.text-primary
                            : Theme.text-secondary;
                        font-size: Typography.body;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                if track.work-composer-name != "": Text {
                    text: ")";
                    color: Theme.text-secondary;
                    font-size: Typography.body;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        TrackRow {
            track: track;
            index: index;
            // Number cell (no cover). Qobuz albums carry the favorite heart
            // (matching the column header) + the offline-cache button;
            // local albums show the source indicator instead.
            show-artwork: false;
            show-favorite: !AlbumState.is-local;
            show-download: !AlbumState.is-local;
            show-source: AlbumState.is-local;
            multi-select-mode: AlbumState.multi-select;
            media-action(kind, id, action) => {
                root.media-action(kind, id, action);
            }
        }
    }
}
