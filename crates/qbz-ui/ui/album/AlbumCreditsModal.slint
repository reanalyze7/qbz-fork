// Album Info (Credits / Review) modal — 1:1 port of Tauri's
// AlbumCreditsModal.svelte. Opened from the AlbumPageView header (i) button via
// media-action("album", id, "info"). The Rust controller (crate::info_modals)
// fetches the album, parses per-track performers, and populates AlbumInfoState.
// Rectangle-scrim + centered fixed-height card, mounted in AppShell after the
// other modals (ADR-009/010).
//
// Body split into AlbumCreditsBody.slint (left column + tabs/list, itself
// composed from AlbumCreditsLeftCol.slint and AlbumTrackRow.slint /
// AlbumTrackCredits.slint); this file stays the single import surface.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { AlbumInfoState, AlbumInfoActions } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { AlbumCreditsBody } from "./AlbumCreditsBody.slint";
import { AlbumCreditsLoadingOverlay } from "./AlbumCreditsLoadingOverlay.slint";

export component AlbumCreditsModal inherits Rectangle {
    visible: AlbumInfoState.open;

    if AlbumInfoState.open: Rectangle {
        background: #000000bf;

        TouchArea {
            mouse-cursor: default;
            clicked => {
                AlbumInfoActions.close();
            }
        }

        Rectangle {
            width: Math.min(root.width - 40px, 850px);
            // Content-sized with a decent cap: as tall as the header + the
            // taller of the two columns (left meta vs tabs + the full credit
            // list), but never beyond the content area (40px margin each
            // side). When the list exceeds the cap, the right column's
            // Flickable scrolls. All inputs are width-driven (card width is
            // fixed by root.width) so the height binding is acyclic.
            // body.content-height is the Math.max(leftcol, tabs+content)
            // term computed inside AlbumCreditsBody.slint.
            height: Math.min(
                root.height - 80px,
                hdr.preferred-height + body.content-height + 24px);
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            border-radius: Radius.md;
            background: Theme.surface-card;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 32px;
            drop-shadow-color: Theme.card-shadow;

            TouchArea { }

            fs := FocusScope {
                Timer {
                    interval: 30ms;
                    running: true;
                    triggered => {
                        self.running = false;
                        fs.focus();
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        AlbumInfoActions.close();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    // ---- Header -------------------------------------------
                    hdr := HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: AlbumInfoState.title;
                                color: Theme.text-primary;
                                font-size: 16px;
                                font-weight: Typography.semibold;
                                overflow: elide;
                            }
                            Text {
                                text: AlbumInfoState.artist;
                                color: Theme.text-muted;
                                font-size: Typography.legal;
                                overflow: elide;
                            }
                        }
                        close-x := TouchArea {
                            width: 32px;
                            height: 32px;
                            mouse-cursor: pointer;
                            clicked => {
                                AlbumInfoActions.close();
                            }
                            QbzIcon {
                                source: @image-url("../assets/icons/x.svg");
                                width: 18px;
                                height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: close-x.has-hover ? Theme.text-primary : Theme.text-muted;
                            }
                        }
                    }

                    // ---- Body (two columns) — always rendered so the card
                    // height can read the real content height (loading/error
                    // are overlays below, since Slint can't reference elements
                    // nested in an `if` from the height binding).
                    body := AlbumCreditsBody { }
                }

                // ---- Loading / error overlay -------------------------------
                if AlbumInfoState.loading || AlbumInfoState.error != "": AlbumCreditsLoadingOverlay { }
            }
        }
    }
}
