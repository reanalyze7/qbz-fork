// Extracted from TrackInfoModal.slint — see that file's doc comment.
// Loading / error / loaded states for the modal's scrollable content.
import { Theme } from "../../foundation/semantic-colors.slint";
import { Typography } from "../../foundation/typography.slint";
import { TrackInfoState } from "../../state.slint";
import { TrackInfoHeader } from "./TrackInfoHeader.slint";
import { TrackInfoMetaRows } from "./TrackInfoMetaRows.slint";
import { TrackInfoCredits } from "./TrackInfoCredits.slint";

export component TrackInfoBody inherits VerticalLayout {
    // Fixed credits-column width, computed by the shell from the card width.
    in property <length> col-w: 280px;

    // ---- Loading --------------------------------
    if TrackInfoState.loading && TrackInfoState.error == "": VerticalLayout {
        alignment: center;
        padding: 60px;
        Text {
            text: @tr("Loading track info...");
            color: Theme.text-muted;
            font-size: Typography.body;
            horizontal-alignment: center;
        }
    }

    // ---- Error ----------------------------------
    if TrackInfoState.error != "": VerticalLayout {
        alignment: center;
        padding: 60px;
        spacing: 8px;
        Text {
            text: @tr("Failed to load track info");
            color: Theme.text-muted;
            font-size: Typography.body;
            horizontal-alignment: center;
        }
        Text {
            text: TrackInfoState.error;
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // ---- Loaded ---------------------------------
    if !TrackInfoState.loading && TrackInfoState.error == "": VerticalLayout {
        TrackInfoHeader { }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 24px;
            spacing: 0px;

            TrackInfoMetaRows { }
            TrackInfoCredits {
                col-w: root.col-w;
            }

            // Copyright.
            if TrackInfoState.copyright != "": Rectangle { height: 20px; }
            if TrackInfoState.copyright != "": Rectangle {
                height: 1px;
                background: Theme.surface-elevated;
            }
            if TrackInfoState.copyright != "": Rectangle { height: 20px; }
            if TrackInfoState.copyright != "": Text {
                text: TrackInfoState.copyright;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
