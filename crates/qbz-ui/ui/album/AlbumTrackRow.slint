// One track row in the AlbumCreditsModal Credits tab: number / play-on-hover,
// title + artist, expand chevron; expanding reveals per-performer credit
// lines + the copyright (AlbumTrackCredits.slint). Local `expanded` persists
// while the modal stays open.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { AlbumCreditTrack } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { AlbumTrackCredits } from "./AlbumTrackCredits.slint";

export component AlbumTrackRow inherits VerticalLayout {
    in property <AlbumCreditTrack> track;
    in property <bool> is-last;
    callback play(string /* track-id */);
    callback musician(string /* name */, string /* primary-role */);
    property <bool> expanded: false;

    // ---- Header row -------------------------------------------------------
    Rectangle {
        height: 46px;
        // Declared FIRST so the per-cell play TouchArea sits on top (footgun:
        // a later full-row TouchArea would eat the cell clicks).
        rowha := TouchArea {
            mouse-cursor: root.track.has-credits ? pointer : default;
            clicked => {
                if (root.track.has-credits) {
                    root.expanded = !root.expanded;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            // Whole-row hover dim, 1:1 with Tauri .track-header:hover.
            opacity: (rowha.has-hover && root.track.has-credits) ? 0.8 : 1.0;
            // Number / play-on-hover cell.
            Rectangle {
                width: 28px;
                if !(rowha.has-hover || pcell.has-hover): Text {
                    text: root.track.number;
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                pcell := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.play(root.track.id);
                    }
                    if rowha.has-hover || pcell.has-hover: Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        QbzIcon {
                            source: @image-url("../assets/icons/play-fill.svg");
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            tint: Theme.accent-text;
                        }
                    }
                }
            }
            // Title + artist.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.track.title;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: Typography.medium;
                    overflow: elide;
                }
                Text {
                    text: root.track.artist;
                    color: Theme.text-muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            // Expand chevron (only when there are credits).
            if root.track.has-credits: VerticalLayout {
                alignment: center;
                QbzIcon {
                    source: root.expanded
                        ? @image-url("../assets/icons/chevron-up.svg")
                        : @image-url("../assets/icons/chevron-down.svg");
                    width: 18px;
                    height: 18px;
                    tint: root.expanded ? Theme.text-primary : Theme.text-muted;
                }
            }
        }
    }

    // ---- Expanded credits -------------------------------------------------
    if root.expanded && root.track.has-credits: AlbumTrackCredits {
        track: root.track;
        musician(n, r) => {
            root.musician(n, r);
        }
    }

    // ---- Divider ----------------------------------------------------------
    if !root.is-last: Rectangle {
        height: 1px;
        background: Theme.border-subtle;
    }
}
