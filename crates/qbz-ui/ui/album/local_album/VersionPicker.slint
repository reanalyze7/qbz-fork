// Local Library album version picker — selected display + dropdown, both
// with the source icon. Shown only when an album has multiple physical
// versions (distinct source folders) so switching copies never merges into
// a duplicated track list.

import { Theme } from "../../foundation/semantic-colors.slint";
import { Typography } from "../../foundation/typography.slint";
import { LocalAlbumVersion } from "../../state.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";
import { SourceIcon } from "./SourceIcon.slint";

export component VersionPicker inherits Rectangle {
    in property <[LocalAlbumVersion]> versions;
    in property <int> current;
    callback select(int);
    // Matches QbzSelect `sm` (height 30, radius 6, no outline, 10px left pad)
    // so it reads like every other small select instead of towering over them.
    height: 30px;
    width: pick-row.preferred-width;
    border-radius: 6px;
    background: pick-ta.has-hover ? Theme.surface-hover : Theme.surface-elevated;

    pick-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            SourceIcon { kind: root.versions[root.current].source; }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.versions[root.current].label;
                color: Theme.text-secondary;
                font-size: Typography.legal;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../../assets/icons/chevron-down.svg");
                width: 12px;
                height: 12px;
                tint: Theme.text-muted;
            }
        }
    }
    pick-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            menu.show();
        }
    }
    menu := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        width: 280px;
        close-policy: close-on-click;
        Rectangle {
            background: Theme.surface-card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 22px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                for v[i] in root.versions: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: i == root.current
                        ? Theme.surface-elevated
                        : (row-ta.has-hover ? Theme.surface-hover : transparent);
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            SourceIcon { kind: v.source; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: v.label;
                                color: Theme.text-primary;
                                font-size: Typography.legal;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if i == root.current: VerticalLayout {
                            alignment: center;
                            QbzIcon {
                                source: @image-url("../../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                tint: Theme.accent;
                            }
                        }
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select(i);
                        }
                    }
                }
            }
        }
    }
}
