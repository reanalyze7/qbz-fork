// Source glyph for a Local Library album version: hard-drive (local), Qobuz
// logo (offline cache). The logo keeps its own colors; the local glyph is
// tinted. `qobuz_purchase` gets a GOLD-tinted Qobuz mark (§8.7 purchase
// badge).

import { Theme } from "../../foundation/semantic-colors.slint";

export component SourceIcon inherits Image {
    in property <string> kind;
    width: 14px;
    height: 14px;
    image-fit: contain;
    source: (root.kind == "qobuz_download" || root.kind == "qobuz_purchase")
        ? @image-url("../../assets/icons/qobuz-logo-filled.svg")
        : @image-url("../../assets/icons/hard-drive.svg");
    colorize: root.kind == "qobuz_purchase" ? #eab308
        : (root.kind == "qobuz_download"
            ? transparent
            : Theme.text-secondary);
}
