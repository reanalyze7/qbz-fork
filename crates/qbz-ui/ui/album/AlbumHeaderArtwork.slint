// AlbumPageView header artwork tile + right-click cover context menu
// (Add/Change/Remove custom cover, Open in browser, Save as) — same pattern
// as the artist portrait's context menu.

import { Theme } from "../foundation/semantic-colors.slint";
import { AlbumState, ArtworkActions } from "../state.slint";
import { ContextMenu } from "../primitives/ContextMenu.slint";
import { ContextMenuItem } from "../primitives/ContextMenuItem.slint";

export component AlbumHeaderArtwork inherits Rectangle {
    width: 224px;
    height: 224px;
    border-radius: 12px;
    background: Theme.surface-elevated;
    drop-shadow-blur: 32px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 8px;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: AlbumState.artwork;
        image-fit: cover;
    }
    // Right-click → cover context menu (same pattern as the artist
    // portrait): Add/Change/Remove custom cover, Open in browser, Save as.
    cover-ta := TouchArea {
        mouse-cursor: default;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right
                && e.kind == PointerEventKind.up) {
                cover-menu.show();
            }
        }
    }
    cover-menu := PopupWindow {
        x: cover-ta.mouse-x;
        y: cover-ta.mouse-y;
        width: 220px;
        // close-on-click races the row's TouchArea (can dismiss on the
        // press before `clicked` fires); close only on outside clicks and
        // dismiss explicitly per row. Matches Sidebar.slint /
        // AlbumContextMenu.slint.
        close-policy: close-on-click-outside;
        ContextMenu {
            if !AlbumState.has-custom-cover: ContextMenuItem {
                icon: @image-url("../assets/icons/image-plus.svg");
                label: @tr("Add cover");
                clicked => {
                    ArtworkActions.add-custom("album", AlbumState.id);
                    cover-menu.close();
                }
            }
            if AlbumState.has-custom-cover: ContextMenuItem {
                icon: @image-url("../assets/icons/image-plus.svg");
                label: @tr("Change cover");
                clicked => {
                    ArtworkActions.add-custom("album", AlbumState.id);
                    cover-menu.close();
                }
            }
            if AlbumState.has-custom-cover: ContextMenuItem {
                icon: @image-url("../assets/icons/trash-2.svg");
                label: @tr("Remove cover");
                clicked => {
                    ArtworkActions.remove-custom("album", AlbumState.id);
                    cover-menu.close();
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }
            ContextMenuItem {
                icon: @image-url("../assets/icons/external-link.svg");
                label: @tr("Open in browser");
                clicked => {
                    ArtworkActions.open-in-browser(AlbumState.artwork-url);
                    cover-menu.close();
                }
            }
            ContextMenuItem {
                icon: @image-url("../assets/icons/cloud-download.svg");
                label: @tr("Save as…");
                clicked => {
                    ArtworkActions.save-as(
                        AlbumState.artwork-url,
                        AlbumState.title + " - Cover.jpg");
                    cover-menu.close();
                }
            }
        }
    }
}
