// "Add to Mixtape/Collection" modal — the header block (eyebrow + title/
// subtitle + close X), always rendered regardless of which body panel is
// active.
//
// Extracted from AddToMixtapeModal.slint to keep that file under the
// 130-line budget. Reads MyQbzAddState/MyQbzAddActions directly (same
// globals the parent modal already uses).

import { Theme } from "../../foundation/semantic-colors.slint";
import { Typography } from "../../foundation/typography.slint";
import { MyQbzAddState, MyQbzAddActions } from "../../state.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";

export component AddModalHeader inherits Rectangle {
    height: header-row.preferred-height + 36px;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 16px;
        header-row := HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: @tr("ADD TO MIXTAPE/COLLECTION");
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: Typography.semibold;
                    letter-spacing: 1.5px;
                }
                Text {
                    text: MyQbzAddState.header-title;
                    color: Theme.text-primary;
                    font-size: Typography.section;
                    font-weight: Typography.bold;
                    overflow: elide;
                }
                if MyQbzAddState.header-subtitle != "": Text {
                    text: MyQbzAddState.header-subtitle;
                    color: Theme.text-muted;
                    font-size: Typography.legal;
                    overflow: elide;
                }
            }
            close-x := TouchArea {
                width: 28px;
                height: 28px;
                mouse-cursor: pointer;
                clicked => {
                    MyQbzAddActions.close();
                }
                QbzIcon {
                    source: @image-url("../../assets/icons/x.svg");
                    width: 17px;
                    height: 17px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: close-x.has-hover ? Theme.text-primary : Theme.text-muted;
                }
            }
        }
    }
    // Header bottom border.
    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        background: Theme.border-subtle;
    }
}
