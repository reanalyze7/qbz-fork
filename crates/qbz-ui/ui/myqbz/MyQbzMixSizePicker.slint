// My QBZ Mix modal — the size field (loading spinner OR slider + labels).
//
// Extracted from MyQbzMixModal.slint (spec 21 §C / spec 12 §12) to keep that
// file under the 130-line budget. Reads MyQbzMixState/MyQbzMixActions
// directly (same globals the parent modal already uses), consistent with
// how other components in this codebase reach global singletons directly.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { MyQbzMixState, MyQbzMixActions } from "../state.slint";
import { QbzSlider } from "../primitives/QbzSlider.slint";
import { LoadingSpinner } from "../primitives/LoadingSpinner.slint";

export component MyQbzMixSizePicker inherits VerticalLayout {
    // Slider travels over option INDICES (0..options-1). A single option
    // (small collection -> only "All (N)") still renders a degenerate 0..0
    // track.
    property <int> slider-max: Math.max(0, MyQbzMixState.size-options.length - 1);
    // The dropdown-style display value for the current size: "All (N)" for
    // the trailing entry, else the plain number.
    property <string> size-label:
        MyQbzMixState.selected-is-all
        ? @tr("All ({})", MyQbzMixState.selected-size)
        : "\{MyQbzMixState.selected-size}";

    spacing: 18px;

    // --- Loading state (mixModal.computing) ------------------
    if MyQbzMixState.loading: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            LoadingSpinner { size: 18px; }
        }
        Text {
            text: @tr("Loading…");
            color: Theme.text-secondary;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    // --- Size field (slider + count labels) ------------------
    if !MyQbzMixState.loading && MyQbzMixState.size-options.length > 0: VerticalLayout {
        spacing: 8px;

        // Field label (mixModal.numberOfSongs).
        Text {
            text: @tr("Number of songs");
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: Typography.medium;
        }

        // Selected size + slider on one row.
        HorizontalLayout {
            spacing: 12px;
            // The current pick (big, accent), so the slider's effect
            // is legible.
            Text {
                text: root.size-label;
                color: Theme.accent;
                font-size: 15px;
                font-weight: Typography.semibold;
                vertical-alignment: center;
                min-width: 64px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                QbzSlider {
                    width: 100%;
                    minimum: 0;
                    maximum: root.slider-max;
                    value: MyQbzMixState.selected-index;
                    changed(v) => {
                        MyQbzMixActions.set-index(v);
                    }
                }
            }
        }

        // Helper (mixModal.songsAvailable) = "{n} songs available".
        Text {
            text: @tr("{} songs available", MyQbzMixState.unique-count);
            color: Theme.text-muted;
            font-size: 12px;
        }
    }
}
