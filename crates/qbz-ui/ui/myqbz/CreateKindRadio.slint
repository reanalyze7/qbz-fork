// A single labelled radio option in the Kind toggle for CreateMyQbzModal.
//
// Extracted from CreateMyQbzModal.slint to keep that file under the
// 130-line budget. Purely a dumb radio-button visual — the state mutation
// (MyQbzCreateState.kind) stays at the call site in CreateMyQbzModal.slint,
// matching the existing pattern of every other component in this repo.
//
// NOTE: AddToMixtapeModal.slint has its own separate private `KindRadio`
// component (unrelated, not shared) — this file is named `CreateKindRadio`
// to avoid any naming ambiguity between the two.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";

export component CreateKindRadio inherits TouchArea {
    in property <string> label;
    in property <bool> selected;
    mouse-cursor: pointer;
    horizontal-stretch: 0;
    HorizontalLayout {
        spacing: 6px;
        // Radio dot.
        Rectangle {
            width: 18px;
            height: 18px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            border-radius: 9px;
            border-width: root.selected ? 0px : 1.5px;
            border-color: Theme.text-muted;
            background: root.selected ? Theme.accent : transparent;
            Rectangle {
                width: 7px;
                height: 7px;
                x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                border-radius: 3.5px;
                background: #ffffff;
                visible: root.selected;
            }
        }
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Typography.body;
            vertical-alignment: center;
        }
    }
}
