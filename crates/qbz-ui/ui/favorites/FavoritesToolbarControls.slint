// Small toolbar-trigger pills shared by the Favorites toolbars: the
// genre-filter popup trigger and the "Hi-Res only" filter pill.

import { Theme } from "../foundation/semantic-colors.slint";
import { GenreFilterState, GenreFilterActions } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

// Genre-filter trigger for the favorites toolbars — opens the shared
// popup in the "favorites" context. Accent fill + "N genres" when active.
export component FavGenreButton inherits Rectangle {
    // Which shared genre-filter context this button edits ("favorites" for the
    // favorites tabs, "library-all" for the mixed Library feed). The popup is
    // shared; set-context switches whose selection it shows.
    in property <string> context: "favorites";
    property <bool> active: GenreFilterState.selected-count > 0;
    width: genre-row.preferred-width;
    height: 30px;
    border-radius: 6px;
    background: root.active
        ? Theme.accent
        : (ta.has-hover ? Theme.surface-hover : Theme.surface-elevated);

    genre-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../assets/icons/list-filter.svg");
                width: 13px;
                height: 13px;
                tint: root.active ? #ffffff : Theme.text-secondary;
            }
        }
        Text {
            text: root.active
                ? (GenreFilterState.selected-count == 1
                    ? @tr("1 genre")
                    : @tr("{} genres", GenreFilterState.selected-count))
                : @tr("Filter by genre");
            color: root.active ? #ffffff : Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            GenreFilterActions.set-context(root.context);
            GenreFilterState.open = !GenreFilterState.open;
        }
    }
}

// "Hi-Res only" filter pill (owner request) — same look as FavGenreButton
// right beside it, gold-tinted when active (matches the AudioStamp/album-
// page Hi-Res badge colour convention used elsewhere).
export component FavHiResButton inherits Rectangle {
    in property <bool> active: false;
    callback clicked();
    width: hires-row.preferred-width;
    height: 30px;
    border-radius: 6px;
    background: root.active
        ? #c9a227
        : (ta.has-hover ? Theme.surface-hover : Theme.surface-elevated);

    hires-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../assets/icons/star.svg");
                width: 13px;
                height: 13px;
                tint: root.active ? #000000 : Theme.text-secondary;
            }
        }
        Text {
            text: @tr("Hi-Res only");
            color: root.active ? #000000 : Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
