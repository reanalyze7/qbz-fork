// One row in the Favorites Artists sidepanel left list — a 40px round thumb
// + name; the selected row is highlighted. Split out of
// FavoritesListHelpers.slint to stay under the 130-line budget.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { FavoriteArtistItem } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component SidepanelArtistRow inherits Rectangle {
    in property <FavoriteArtistItem> item;
    in property <bool> selected;
    callback clicked(string, string);
    height: 56px;
    border-radius: 8px;
    background: root.selected
        ? Theme.surface-elevated
        : (ta.has-hover ? #ffffff10 : transparent);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.surface-elevated;
                clip: true;
                Image {
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                    source: root.item.image;
                }
                if root.item.image-url == "": QbzIcon {
                    source: @image-url("../assets/icons/user.svg");
                    width: 18px;
                    height: 18px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: Theme.text-muted;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: root.selected ? Theme.text-primary : Theme.text-secondary;
                font-size: Typography.body;
                font-weight: root.selected ? Typography.semibold : Typography.regular;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked(root.item.id, root.item.name);
        }
    }
}
