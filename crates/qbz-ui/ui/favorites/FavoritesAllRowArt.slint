// Library "All" list row — artwork column (round for artists) with a
// hover play overlay. Right-clicks forward the raw pointer position up to
// the row (ShellState is a global so reading pointer-x/y here is fine;
// only the row's own `menu-x`/`menu-y`/`row-menu` ids are file-local).

import { Theme } from "../foundation/semantic-colors.slint";
import { LibraryFeedItem, FavoritesActions, ShellState } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component FavoritesAllRowArt inherits Rectangle {
    in property <LibraryFeedItem> item;
    callback open-menu-at(length, length);

    width: 44px;
    height: 44px;
    border-radius: root.item.kind == "artist" ? 22px : 6px;
    background: Theme.surface-elevated;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: root.item.image;
        image-fit: root.item.kind == "label" ? contain : cover;
    }
    if root.item.kind == "track" || root.item.kind == "album" || root.item.kind == "playlist": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;
        opacity: play-ta.has-hover ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }
        QbzIcon {
            source: @image-url("../assets/icons/play-fill.svg");
            width: 16px;
            height: 16px;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            tint: #ffffff;
        }
        play-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.item.kind == "track") { FavoritesActions.track-action(root.item.id, "play"); }
                else if (root.item.kind == "album") { FavoritesActions.album-action(root.item.id, "play"); }
                else { FavoritesActions.playlist-action(root.item.id, "play"); }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    root.open-menu-at(ShellState.pointer-x, ShellState.pointer-y);
                }
            }
        }
    }
}
