// FavoritesView row 2 toolbar for the Tracks tab — Hi-Res filter, search,
// genre filter, group-by select.

import { FavoritesState, FavoritesActions } from "../state.slint";
import { ExpandableSearch } from "../primitives/ExpandableSearch.slint";
import { QbzSelect } from "../primitives/QbzSelect.slint";
import { FavGenreButton } from "FavoritesToolbarControls.slint";
import { HiResFilterButton } from "../primitives/HiResFilterButton.slint";

export component FavoritesToolbarTracks inherits HorizontalLayout {
    spacing: 8px;
    // "Hi-Res only" — left of the search box, same pill style as the
    // genre-filter button beside it. The value lives in FavoritesState
    // because Rust applies it when deriving `tracks-visible`; see the
    // property's comment for why it cannot be a `visible:` binding.
    VerticalLayout {
        alignment: center;
        HiResFilterButton {
            active: FavoritesState.tracks-hires-only;
            clicked => {
                FavoritesActions.tracks-set-hires-only(!FavoritesState.tracks-hires-only);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        ExpandableSearch {
            placeholder: @tr("Search");
            sm: true;
            query <=> FavoritesState.tracks-search;
            edited(q) => {
                FavoritesActions.search-tracks(q);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        FavGenreButton { }
    }
    VerticalLayout {
        alignment: center;
        QbzSelect {
            menu-width: 150px;
            options: [
                @tr("Group: Off"),
                @tr("Group: Album"),
                @tr("Group: Artist"),
                @tr("Group: Name"),
            ];
            sm: true;
            current-index: FavoritesState.tracks-group-mode == "off" ? 0
                : FavoritesState.tracks-group-mode == "album" ? 1
                : FavoritesState.tracks-group-mode == "artist" ? 2
                : 3;
            selected(i) => {
                FavoritesActions.tracks-set-group(
                    i == 0 ? "off"
                    : i == 1 ? "album"
                    : i == 2 ? "artist"
                    : "name");
            }
        }
    }
}
