// One entry in the Tracks tab's virtualized ListView — optional group
// header (album/artist) + TrackRow. Split out of FavoritesTracksTab to
// stay under the 130-line budget; the "Hi-Res only" `visible` filter is
// applied here rather than via a height override — see the note below,
// preserved verbatim from the original (a self-referential height binding
// on preferred-height corrupted an equivalent list elsewhere).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { FavoritesState, FavoritesActions, TrackItem } from "../state.slint";
import { TrackRow } from "../primitives/TrackRow.slint";

export component FavoritesTrackListItem inherits VerticalLayout {
    in property <TrackItem> track;
    in property <int> i;
    in property <bool> tracks-hires-only: false;

    spacing: 0px;
    // "Hi-Res only" filter: `visible` ONLY, no height override (a
    // self-referential height binding on preferred-height corrupted an
    // equivalent list elsewhere in this same change — see git log).
    // Filtered rows leave a blank gap instead of compacting; an
    // acceptable trade-off to stay safe.
    visible: !root.tracks-hires-only || root.track.quality-tier == "hires";
    // Group header rows when grouping by album / artist.
    if FavoritesState.tracks-group-mode == "album" && root.track.album != ""
        && (root.i == 0 || FavoritesState.tracks-visible[root.i - 1].album != root.track.album): Rectangle {
        height: 32px;
        Text {
            x: 2px;
            width: parent.width - 4px;
            height: 100%;
            text: root.track.album;
            color: Theme.text-secondary;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if FavoritesState.tracks-group-mode == "artist" && root.track.artist != ""
        && (root.i == 0 || FavoritesState.tracks-visible[root.i - 1].artist != root.track.artist): Rectangle {
        height: 32px;
        Text {
            x: 2px;
            width: parent.width - 4px;
            height: 100%;
            text: root.track.artist;
            color: Theme.text-secondary;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TrackRow {
        track: root.track;
        index: root.i;
        show-artwork: true;
        show-album: FavoritesState.tracks-group-mode != "album";
        show-favorite: true;
        show-download: true;
        multi-select-mode: FavoritesState.tracks-multi-select;
        media-action(kind, id, action) => {
            if (kind == "album" && action == "open") {
                FavoritesActions.open-album(id);
            } else if (kind == "artist" && action == "open") {
                FavoritesActions.open-artist(id);
            } else if (action == "favorite") {
                FavoritesActions.unfavorite-track(id);
            } else {
                FavoritesActions.track-action(id, action);
            }
        }
    }
}
