// One entry in the Tracks tab's virtualized ListView — optional group
// header (album/artist) + TrackRow.
//
// This row does NOT filter. "Hi-Res only" used to be a `visible:` binding
// here, which corrupted the list: in a ListView an invisible row still owns
// its slot in the viewport layout, so the rows drew on top of each other
// instead of compacting. The filter now runs in Rust when `tracks-visible`
// is derived, and this component only ever receives rows it must draw.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { FavoritesState, FavoritesActions, TrackItem } from "../state.slint";
import { TrackRow } from "../primitives/TrackRow.slint";

export component FavoritesTrackListItem inherits VerticalLayout {
    in property <TrackItem> track;
    in property <int> i;

    spacing: 0px;
    // True when this row opens a new album / artist group. Named once so the
    // header below and the height above cannot drift apart.
    property <bool> show-group-header:
        (FavoritesState.tracks-group-mode == "album" && root.track.album != ""
            && (root.i == 0 || FavoritesState.tracks-visible[root.i - 1].album != root.track.album))
        || (FavoritesState.tracks-group-mode == "artist" && root.track.artist != ""
            && (root.i == 0 || FavoritesState.tracks-visible[root.i - 1].artist != root.track.artist));
    // A ListView places each item by its HEIGHT, and a bare VerticalLayout
    // has none — which is why every row landed on the same position and the
    // list showed one track out of N. The height is derived from the SAME
    // condition that gates the header below, so it is deterministic; it must
    // never come from `self.preferred-height`, which is self-referential and
    // collapses the list in exactly the same way.
    height: (root.show-group-header ? 32px : 0px) + 50px;
    // Group header rows when grouping by album / artist.
    if FavoritesState.tracks-group-mode == "album" && root.show-group-header: Rectangle {
        height: 32px;
        Text {
            x: 2px;
            width: parent.width - 4px;
            height: 100%;
            text: root.track.album;
            color: Theme.text-secondary;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if FavoritesState.tracks-group-mode == "artist" && root.show-group-header: Rectangle {
        height: 32px;
        Text {
            x: 2px;
            width: parent.width - 4px;
            height: 100%;
            text: root.track.artist;
            color: Theme.text-secondary;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TrackRow {
        track: root.track;
        index: root.i;
        show-artwork: true;
        show-album: FavoritesState.tracks-group-mode != "album";
        show-favorite: true;
        show-download: true;
        multi-select-mode: FavoritesState.tracks-multi-select;
        media-action(kind, id, action) => {
            if (kind == "album" && action == "open") {
                FavoritesActions.open-album(id);
            } else if (kind == "artist" && action == "open") {
                FavoritesActions.open-artist(id);
            } else if (action == "favorite") {
                FavoritesActions.unfavorite-track(id);
            } else {
                FavoritesActions.track-action(id, action);
            }
        }
    }
}
