// Library > Favorites — the user's saved tracks / albums / artists /
// playlists / labels. A fixed chrome block (back/forward + title + the
// tab menu on row 1; per-view action buttons + toolbar on row 2) sits
// over a single scrolling content area. Tracks reuse the shared TrackRow,
// albums the shared AlbumCollectionView, artists/playlists round/tile
// grids, labels a row list.
//
// This file is the orchestrator: it owns the top-level layout + the
// layout-constant properties shared across tabs, and delegates the fixed
// chrome rows + each tab body to sibling components in this folder. It
// is the only file other `.slint` files should import from
// (`import { FavoritesView } from ".../FavoritesView.slint"`).

import { Theme } from "../foundation/semantic-colors.slint";
import { FavoritesState, GenreFilterState, ShellState } from "../state.slint";
import { GenreFilterPopup } from "../discover/GenreFilterPopup.slint";
import { FavoritesHeaderRow } from "FavoritesHeaderRow.slint";
import { FavoritesToolbarRow } from "FavoritesToolbarRow.slint";
import { FavoritesLoadError } from "FavoritesLoadError.slint";
import { FavoritesAllTab } from "FavoritesAllTab.slint";
import { FavoritesTracksTab } from "FavoritesTracksTab.slint";
import { FavoritesOtherTabsHost } from "FavoritesOtherTabsHost.slint";
import { FavoritesArtistsSidepanel } from "FavoritesArtistsSidepanel.slint";

export component FavoritesView inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);

    // Client-side "Hi-Res only" filter over the Tracks tab (owner request) —
    // display layer only, no Rust/network round trip.
    property <bool> tracks-hires-only: false;

    property <length> artist-w: 160px;
    property <length> artist-h: 200px;
    // Artists grid now uses the 200x246 ArtistGridCard (labels still use the
    // round 160x200 FavLabelCard via artist-w/artist-h above).
    property <length> artist-card-w: 200px;
    property <length> artist-card-h: 246px;
    property <length> gap: 24px;

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    VerticalLayout {
        spacing: 0px;

        // ===================== FIXED CHROME =====================
        FavoritesHeaderRow { }

        Rectangle { height: 12px; }

        FavoritesToolbarRow {
            tracks-hires-only <=> root.tracks-hires-only;
        }

        Rectangle { height: 14px; }
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // ===================== SCROLLING CONTENT =====================
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            FavoritesLoadError { }

            // --- Library "All" — the mixed feed grid (webplayer parity) ----
            if FavoritesState.active-tab == "all": FavoritesAllTab { }

            // --- Tracks tab — virtualized self-scrolling list --------------
            if !FavoritesState.loading && FavoritesState.load-error == ""
                && FavoritesState.active-tab == "tracks": FavoritesTracksTab {
                tracks-hires-only: root.tracks-hires-only;
            }

            // --- Albums / Artists / Playlists / Labels — scrolling ---------
            if !FavoritesState.loading && FavoritesState.load-error == ""
                && FavoritesState.active-tab != "tracks"
                && FavoritesState.active-tab != "all"
                && !(FavoritesState.active-tab == "artists"
                    && FavoritesState.artists-view-mode == "sidepanel"): FavoritesOtherTabsHost {
                artist-card-w: root.artist-card-w;
                artist-card-h: root.artist-card-h;
                gap: root.gap;
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
            }

            // --- Artists SIDEPANEL — two-column, each column self-scrolling ---
            if !FavoritesState.loading && FavoritesState.load-error == ""
                && FavoritesState.active-tab == "artists"
                && FavoritesState.artists-view-mode == "sidepanel": FavoritesArtistsSidepanel {
                open-album(id) => { root.open-album(id); }
                open-artist(id) => { root.open-artist(id); }
            }
        }
    }

    // Genre filter overlay — the shared popup, favorites context. Anchored
    // under the toolbar's genre button (below the fixed chrome).
    if GenreFilterState.open: Rectangle {
        width: 100%;
        height: 100%;
        TouchArea {
            clicked => {
                GenreFilterState.open = false;
            }
        }
    }
    if GenreFilterState.open: GenreFilterPopup {
        x: root.width - self.width - 32px;
        y: 104px;
    }
}
