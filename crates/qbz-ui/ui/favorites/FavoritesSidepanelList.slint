// Artists sidepanel — LEFT column: the favorites artist list, A-Z grouped,
// with a proportional alpha jump strip. left-flick/AlphaStrip stay
// together (element-id references only work within one file).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { FavoritesState, FavoritesActions } from "../state.slint";
import { AlphaStrip } from "FavoritesAlphaStrip.slint";
import { SidepanelArtistRow } from "FavoritesSidepanelArtistRow.slint";

export component FavoritesSidepanelList inherits Rectangle {
    width: 300px;
    clip: true;
    left-flick := Flickable {
        viewport-width: self.width;
        viewport-height: left-col.preferred-height;
        left-col := VerticalLayout {
            width: parent.width;
            padding-top: 4px;
            padding-bottom: 40px;
            padding-right: 22px;
            spacing: 4px;
            alignment: start;
            for section[s] in FavoritesState.artists-grouped: VerticalLayout {
                spacing: 2px;
                Text {
                    text: section.title;
                    color: Theme.text-secondary;
                    font-size: Typography.legal;
                    font-weight: Typography.semibold;
                }
                for artist[i] in section.artists: SidepanelArtistRow {
                    item: artist;
                    selected: FavoritesState.selected-artist-id == artist.id;
                    clicked(id, name) => {
                        FavoritesActions.select-artist(id, name);
                    }
                }
            }
        }
    }
    if FavoritesState.artists-alpha.length > 0: AlphaStrip {
        x: parent.width - self.width - 2px;
        height: 100%;
        jumps: FavoritesState.artists-alpha;
        jump(ord, idx) => {
            left-flick.viewport-y = -(ord / Math.max(1, FavoritesState.artists-alpha.length - 1))
                * Math.max(0, (left-flick.viewport-height - left-flick.height) / 1px) * 1px;
        }
    }
}
