// Library "All" list row — title (click plays/opens by kind) + subtitle
// (artist link for track/album) column. Right-clicks forward the raw
// pointer position up to the row, same pattern as FavoritesAllRowArt.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { LibraryFeedItem, FavoritesActions, ShellState } from "../state.slint";

export component FavoritesAllRowTitle inherits VerticalLayout {
    in property <LibraryFeedItem> item;
    callback open-menu-at(length, length);

    alignment: center;
    horizontal-stretch: 1;
    spacing: 2px;
    title-ta := TouchArea {
        height: 18px;
        mouse-cursor: pointer;
        clicked => {
            if (root.item.kind == "track") { FavoritesActions.track-action(root.item.id, "play"); }
            else if (root.item.kind == "album") { FavoritesActions.open-album(root.item.id); }
            else if (root.item.kind == "artist") { FavoritesActions.open-artist(root.item.id); }
            else if (root.item.kind == "playlist") { FavoritesActions.open-playlist(root.item.id); }
            else { FavoritesActions.open-label(root.item.id, root.item.title); }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.open-menu-at(ShellState.pointer-x, ShellState.pointer-y);
            }
        }
        Text {
            width: 100%;
            text: root.item.title;
            color: title-ta.has-hover ? Theme.accent : Theme.text-primary;
            font-size: 14px;
            font-weight: Typography.medium;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    if root.item.subtitle != "": sub-ta := TouchArea {
        height: 16px;
        mouse-cursor: (root.item.artist-id != "" && (root.item.kind == "track" || root.item.kind == "album")) ? pointer : default;
        clicked => {
            if (root.item.artist-id != "" && (root.item.kind == "track" || root.item.kind == "album")) {
                FavoritesActions.open-artist(root.item.artist-id);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.open-menu-at(ShellState.pointer-x, ShellState.pointer-y);
            }
        }
        Text {
            width: 100%;
            text: root.item.subtitle;
            color: (root.item.artist-id != "" && (root.item.kind == "track" || root.item.kind == "album") && sub-ta.has-hover)
                ? Theme.accent : Theme.text-muted;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
