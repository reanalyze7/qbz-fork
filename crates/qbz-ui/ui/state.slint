// Shared UI state — structs and globals the Rust controllers populate.
//
// The Rust side builds these models on a worker thread, then sets them
// on the global from the Slint event loop (see src/home.rs, src/main.rs).
//
// This file is a thin barrel: every symbol below is actually defined in
// crates/qbz-ui/ui/state/*.slint and re-exported here so every existing
// `import { X } from "state.slint"` call site keeps working unchanged.
// See refactor-plans/crates__qbz-ui__ui__state.slint.md for the split
// rationale. Two globals stay over the 130-line budget because Slint
// cannot split one atomic `global { ... }` block across files:
// state/appearance_state.slint (AppearanceState, ~197 lines) and
// state/local_library_state.slint (LocalLibraryState, ~152 lines) — both
// documented, deliberate exceptions (every property's inline doc comment
// is load-bearing, not filler that could be trimmed).

import { JumpNavTab } from "primitives/JumpNavBar.slint";
export { JumpNavTab }

// Re-export the hotkey text-input guard from its leaf file so existing
// `import { UiFocusState } from "state.slint"` sites keep working, while
// low-level primitives import it directly from "focus-state.slint" (avoids a
// recursive import — state.slint imports JumpNavBar's JumpNavTab).
export { UiFocusState } from "focus-state.slint";

// One export line per state/ file (grouped by the domain it owns — see the
// table in the split-plan doc above for what each file covers).
