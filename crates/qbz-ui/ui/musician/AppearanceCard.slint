// AppearanceCard — a single album-appearance tile in MusicianPageView's
// "Appears On" grid: artwork, title, artist, and optional year / role.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { MusicianAppearanceItem } from "../state.slint";

export component AppearanceCard inherits Rectangle {
    in property <MusicianAppearanceItem> item;
    callback clicked(string /* album-id */);

    width: 200px;
    height: 270px;

    VerticalLayout {
        spacing: 6px;
        Rectangle {
            width: 200px;
            height: 200px;
            border-radius: Radius.sm;
            background: Theme.surface-elevated;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000060;
            drop-shadow-offset-y: 6px;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.item.artwork;
                image-fit: cover;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked(root.item.album-id);
                }
            }
        }
        Text {
            text: root.item.album-title;
            color: Theme.text-primary;
            font-size: Typography.body;
            font-weight: Typography.medium;
            overflow: elide;
            width: 200px;
        }
        Text {
            text: root.item.artist-name;
            color: Theme.text-muted;
            font-size: Typography.legal;
            overflow: elide;
            width: 200px;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.item.year != "": Text {
                text: root.item.year;
                color: Theme.text-muted;
                font-size: Typography.legal;
            }
            if root.item.role-on-album != "": Text {
                text: root.item.role-on-album;
                color: Theme.text-secondary;
                font-size: Typography.legal;
                font-weight: Typography.medium;
            }
        }
    }
}
