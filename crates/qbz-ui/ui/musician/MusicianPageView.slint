// MusicianPageView — full page view opened from the artist network
// sidebar when a relationship row resolves with Contextual / Weak
// confidence (no exact Qobuz artist match). Mirrors Tauri's
// MusicianPageView.svelte: a small header (avatar + name + role)
// followed by Bands & Projects (when known) and the "Appears On"
// album grid with paginated load-more.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import {
    MusicianState,
    NavState,
    ShellState,
} from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { AppearancesGrid } from "./AppearancesGrid.slint";
import { MusicianBandsRow } from "./MusicianBandsRow.slint";

export component MusicianPageView inherits Rectangle {
    callback open-album(string);

    property <length> card-width: 200px;
    property <length> card-height: 270px;
    property <length> card-gap: 24px;

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    flick := Flickable {
        viewport-width: self.width;
        viewport-height: page.preferred-height;
        // Scroll-position restore on back/forward (see nav::scope_for).
        property <string> sr-armed: NavState.restore-scope;
        function sr-restore() {
            if (NavState.restore-scope == "musician" && self.viewport-height > self.height) {
                self.viewport-y = NavState.scroll-restore;
                NavState.restore-scope = "";
            }
        }
        init => { self.sr-restore(); }
        changed sr-armed => { self.sr-restore(); }
        changed viewport-height => { self.sr-restore(); }
        changed viewport-y => { NavState.report-scroll(self.viewport-y); }

        page := VerticalLayout {
            width: parent.width;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 11px;
            padding-bottom: 100px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                alignment: start;
                NavButtons { }
            }

            Rectangle { height: 22px; }

            // --- Musician header ---------------------------------------
            HorizontalLayout {
                spacing: 16px;
                alignment: start;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 28px;
                    background: Theme.surface-elevated;
                    QbzIcon {
                        source: @image-url("../assets/icons/user.svg");
                        width: 28px;
                        height: 28px;
                        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                        tint: Theme.text-muted;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: MusicianState.name;
                        color: Theme.text-primary;
                        // Hero homologated to the canonical 18px (section), like
                        // the Album / Artist / Playlist / MyQBZ detail heroes.
                        font-size: Typography.section;
                        font-weight: Typography.bold;
                    }
                    Text {
                        text: MusicianState.role;
                        color: Theme.text-muted;
                        font-size: Typography.body;
                    }
                }
            }

            Rectangle { height: 32px; }

            // --- Bands & Projects (chips) ------------------------------
            if MusicianState.bands.length > 0: MusicianBandsRow { }

            // --- Appears On --------------------------------------------
            AppearancesGrid {
                card-width: root.card-width;
                card-height: root.card-height;
                card-gap: root.card-gap;
                open-album(id) => {
                    root.open-album(id);
                }
            }
        }
    }

    // Shared scrollbar in the right gutter (homologated cross-view).
    ListScrollbar {
        x: parent.width - self.width - 4px;
        width: 14px;
        height: 100%;
        viewport-height: flick.viewport-height;
        visible-height: flick.height;
        viewport-y <=> flick.viewport-y;
    }
}
