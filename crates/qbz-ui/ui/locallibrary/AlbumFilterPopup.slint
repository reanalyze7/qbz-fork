// Albums quality/format/source filter popup — a floating overlay, visually
// and logically independent of any tab's layout flow. Split out of
// LocalLibraryView.slint; the caller wraps this in
// `if LibAlbumFilterState.open: AlbumFilterPopup { }` as a sibling of the
// content VerticalLayout so it floats instead of taking a layout slot.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { LibAlbumFilterState, LocalLibraryActions } from "../state.slint";
import { FilterChip } from "./FilterChip.slint";
import { AlbumFilterQualityChips } from "./AlbumFilterQualityChips.slint";
import { AlbumFilterFormatChips } from "./AlbumFilterFormatChips.slint";

export component AlbumFilterPopup inherits Rectangle {
    // Click-out backdrop (covers the whole view).
    TouchArea {
        mouse-cursor: default;
        clicked => {
            LibAlbumFilterState.open = false;
        }
    }
    Rectangle {
        width: 372px;
        height: filt-col.preferred-height;
        x: parent.width - self.width - 36px;
        y: 92px;
        background: Theme.surface-card;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000080;
        TouchArea { }
        filt-col := VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: @tr("Filter");
                    color: Theme.text-primary;
                    font-size: Typography.heading;
                    font-weight: Typography.semibold;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if LibAlbumFilterState.count > 0: Rectangle {
                    width: clr.preferred-width + 18px;
                    height: 28px;
                    border-radius: 6px;
                    background: clr-ta.has-hover ? Theme.surface-hover : transparent;
                    clr := Text {
                        text: @tr("Clear");
                        color: Theme.accent;
                        font-size: Typography.legal;
                        font-weight: Typography.medium;
                        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    }
                    clr-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            LocalLibraryActions.albums-clear-filter();
                        }
                    }
                }
            }

            AlbumFilterQualityChips { }

            AlbumFilterFormatChips { }

            // Source.
            Text {
                text: @tr("Source");
                color: Theme.text-muted;
                font-size: Typography.legal;
                font-weight: Typography.semibold;
            }
            HorizontalLayout {
                spacing: 8px;
                FilterChip {
                    label: @tr("Local");
                    active: LibAlbumFilterState.local;
                    toggled => {
                        LibAlbumFilterState.local = !LibAlbumFilterState.local;
                        LocalLibraryActions.albums-filter-changed();
                    }
                }
                FilterChip {
                    label: @tr("Offline cache");
                    active: LibAlbumFilterState.offline;
                    toggled => {
                        LibAlbumFilterState.offline = !LibAlbumFilterState.offline;
                        LocalLibraryActions.albums-filter-changed();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
