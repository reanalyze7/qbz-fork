// Subfolder cover card for the tree-mode folder-detail pane — 1:1 with Tauri's
// `.subfolder-card`: bordered card, square cover (folder placeholder when none),
// name (13px/medium) + recursive track count (11px/muted). Clicking drills in.
// Folders-tree-specific (used only by the tree-mode detail pane) despite
// looking like a generic shared card — kept out of shared_rows.slint.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { FolderSubcardItem } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component FolderSubcard inherits Rectangle {
    in property <FolderSubcardItem> item;
    callback clicked(string /* path */);
    border-radius: 6px;
    border-width: 1px;
    border-color: card-ta.has-hover ? Theme.accent : Theme.border-subtle;
    background: card-ta.has-hover ? Theme.surface-hover : Theme.surface-elevated;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        // Square cover (width = card width minus h-padding).
        Rectangle {
            height: root.width - 16px;
            border-radius: 4px;
            background: Theme.surface-main;
            clip: true;
            QbzIcon {
                source: @image-url("../assets/icons/folder.svg");
                width: 32px;
                height: 32px;
                x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                tint: Theme.text-muted;
            }
            Image {
                width: 100%;
                height: 100%;
                source: root.item.artwork;
                image-fit: cover;
            }
        }
        Text {
            text: root.item.name;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: Typography.medium;
            overflow: elide;
        }
        Text {
            text: root.item.track-count + " " + @tr("tracks");
            color: Theme.text-muted;
            font-size: 11px;
        }
    }
    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked(root.item.path);
        }
    }
}
