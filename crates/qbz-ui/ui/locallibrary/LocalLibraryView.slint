// Local Library — the user's on-disk music, browsed inside QBZ.
//
// Uses the app's MANDATORY fixed-chrome header — the SAME one FavoritesView
// / Discover use: NavButtons (back/forward) + title on row 1 with the tab
// menu floated right, per-tab action buttons + toolbar on row 2, a 1px
// divider, then a single scrolling content area below. No invented header,
// no pills (ADR-008). Folder management/scan/maintenance/danger-zone live
// under Settings > Local Library, not here — the gear routes there.
//
// This file is the shell only — fixed chrome + composition of the per-tab
// toolbar/body components below. It is the ONLY file in this directory that
// other parts of the UI import from (`export component LocalLibraryView`);
// everything else here is internal to `locallibrary/`. See the sibling
// *.slint files for the actual tab content:
//   - LibHeaderRow (row 1), LibToolbarRow (row 2), LibTabContent (body)
//   - AlbumsToolbar / AlbumsTab (+ AlbumsGrid, AlbumFilterBadgeBtn)
//   - TracksToolbar / TracksTab (+ TracksList, TracksListRow)
//   - FoldersToolbar / FoldersTab (+ FoldersFlat, FoldersTree and its
//     FoldersTree* sub-files, EphemeralPane)
//   - ArtistsToolbar / ArtistsTab (+ ArtistsRail, ArtistsDetail)
//   - AlbumFilterPopup (+ FilterChip, AlbumFilterQualityChips/FormatChips)
//   - shared_buttons / shared_rows — small pieces reused by 2+ tabs

import { Theme } from "../foundation/semantic-colors.slint";
import { ShellState, LibAlbumFilterState } from "../state.slint";
import { LibHeaderRow } from "./LibHeaderRow.slint";
import { LibToolbarRow } from "./LibToolbarRow.slint";
import { LibTabContent } from "./LibTabContent.slint";
import { AlbumFilterPopup } from "./AlbumFilterPopup.slint";

export component LocalLibraryView inherits Rectangle {
    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    // Client-side "Hi-Res only" filter over the Tracks tab (owner request) —
    // display layer only, no Rust/network round trip. Kept on the top-level
    // view (view-level UI state, not library state) and passed down as an
    // `in`/`in-out` property to LibToolbarRow (the toggle, via
    // TracksToolbar) and LibTabContent (the row `visible:` binding, via
    // TracksTab -> TracksList) — see TracksListRow.slint for why.
    property <bool> tracks-hires-only: false;

    VerticalLayout {
        spacing: 0px;

        // ===================== FIXED CHROME =====================
        LibHeaderRow { }

        Rectangle { height: 12px; }

        LibToolbarRow {
            tracks-hires-only <=> root.tracks-hires-only;
        }

        Rectangle { height: 14px; }
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // ===================== SCROLLING CONTENT =====================
        LibTabContent {
            tracks-hires-only: root.tracks-hires-only;
        }
    }

    // ===== Albums quality/format/source filter popup (overlay) =====
    // Sibling of the content VerticalLayout (child of the view Rectangle), so
    // it FLOATS over the content instead of taking a layout slot.
    if LibAlbumFilterState.open: AlbumFilterPopup { }
}
