// One row in the Tracks tab's virtualized ListView — optional album/artist
// group header + the TrackRow itself. Only ever instantiated from
// TracksList.slint's `for` loop.
//
// This row neither filters nor sizes itself from its content. "Hi-Res only"
// is applied by Rust when `tracks-visible` is derived (a hidden row would
// still own its ListView slot), and the height is computed from the group
// condition rather than from `self.preferred-height`.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { LocalLibraryState, LocalLibraryActions, AppearanceState, TrackItem } from "../state.slint";
import { TrackRow } from "../primitives/TrackRow.slint";

export component TracksListRow inherits VerticalLayout {
    in property <TrackItem> track;
    in property <int> i;
    spacing: 0px;
    // True when this row opens a new album / artist group. Named once so the
    // header below and the height above cannot drift apart.
    property <bool> show-group-header:
        (LocalLibraryState.tracks-group-mode == "album" && root.track.album != ""
            && (root.i == 0 || LocalLibraryState.tracks-visible[root.i - 1].album != root.track.album))
        || (LocalLibraryState.tracks-group-mode == "artist" && root.track.artist != ""
            && (root.i == 0 || LocalLibraryState.tracks-visible[root.i - 1].artist != root.track.artist));
    // A ListView places each item by its HEIGHT, and a bare VerticalLayout
    // has none — which is why every row landed on the same position and the
    // list showed one track out of N. The height is derived from the SAME
    // condition that gates the header below, so it is deterministic; it must
    // never come from `self.preferred-height`, which is self-referential and
    // collapses the list in exactly the same way.
    height: (root.show-group-header ? 32px : 0px) + 50px;
    // Group header rows for album / artist grouping.
    if LocalLibraryState.tracks-group-mode == "album" && root.show-group-header: Rectangle {
        height: 32px;
        Text {
            x: 2px;
            width: parent.width - 4px;
            height: 100%;
            text: root.track.album;
            color: Theme.text-secondary;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if LocalLibraryState.tracks-group-mode == "artist" && root.show-group-header: Rectangle {
        height: 32px;
        Text {
            x: 2px;
            width: parent.width - 4px;
            height: 100%;
            text: root.track.artist;
            color: Theme.text-secondary;
            font-size: Typography.legal;
            font-weight: Typography.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TrackRow {
        track: root.track;
        index: root.i;
        show-artwork: AppearanceState.local-library-track-artwork;
        show-album: LocalLibraryState.tracks-group-mode != "album";
        show-favorite: false;
        show-download: false;
        show-source: true;
        // Library surface: local menu even for
        // qobuz_download rows (spec §3.4).
        force-local-menu: true;
        multi-select-mode: LocalLibraryState.tracks-multi-select;
        media-action(kind, id, action) => {
            if (kind == "album" && action == "open") {
                LocalLibraryActions.open-album(id);
            } else if (kind == "artist" && action == "open") {
                LocalLibraryActions.open-artist(id);
            } else {
                LocalLibraryActions.track-action(id, action);
            }
        }
    }
}
