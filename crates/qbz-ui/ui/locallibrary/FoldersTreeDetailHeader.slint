// Folders tree-mode detail pane header — circular Play + folder name +
// recursive track count + persistent subfolder search + grid/list toggle.
// Split out of the detail pane purely to keep FoldersTreeDetail.slint under
// the 130-line cap; only ever instantiated from FoldersTreeDetail.slint.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { LocalLibraryState, LocalLibraryActions, UiFocusState } from "../state.slint";
import { CircleAction } from "../primitives/CircleAction.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { ViewToggle } from "./shared_buttons.slint";

export component FoldersTreeDetailHeader inherits HorizontalLayout {
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        CircleAction {
            icon: @image-url("../assets/icons/play-fill.svg");
            primary: true;
            on-surface: true;
            tooltip: @tr("Play all");
            clicked => {
                LocalLibraryActions.folders-play-node(
                    LocalLibraryState.folders-selected-path);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: LocalLibraryState.folders-selected-name;
            color: Theme.text-primary;
            font-size: Typography.section;
            font-weight: Typography.semibold;
            overflow: elide;
        }
        Text {
            text: LocalLibraryState.folder-detail-track-count + " " + @tr("tracks");
            color: Theme.text-muted;
            font-size: Typography.legal;
        }
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 8px;
            // Persistent subfolder name search (1:1 Tauri).
            Rectangle {
                width: 200px;
                height: 30px;
                border-radius: 6px;
                background: Theme.surface-card;
                border-width: 1px;
                border-color: detail-search-input.has-focus
                    ? Theme.accent : Theme.border-subtle;
                clip: true;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        QbzIcon {
                            source: @image-url("../assets/icons/search.svg");
                            width: 14px;
                            height: 14px;
                            tint: Theme.text-muted;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        detail-search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            text <=> LocalLibraryState.folder-detail-search;
                            changed has-focus => { UiFocusState.text-input-focused = self.has-focus; }
                            edited => {
                                LocalLibraryActions.folder-detail-search(self.text);
                            }
                        }
                        Text {
                            visible: detail-search-input.text == "";
                            width: 100%;
                            height: 100%;
                            text: @tr("Search albums...");
                            color: Theme.text-muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                ViewToggle {
                    view-mode: LocalLibraryState.folder-detail-view;
                    set-view(v) => {
                        LocalLibraryState.folder-detail-view = v;
                    }
                }
            }
        }
    }
}
