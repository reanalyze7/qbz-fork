// Tracks tab row-2 toolbar — multi-select toggle, the Hi-Res-only filter
// toggle, search and sort/group-by (server-side pagination order). Split out
// of LocalLibraryView.slint.
//
// "Hi-Res only" lives in LocalLibraryState and is applied by Rust when
// `tracks-visible` is derived. It cannot be a `visible:` binding on the row:
// the list is a virtualized ListView, where an invisible row still owns its
// slot in the viewport layout — hiding rows made them draw on top of one
// another instead of compacting.

import { LocalLibraryState, LocalLibraryActions } from "../state.slint";
import { ExpandableSearch } from "../primitives/ExpandableSearch.slint";
import { QbzSelect } from "../primitives/QbzSelect.slint";
import { CircleIconBtn } from "./shared_buttons.slint";
import { HiResFilterButton } from "../primitives/HiResFilterButton.slint";

export component TracksToolbar inherits HorizontalLayout {
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        CircleIconBtn {
            icon: @image-url("../assets/icons/square-check-big.svg");
            clicked => {
                LocalLibraryActions.tracks-toggle-multi-select();
            }
        }
    }
    // "Hi-Res only" — the same labelled pill as every other track surface.
    // It was an icon-only circle here, which read as one more round button
    // rather than as a filter, so the filter looked missing from this tab.
    VerticalLayout {
        alignment: center;
        HiResFilterButton {
            active: LocalLibraryState.tracks-hires-only;
            clicked => {
                LocalLibraryActions.tracks-set-hires-only(!LocalLibraryState.tracks-hires-only);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        ExpandableSearch {
            placeholder: @tr("Search");
            sm: true;
            query <=> LocalLibraryState.tracks-search;
            edited(q) => {
                LocalLibraryActions.tracks-search(q);
            }
        }
    }
    // SQL-side sort (pagination order; page-1 re-query on change).
    VerticalLayout {
        alignment: center;
        QbzSelect {
            menu-width: 180px;
            sm: true;
            options: [
                @tr("Default"),
                @tr("Artist A-Z"),
                @tr("Artist Z-A"),
                @tr("Title A-Z"),
                @tr("Title Z-A"),
                @tr("Year (newest)"),
                @tr("Year (oldest)"),
                @tr("Date added"),
            ];
            current-index: LocalLibraryState.tracks-sort == "artist-asc" ? 1
                : LocalLibraryState.tracks-sort == "artist-desc" ? 2
                : LocalLibraryState.tracks-sort == "title-asc" ? 3
                : LocalLibraryState.tracks-sort == "title-desc" ? 4
                : LocalLibraryState.tracks-sort == "year-desc" ? 5
                : LocalLibraryState.tracks-sort == "year-asc" ? 6
                : LocalLibraryState.tracks-sort == "added-desc" ? 7
                : 0;
            selected(i) => {
                LocalLibraryActions.tracks-set-sort(
                    i == 1 ? "artist-asc"
                    : i == 2 ? "artist-desc"
                    : i == 3 ? "title-asc"
                    : i == 4 ? "title-desc"
                    : i == 5 ? "year-desc"
                    : i == 6 ? "year-asc"
                    : i == 7 ? "added-desc"
                    : "default");
            }
        }
    }
    VerticalLayout {
        alignment: center;
        QbzSelect {
            menu-width: 160px;
            sm: true;
            options: [
                @tr("No grouping"),
                @tr("By album"),
                @tr("By artist"),
                @tr("By name"),
            ];
            current-index: LocalLibraryState.tracks-group-mode == "album" ? 1
                : LocalLibraryState.tracks-group-mode == "artist" ? 2
                : LocalLibraryState.tracks-group-mode == "name" ? 3
                : 0;
            selected(i) => {
                LocalLibraryActions.tracks-set-group(
                    i == 1 ? "album" : i == 2 ? "artist" : i == 3 ? "name" : "off");
            }
        }
    }
}
