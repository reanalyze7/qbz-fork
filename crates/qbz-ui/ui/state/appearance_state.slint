// Auto-split from state.slint. Part of the state/ barrel — see ../state.slint.

// Appearance settings — backs the Settings > Appearance panel. 1:1 with
// Tauri's appearance section. This is a visual/structural replica: every
// row is bound to a property here, but the Rust side does NOT yet persist
// or apply most of them (wiring is a later step). The few that map onto an
// existing, already-functional flag are wired through (see notes inline).
//
// Dropdowns follow the same pattern as SettingsState: an option list paired
// with a selected index; the Rust controller (when wired) owns the
// index -> value mapping. Lists are populated with sensible defaults below
// so the UI renders standalone even while unwired.
export global AppearanceState {
    // --- THEME -------------------------------------------------------------
    // Seeded at startup by Rust from the qbz-theme registry
    // (theme::dropdown_labels), in registry display order. The list below is a
    // standalone-preview fallback only; the index is DERIVED from the persisted
    // theme slug (theme::index_for_id), never assumed.
    in-out property <[string]> themes: [
        "Dark", "OLED Black", "Tokyo Night", "System"
    ];
    in-out property <int> theme-index: 0;
    // Theme list filter cycle: 0 = All, 1 = Dark, 2 = Light. Mirrors the
    // SunMoon/Moon/Sun toggle button next to the theme dropdown.
    in-out property <int> theme-filter: 0;

    in-out property <bool> album-header-gradient: true;

    // True while the "System" theme is selected (native OS-palette follow).
    in-out property <bool> theme-is-system: false;
    // Auto-Theme (shown when the appended "Auto (dynamic)" theme is selected).
    // Source: 0 = System Colors, 1 = Wallpaper Sync, 2 = Custom Image.
    in-out property <bool> theme-is-auto: false;
    in-out property <[string]> auto-theme-sources: [@tr("System Colors"), @tr("Wallpaper Sync"), @tr("Custom Image")];
    in-out property <int> auto-theme-source-index: 0;
    in-out property <string> auto-theme-custom-path: "";
    in-out property <bool> auto-theme-generating: false;
    in-out property <string> auto-theme-detected-de: "";

    // --- Custom theme editor (shown when the appended "Custom" theme is
    // selected). The editable base is 12 semantic tokens; Rust seeds these
    // swatch colors from the persisted custom_theme.json and re-derives the
    // whole palette live on every edit. `custom-open-token` holds the key of the
    // single token whose inline ColorPicker is expanded ("" = none).
    in-out property <bool> theme-is-custom: false;
    // Swatch colors for each editable base token, seeded from Rust.
    in-out property <color> custom-surface-main: #000000;
    in-out property <color> custom-surface-card: #0a0a0a;
    in-out property <color> custom-surface-elevated: #1a1a1a;
    in-out property <color> custom-text-primary: #ffffff;
    in-out property <color> custom-text-secondary: #cccccc;
    in-out property <color> custom-accent: #4285f4;
    in-out property <color> custom-danger: #ef4444;
    in-out property <color> custom-warning: #fbbf24;
    in-out property <color> custom-success: #3fae6a;
    in-out property <color> custom-border: #2a2a2a;
    in-out property <color> custom-favorite: #ef4444;
    in-out property <bool> custom-is-dark: true;
    // Key of the token whose inline picker is open ("" = all collapsed).
    in-out property <string> custom-open-token: "";
    // A single token's color changed (drag-live). key = token id, color = value.
    callback custom-set-token(string /* key */, color /* value */);
    // A single token committed from the HEX field. key = token id, hex = #rrggbb.
    callback custom-set-token-hex(string /* key */, string /* hex */);
    // Re-seed the base from the currently active theme ("Start from current").
    callback custom-seed-from-current();
    // Flip the custom theme polarity (dark/light) and re-derive.
    callback custom-toggle-dark(bool /* is-dark */);

    // --- TYPOGRAPHY / SCALE / LANGUAGE -------------------------------------
    // NOTE: the old Tauri-style percentage `ui-scales` placeholder properties
    // that lived here were superseded by the working interface-size presets
    // (`ui-scale-options` / `ui-scale-index` in the INTERFACE SIZE block
    // further down, wired to SLINT_SCALE_FACTOR in main.rs).
    in-out property <[string]> languages: [@tr("Auto"), "English", "Español", "Français", "Deutsch", "Português", "Русский", "日本語", "Nederlands"];
    in-out property <int> language-index: 0;
    in-out property <[string]> fonts: ["LINE Seed JP", "Montserrat", "Noto Sans", "Source Sans 3", "System"];
    in-out property <int> font-index: 0;

    // --- VISUAL EXTRAS -----------------------------------------------------
    // sidebar-playlist-collage is wired to SidebarState.playlist-collage in
    // the panel (the only already-functional flag here).
    in-out property <bool> sidebar-playlist-collage: true;
    in-out property <bool> local-library-track-artwork: false;
    // Intelligent search: smart cache, ranking, and the search preview dropdown.
    in-out property <bool> intelligent-search: true;
    // Player volume +/- stepper buttons — opt-in, hidden by default.
    in-out property <bool> show-volume-steppers: false;

    // --- NOTIFICATIONS -----------------------------------------------------
    in-out property <bool> in-app-toasts: true;
    in-out property <bool> system-notifications: true;

    // --- WINDOW TITLE ------------------------------------------------------
    in-out property <bool> window-title-show: false;
    in-out property <string> window-title-template: "";

    // --- TITLE BAR / WINDOW CHROME -----------------------------------------
    // The header IS the title bar (merged model, owner decision 2026-07-03):
    // it is always present; custom chrome (use-system-title-bar off) makes it
    // gain the window controls + drag and drops the system decorations.
    // Defaults are per-OS, seeded from ui_prefs at startup BEFORE the first
    // show (decorations negotiate at surface creation): Linux = system chrome,
    // macOS = overlay (native traffic lights over the header). The .slint
    // default is the safe Linux one.
    in-out property <bool> use-system-title-bar: true;
    // APPLIED chrome state (what the window was actually created with, vs the
    // persisted pref above which the settings toggle edits). All chrome
    // bindings (no-frame, header drag/inset/controls)
    // read THIS one. Rust decides per platform how the pref propagates:
    // Linux mirrors the pref here live (hot apply, today's behavior); macOS
    // leaves it at the startup value (the overlay attributes are fixed at
    // window creation — restart to apply).
    in-out property <bool> system-title-bar-active: true;
    // Tiling-WM variant: frameless without drawn controls / header drag.
    in-out property <bool> hide-title-bar: false;
    // Phase 2 (deferred): rounded corners matching the desktop decoration.
    in-out property <bool> match-system-chrome: false;
    // True when GPU acceleration is on (gates match-system-chrome).
    in-out property <bool> hardware-accel-enabled: true;
    // Window controls group.
    in-out property <[string]> wc-positions: [@tr("Left"), @tr("Right")];
    in-out property <int> wc-position-index: 1;
    in-out property <[string]> wc-styles: [@tr("Rectangular"), @tr("Full-height rounded"), @tr("Circular"), @tr("Square")];
    in-out property <int> wc-style-index: 0;
    in-out property <[string]> wc-sizes: [@tr("Small"), @tr("Normal"), @tr("Large")];
    in-out property <int> wc-size-index: 1;
    in-out property <[string]> wc-color-presets: [@tr("Default"), "macOS", "Adwaita", @tr("Monochrome"), @tr("Custom")];
    in-out property <int> wc-color-preset-index: 0;
    in-out property <bool> show-window-controls: true;

    // --- STARTUP -----------------------------------------------------------
    in-out property <[string]> startup-pages: [@tr("Home"), @tr("Where you left off")];
    in-out property <int> startup-page-index: 0;

    // --- SYSTEM TRAY -------------------------------------------------------
    // `is-macos` is set once from Rust (cfg!(target_os = "macos")) so the tray
    // section can swap the header to "Menu Bar" and show macOS-only controls.
    in-out property <bool> is-macos: false;
    in-out property <bool> tray-enable: true;
    in-out property <bool> tray-minimize-to-tray: false;
    in-out property <bool> tray-close-to-tray: false;
    // macOS-only: hide the Dock icon when closed to the menu bar (.accessory
    // activation policy). Off = Spotify-style (keep the Dock icon).
    in-out property <bool> tray-mac-hide-dock: false;
    in-out property <[string]> tray-icon-themes: [@tr("Auto"), @tr("Mono light"), @tr("Mono dark"), @tr("Color")];
    in-out property <int> tray-icon-theme-index: 0;

    // --- RENDERER ----------------------------------------------------------
    // Linux-only: the renderer tier (wgpu / GL / software) is a startup-time
    // choice there. Hidden by default; Rust flips this on for Linux. macOS is
    // always Skia/Metal, so the row never shows.
    in-out property <bool> renderer-setting-visible: false;
    in-out property <[string]> renderer-options: [@tr("Auto (recommended)"), @tr("GPU"), @tr("GPU (compatibility)"), @tr("Software")];
    in-out property <int> renderer-index: 0;
    // Preferred GPU: options built in Rust from the detected adapters
    // ("Auto" + each GPU by name); index 0 = Auto.
    in-out property <[string]> gpu-power-modes: [@tr("Auto (recommended)")];
    in-out property <int> gpu-power-index: 0;

    // --- INTERFACE SIZE ----------------------------------------------------
    // Window scale-factor preset (XS 0.8 / Small 0.9 / Default 1.0 /
    // Large 1.2 / XL 1.5) — startup-time choice, restart to apply.
    // Index 2 = Default.
    in-out property <[string]> ui-scale-options: [@tr("Extra small"), @tr("Small"), @tr("Default"), @tr("Large"), @tr("Extra large")];
    in-out property <int> ui-scale-index: 2;

    // --- APP-WIDE DYNAMIC BACKGROUND ("modo Cider") ------------------------
    // Album-art background composited behind the WHOLE shell. Opt-in, wgpu-tier
    // only. 0 = Off, 1 = Ambient (GPU shader scene 7), 2 = Blurred art (the
    // ImmersiveAtmosphere blurred-cover look). Persisted in ui_prefs
    // (`app_background`) via appearance-select("app-background", i).
    in-out property <[string]> app-background-modes: [@tr("Off"), @tr("Ambient"), @tr("Blurred art")];
    in-out property <int> app-background-mode-index: 0;
    // False on the femtovg-GL / software tiers (no wgpu underlay, and
    // reduce-motion is forced ON there → the effect would freeze). Seeded from
    // Rust (= use_gpu_renderer); gates the whole picker row.
    in-out property <bool> app-background-available: false;
    // Live-tunable look knobs, seeded from Rust env at startup (QBZ_BG_DIM /
    // QBZ_BG_SURFACE_ALPHA) so the appearance can be dialed in a single smoke
    // session without recompiling, then baked to constants. `dim` = extra dark
    // scrim over the background for legibility; `surface-alpha` = translucency
    // of the shell chrome when the background is active.
    in-out property <float> app-background-dim: 0.35;
    in-out property <float> app-background-surface-alpha: 0.5;
    // Thin BARS (jump-nav, discover toolbar, network tab row, playlist action
    // bar) go MORE transparent than the panels — they read as chrome strips over
    // the frosted content panel, not solid bars. Env QBZ_BG_BAR_ALPHA.
    in-out property <float> app-background-bar-alpha: 0.3;

    // Callbacks. Unwired in this replica — the Rust side may bind them
    // later. Kept generic (key + value) so the controller can dispatch.
    callback appearance-bool(string /* key */, bool /* value */);
    callback appearance-select(string /* key */, int /* index */);
    callback appearance-text(string /* key */, string /* value */);
    callback appearance-action(string /* key */);
}
