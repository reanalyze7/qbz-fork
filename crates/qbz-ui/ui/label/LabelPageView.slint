// Label landing page — the rich label view (Tauri's LabelView.svelte):
// a circular-portrait header with description + Follow, a sticky JUMP TO
// bar, a Popular Tracks list, and Releases / Critics' Picks / Playlists /
// Artists / More Labels carousels. Faithful 1:1 port assembled from
// existing primitives — the header, bio modal and Popular Tracks block
// mirror ArtistPageView; the carousels reuse Carousel / PlaylistCarousel /
// ArtistCarousel verbatim.
//
// Split into sibling files to keep this under the 130-line cap:
// LabelPageHeader, LabelPopularTracks, LabelCarousels, LabelLibraryTab,
// LabelDescModal, LabelPageOverlays (sticky JUMP TO bar + scrollbar).
// `jump-anchor`/`page-flickable` stay here since the sticky JUMP TO bar's
// Y math depends on both being in this component tree (the computed
// `natural-top` offset is threaded into LabelPageOverlays as a prop).

import { Theme } from "../foundation/semantic-colors.slint";
import { LabelState, DragState, NavState, ShellState } from "../state.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { LabelPageHeader } from "LabelPageHeader.slint";
import { LabelPopularTracks } from "LabelPopularTracks.slint";
import { LabelCarousels } from "LabelCarousels.slint";
import { LabelLibraryTab } from "LabelLibraryTab.slint";
import { LabelDescModal } from "LabelDescModal.slint";
import { LabelPageOverlays } from "LabelPageOverlays.slint";

export component LabelPageView inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    // Full-description modal (same pattern as ArtistPageView's bio modal).
    property <bool> show-desc: false;
    // Active JUMP TO tab (set on click; passive scroll-tracking is a
    // follow-up, matching ArtistPageView).
    property <string> active-jump-tab: "about";

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    page-flickable := Flickable {
        // Don't scroll while a track is being dragged out (keeps the row's
        // pointer grab so the drag-end fires) — matches the other track views.
        interactive: !DragState.active;
        viewport-width: self.width;
        viewport-height: page.preferred-height;
        // Scroll-position restore on back/forward (see nav::scope_for).
        property <string> sr-armed: NavState.restore-scope;
        function sr-restore() {
            if (NavState.restore-scope == "label" && self.viewport-height > self.height) {
                self.viewport-y = NavState.scroll-restore;
                NavState.restore-scope = "";
            }
        }
        init => { self.sr-restore(); }
        changed sr-armed => { self.sr-restore(); }
        changed viewport-height => { self.sr-restore(); }
        changed viewport-y => { NavState.report-scroll(self.viewport-y); }

        page := VerticalLayout {
            width: parent.width;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 11px;
            padding-bottom: 100px;
            spacing: 0px;
            alignment: start;

            // --- History navigation --------------------------------------
            HorizontalLayout {
                alignment: start;
                NavButtons { }
            }

            Rectangle { height: 22px; }

            // --- Label header --------------------------------------------
            LabelPageHeader {
                content-width: root.width;
                show-description => { root.show-desc = true; }
                media-action(kind, id, action) => { root.media-action(kind, id, action); }
            }

            // Reservation for the sticky JUMP TO overlay (its 44px + gap).
            // The overlay anchors its natural y to this element. Only the
            // catalog tab has jump sections — collapse the reservation in
            // library mode.
            jump-anchor := Rectangle {
                height: LabelState.label-tab == "catalog" ? 52px : 0px;
            }

            // Catalog content — the whole /label/page stack renders only in
            // "catalog" mode; "library" swaps to the user's added albums
            // below (artist-page parity, same wrap-without-reindent idiom).
            if LabelState.label-tab == "catalog": VerticalLayout {
                spacing: 0px;

                LabelPopularTracks {
                    media-action(kind, id, action) => { root.media-action(kind, id, action); }
                }

                LabelCarousels {
                    open-album(id) => { root.open-album(id); }
                    open-artist(id) => { root.open-artist(id); }
                    media-action(kind, id, action) => { root.media-action(kind, id, action); }
                }
            }

            // --- In library — the user's added items on this label ----------
            if LabelState.label-tab == "library": LabelLibraryTab {
                open-album(id) => { root.open-album(id); }
                media-action(kind, id, action) => { root.media-action(kind, id, action); }
            }
        }
    }

    // --- Overlays: sticky JUMP TO bar + scrollbar gutter --------------------
    // Declared AFTER the page Flickable so it paints on top, but BEFORE the
    // modal below so the modal still stacks above it.
    LabelPageOverlays {
        natural-top: jump-anchor.absolute-position.y - page-flickable.absolute-position.y;
        viewport-height: page-flickable.viewport-height;
        visible-height: page-flickable.height;
        viewport-y <=> page-flickable.viewport-y;
        active-jump-tab <=> root.active-jump-tab;
    }

    // --- Full-description modal ---------------------------------------------
    LabelDescModal {
        show <=> root.show-desc;
    }
}
