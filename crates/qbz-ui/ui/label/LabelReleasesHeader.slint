// LabelReleasesView header: circular 180px portrait + name/total-albums
// block. Split out of LabelReleasesView.slint to keep files under the
// 130-line cap.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { LabelState } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

export component LabelReleasesHeader inherits HorizontalLayout {
    spacing: 24px;
    alignment: start;
    Rectangle {
        width: 180px;
        height: 180px;
        border-radius: 90px;
        background: Theme.surface-elevated;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 8px;
        clip: true;
        if LabelState.image-url == "": QbzIcon {
            source: @image-url("../assets/icons/disc-3.svg");
            width: 60px;
            height: 60px;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            tint: Theme.text-muted;
        }
        Image {
            width: 100%;
            height: 100%;
            source: LabelState.image;
            image-fit: cover;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        horizontal-stretch: 1;
        Text {
            text: @tr("LABEL");
            color: Theme.text-muted;
            font-size: 10px;
            font-weight: Typography.semibold;
            letter-spacing: 1.5px;
        }
        Text {
            text: LabelState.name;
            color: Theme.text-primary;
            // Hero homologated to the canonical 18px (section).
            font-size: Typography.section;
            font-weight: Typography.bold;
        }
        if LabelState.total > 0: Text {
            text: LabelState.total + " " + @tr("albums");
            color: Theme.text-muted;
            font-size: Typography.body;
        }
    }
}
