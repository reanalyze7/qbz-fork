// LabelReleasesView — the "See all releases" sub-view reached from the
// label landing's Releases carousel. A circular label header over the
// full album catalog, with a toolbar (search / group-by-artist / Hi-Res
// filter / sort) and a grid/list toggle, plus load-more pagination.
//
// The rendered set (`visible` / `grouped`) is derived in Rust from the
// loaded catalog (crate::label::derive_releases). Search is a local
// filter over the loaded catalog.
//
// Split into sibling files to keep this under the 130-line cap:
// LabelReleasesHeader (circular portrait), LabelReleasesToolbar
// (search/group/Hi-Res/sort/grid-list), LoadMoreRow (pagination footer).

import { Theme } from "../foundation/semantic-colors.slint";
import { LabelState, NavState, ShellState } from "../state.slint";
import { AlbumCollectionView } from "../discover/AlbumCollectionView.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { LabelReleasesHeader } from "LabelReleasesHeader.slint";
import { LabelReleasesToolbar } from "LabelReleasesToolbar.slint";
import { LabelReleasesStates } from "LabelReleasesStates.slint";
import { LoadMoreRow } from "LoadMoreRow.slint";

export component LabelReleasesView inherits Rectangle {
    callback open-album(string);
    callback open-artist(string);
    callback media-action(string, string, string);

    property <length> list-row-gap: 4px;

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    flick := Flickable {
        viewport-width: self.width;
        viewport-height: page.preferred-height;
        // Scroll-position restore on back/forward (see nav::scope_for).
        property <string> sr-armed: NavState.restore-scope;
        function sr-restore() {
            if (NavState.restore-scope == "label-releases" && self.viewport-height > self.height) {
                self.viewport-y = NavState.scroll-restore;
                NavState.restore-scope = "";
            }
        }
        init => { self.sr-restore(); }
        changed sr-armed => { self.sr-restore(); }
        changed viewport-height => { self.sr-restore(); }
        changed viewport-y => { NavState.report-scroll(self.viewport-y); }

        page := VerticalLayout {
            width: parent.width;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 11px;
            padding-bottom: 100px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                alignment: start;
                NavButtons { }
            }

            Rectangle { height: 22px; }

            LabelReleasesHeader { }

            Rectangle { height: 24px; }

            LabelReleasesToolbar { }

            Rectangle { height: 24px; }

            // --- States --------------------------------------------------
            LabelReleasesStates { }

            // --- Album collection (grouped / flat grid / flat list) ------
            AlbumCollectionView {
                is-grouped: LabelState.group-by-artist;
                albums: LabelState.visible;
                grouped: LabelState.grouped;
                view-mode: LabelState.view-mode;
                show-source: false;
                list-row-gap: root.list-row-gap;
                // Viewport windowing (Phase 1): only cards near the
                // visible band mount. The offset approximates the static
                // content above the grid: 11px padding-top + 22px spacer
                // + 180px label header + 24px spacer + ~42px toolbar +
                // 24px spacer ≈ 303px; the grid's one-viewport margin
                // absorbs the small error.
                windowed: true;
                visible-top: -flick.viewport-y;
                visible-height: flick.height;
                content-offset: 303px;
                // Element windowing only; artwork stays per-page — pages
                // arrive index-keyed with covers already on the model
                // (id-keyed banding is a future migration).
                open-album(id) => {
                    root.open-album(id);
                }
                open-artist(id) => {
                    root.open-artist(id);
                }
                media-action(kind, id, action) => {
                    root.media-action(kind, id, action);
                }
            }

            // --- Load more -----------------------------------------------
            // Driven by `has-more` — /label/getAlbums caps each page well
            // below the catalog, so `total` is an unreliable gate.
            if LabelState.albums.length > 0 && LabelState.has-more: LoadMoreRow { }
        }
    }

    // Shared scrollbar in the right gutter (homologated cross-view).
    ListScrollbar {
        x: parent.width - self.width - 4px;
        width: 14px;
        height: 100%;
        viewport-height: flick.viewport-height;
        visible-height: flick.height;
        viewport-y <=> flick.viewport-y;
    }
}
