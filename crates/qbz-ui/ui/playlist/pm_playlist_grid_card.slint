// Playlist Manager — GRID-mode playlist card.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PmPlaylistItem } from "../state.slint";
import { PmCollage } from "../primitives/PmCollage.slint";
import { PmLocalBadge } from "pm_shared_bits.slint";
import { PmItemActions } from "pm_item_actions.slint";
import { PmGridReorderHeader } from "pm_reorder_controls.slint";

export component PmGridCard inherits Rectangle {
    in property <PmPlaylistItem> item;
    in property <int> index;
    in property <int> total;
    in property <bool> can-reorder: false;
    callback open();
    callback favorite();
    callback visibility();
    callback edit();
    callback mixtape();
    callback move-up();
    callback move-down();

    width: 160px;
    // pad(10) + [reorder 22 + gap 8] + collage 140 + gap 8 + name 18 +
    // gap 8 + footer 22 + pad(10). Tauri's name is a single-line 13px
    // title (the .grid-item .name); we elide instead of 2-line clamp.
    height: root.can-reorder ? 250px : 220px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface-hover : Theme.surface-card;
    opacity: root.item.is-hidden ? 0.6 : 1.0;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        // Pack children at the top so the footer sits right under the name
        // (matching Tauri's `.grid-item` flex column — no justify-content,
        // 8px gaps). Without this the layout stretches and pushes the footer
        // to the bottom edge, leaving a large gap after the name.
        alignment: start;

        // Optional reorder header (custom sort only).
        if root.can-reorder: PmGridReorderHeader {
            move-up => { root.move-up(); }
            move-down => { root.move-down(); }
        }

        // Artwork + availability badge.
        Rectangle {
            width: 140px;
            height: 140px;
            PmCollage {
                item: root.item;
                size: 140px;
            }
            PmLocalBadge {
                x: parent.width - self.width - 6px;
                y: 6px;
                status: root.item.local-status;
                is-local-pl: root.item.is-local-playlist;
                offline-only: root.item.offline-only;
            }
        }

        Text {
            text: root.item.name;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: Typography.medium;
            overflow: elide;
            width: 140px;
            height: 18px;
            vertical-alignment: center;
        }

        // Footer: meta + actions.
        HorizontalLayout {
            width: 140px;
            height: 22px;
            alignment: space-between;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.item.tracks-line;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            PmItemActions {
                item: root.item;
                btn-size: 24px;
                glyph: 14px;
                favorite => { root.favorite(); }
                visibility => { root.visibility(); }
                edit => { root.edit(); }
                mixtape => { root.mixtape(); }
            }
        }
    }
    ta := TouchArea {
        // Covers the collage + name region (above the footer actions) so a
        // card-body click opens the playlist while the footer buttons keep
        // their own clicks. Sits below the reorder header when present.
        width: parent.width;
        // pad(10) + collage(140) + gap(8) + name(18) = 176.
        height: 176px;
        y: root.can-reorder ? 30px : 0px;
        mouse-cursor: pointer;
        clicked => {
            root.open();
        }
    }
}
