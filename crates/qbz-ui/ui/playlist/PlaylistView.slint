// Playlist detail view. Same anatomy as AlbumView / MixView: a header
// (cover + "Playlist" label + name + description + "owner • N tracks •
// duration" info line + circular actions) over a column-headed track
// list of shared TrackRows (show-artwork + show-album). Composed from the
// smaller playlist/* pieces — see refactor-plans for the split rationale.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PlaylistState, PlaylistSuggestionsState, ShellState } from "../state.slint";
import { LoadingSpinner } from "../primitives/LoadingSpinner.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { PlaylistHeader } from "PlaylistHeader.slint";
import { PlaylistTrackListHeader } from "PlaylistTrackListHeader.slint";
import { PlaylistTrackList } from "PlaylistTrackList.slint";
import { PlaylistBackToTopFab } from "PlaylistBackToTopFab.slint";
import { SuggestedSongsPanel } from "SuggestedSongsPanel.slint";
import { UploadConfirmModal } from "UploadConfirmModal.slint";
import { DescriptionModal } from "DescriptionModal.slint";

export component PlaylistView inherits Rectangle {
    callback play-track(string);
    callback play-all();
    callback shuffle();
    callback toggle-favorite();
    callback edit();
    callback media-action(string, string, string);

    // Read-more description modal.
    property <bool> show-description: false;
    // "Upload to Qobuz" confirm modal (local playlists, D8).
    property <bool> show-upload-confirm: false;

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    page := VerticalLayout {
        // Fill PlaylistView so the track list's vertical-stretch has real
        // height (otherwise it collapses to a single row).
        width: 100%;
        height: 100%;
        padding-left: 32px;
        // Smaller right padding so the track list + scrollbar use the
        // space instead of leaving a dead band on the right.
        padding-right: 16px;
        padding-top: 11px;
        padding-bottom: 16px;
        spacing: 0px;

        HorizontalLayout {
            vertical-stretch: 0;
            alignment: start;
            NavButtons { }
        }

        // Same nav -> header separation as AlbumView (homologated).
        Rectangle { height: 22px; }

        PlaylistHeader {
            play-all => { root.play-all(); }
            shuffle => { root.shuffle(); }
            toggle-favorite => { root.toggle-favorite(); }
            edit => { root.edit(); }
            media-action(kind, id, action) => { root.media-action(kind, id, action); }
            open-upload-confirm => { root.show-upload-confirm = true; }
            open-description => { root.show-description = true; }
        }

        Rectangle { height: 18px; }

        if PlaylistState.loading: HorizontalLayout {
            vertical-stretch: 0;
            alignment: center;
            LoadingSpinner { size: 36px; }
        }
        if !PlaylistState.loading && PlaylistState.tracks.length == 0: Text {
            text: @tr("This playlist is empty.");
            color: Theme.text-muted;
            font-size: Typography.body;
        }

        if PlaylistState.tracks.length > 0: PlaylistTrackListHeader { }
        Rectangle { height: 6px; }

        track-list-panel := PlaylistTrackList {
            play-track(id) => { root.play-track(id); }
            media-action(kind, id, action) => { root.media-action(kind, id, action); }
        }

        // --- Suggested Songs (T8) — docks below the (virtualized) track
        // list: the list owns its own scroll, so unlike the Svelte page
        // flow this section can't scroll INTO view. Shown only after
        // manual activation, and self-hides once the filtered pool is
        // exhausted (matching the Svelte guard).
        if PlaylistSuggestionsState.activated && !PlaylistSuggestionsState.is-empty
            && PlaylistState.is-owner && PlaylistState.track-count < 2000: SuggestedSongsPanel { }
    }

    // Back to top — appears once the list is scrolled past one viewport.
    // A shared rule for big lists (playlists, library, ...).
    if track-list-panel.viewport-y < -track-list-panel.visible-height: PlaylistBackToTopFab {
        // Clear the right-gutter scrollbar (14px + 4px margin) so the FAB
        // never sits over it.
        x: root.width - self.width - 40px;
        y: root.height - self.height - 24px;
        clicked => { track-list-panel.scroll-to-top(); }
    }

    // "Upload to Qobuz" confirm (D8) — destructive-ish conversion: the
    // local entity is deleted once the upload completes.
    if root.show-upload-confirm: UploadConfirmModal {
        cancel => { root.show-upload-confirm = false; }
        confirm => {
            root.show-upload-confirm = false;
            root.media-action("playlist", PlaylistState.id, "upload-to-qobuz");
        }
    }

    // Read-more description modal (same treatment as Album / Artist).
    if root.show-description: DescriptionModal {
        close => { root.show-description = false; }
    }

    // The floating reorder ghost is the app-wide DragGhost (AppShell): the
    // reorder IS the normal row-body drag, so the ghost is positioned by
    // the proven Rust DragActions window coords — no component-local
    // ghost, no row absolute-position math.
}
