// Playlist Manager — TREE-mode folder row.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PmTreeRow } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { PmFolderIcon } from "../primitives/PmFolderIcon.slint";
import { PmActionButton } from "pm_shared_bits.slint";

export component PmTreeFolderRow inherits Rectangle {
    in property <PmTreeRow> entry;
    callback toggle();
    callback edit();
    height: 44px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: root.entry.expanded
                    ? @image-url("../assets/icons/chevron-down.svg")
                    : @image-url("../assets/icons/chevron-right.svg");
                width: 15px;
                height: 15px;
                tint: Theme.text-muted;
            }
        }
        VerticalLayout {
            alignment: center;
            PmFolderIcon {
                folder: root.entry.folder;
                size: 28px;
                glyph-size: 15px;
                radius: 6px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.folder.name;
                color: Theme.text-primary;
                font-size: Typography.body;
                font-weight: Typography.semibold;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.entry.folder.count;
                color: Theme.text-muted;
                font-size: Typography.legal;
            }
        }
        VerticalLayout {
            alignment: center;
            PmActionButton {
                icon: @image-url("../assets/icons/pencil.svg");
                clicked => { root.edit(); }
            }
        }
    }
    ta := TouchArea {
        width: parent.width - 40px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.toggle();
        }
    }
}
