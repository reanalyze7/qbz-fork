// Playlist Manager toolbar — dropdown menu row + labeled/icon-only tool
// buttons (filter/sort dropdown triggers, folder/flat + view-cycle toggles,
// New-folder button).

import { Theme } from "../foundation/semantic-colors.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";

// One dropdown-menu row.
export component PmMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    // Collapse property — `for x: if c: El` is disallowed in Slint 1.16, so
    // a hidden item collapses to zero height instead (the sidebar pattern).
    in property <bool> shown: true;
    callback activated();
    height: root.shown ? 30px : 0px;
    visible: root.shown;
    border-radius: 5px;
    background: mi-ta.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.label;
            color: root.selected ? Theme.accent : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.selected: VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../assets/icons/check.svg");
                width: 13px;
                height: 13px;
                tint: Theme.accent;
            }
        }
    }
    mi-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// A toolbar icon button with a small text label (the dropdown triggers
// and the New-folder button).
export component PmToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 34px;
    width: row.preferred-width + 22px;
    border-radius: 6px;
    background: root.active
        ? Theme.accent
        : (ta.has-hover ? Theme.surface-hover : Theme.surface-elevated);
    row := HorizontalLayout {
        x: 11px;
        y: 0;
        height: parent.height;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: root.icon;
                width: 15px;
                height: 15px;
                tint: root.active ? #ffffff : Theme.text-secondary;
            }
        }
        if root.label != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? #ffffff : Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A square icon-only toggle (folder/flat + view-mode cycle).
export component PmIconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: root.active
        ? Theme.accent
        : (ta.has-hover ? Theme.surface-hover : Theme.surface-elevated);
    QbzIcon {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        tint: root.active ? #ffffff : Theme.text-secondary;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
