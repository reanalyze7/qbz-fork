// Playlist view — one "Suggested Songs" row: 40px cover (play on hover),
// title + clickable artist · album meta, duration, and the info / add /
// dismiss actions (shown on row hover). 1:1 with the Svelte
// `.suggestion-row`.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PlaylistSuggestionsActions, PlaylistSuggestionRow } from "../state.slint";
import { QbzIcon } from "../primitives/QbzIcon.slint";
import { PlaylistSuggestionMeta } from "PlaylistSuggestionMeta.slint";
import { PlaylistSuggestionActions } from "PlaylistSuggestionActions.slint";

export component PlaylistSuggestionRowView inherits Rectangle {
    in property <PlaylistSuggestionRow> entry;

    // OR the background detector with every interactive child's hover so the
    // cover-play overlay + the trailing actions stay revealed (and clickable)
    // when the pointer moves onto them (mirrors TrackRow.row-hovered).
    property <bool> row-hovered:
        psr-ta.has-hover || play-ta.has-hover || row-actions.hovered;

    height: 56px;
    border-radius: 8px;
    background: root.row-hovered ? Theme.surface-hover : transparent;
    animate background { duration: 150ms; }

    // Background hover detector (below the interactive children).
    psr-ta := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // Artwork + hover play overlay.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 4px;
                clip: true;
                background: Theme.surface-elevated;
                Image {
                    source: root.entry.artwork;
                    image-fit: cover;
                    width: parent.width;
                    height: parent.height;
                }
                play-ov := Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #00000080;
                    opacity: root.row-hovered ? 1.0 : 0.0;
                    animate opacity { duration: 150ms; }
                    QbzIcon {
                        source: @image-url("../assets/icons/play-fill.svg");
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: #ffffff;
                    }
                    play-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            PlaylistSuggestionsActions.play-track(root.entry.track-id);
                        }
                    }
                }
            }
        }

        // Title + meta (artist · album, clickable links).
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.entry.title;
                color: Theme.text-primary;
                font-size: Typography.body;
                font-weight: Typography.medium;
                overflow: elide;
            }
            PlaylistSuggestionMeta { entry: root.entry; }
        }

        // Duration.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Text {
                text: root.entry.duration-label;
                color: Theme.text-muted;
                font-size: Typography.legal;
                horizontal-alignment: right;
                width: 44px;
            }
        }

        // Actions (info / add / dismiss) — fade in on row hover. The
        // cluster's own hover feeds root.row-hovered so it stays up while used.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            row-actions := PlaylistSuggestionActions {
                entry: root.entry;
                opacity: root.row-hovered ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }
            }
        }
    }
}
