// Playlist Manager — the full playlist + folder organization surface
// (Tauri's PlaylistManagerView). A fixed header/toolbar (Back/NavButtons +
// title + search + filter/sort dropdowns + folder/flat toggle + view-mode
// cycle + New folder + counter) over a scrolling FOLDERS section and a
// PLAYLISTS section with three view modes (grid / list / tree).
//
// Rows are precomputed in Rust (crate::playlist_manager) and pushed as
// ready-to-render models, so this view does no per-row map lookups.
// Backend is reused via the PlaylistManagerActions callbacks.
//
// Split across sibling `pm_*.slint` files by UI region — see each file's
// header comment. This file stays the sole export other `.slint` files
// import, and keeps the scroll-restore Flickable + ListScrollbar wiring
// colocated (both depend on the `pm-flick` id).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PlaylistManagerState, NavState, ShellState } from "../state.slint";
import { LoadingSpinner } from "../primitives/LoadingSpinner.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { PmToolbarHeader } from "pm_header.slint";
import { PmFoldersSection } from "pm_folders_section.slint";
import { PmPlaylistsContent } from "pm_playlists_content.slint";

export component PlaylistManagerView inherits Rectangle {
    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    VerticalLayout {
        spacing: 0px;

        PmToolbarHeader { }

        // --- Scrolling content -----------------------------------------
        pm-flick := Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: page.preferred-height;
            // Scroll-position restore on back/forward (see nav::scope_for).
            property <string> sr-armed: NavState.restore-scope;
            function sr-restore() {
                if (NavState.restore-scope == "playlist-manager" && self.viewport-height > self.height) {
                    self.viewport-y = NavState.scroll-restore;
                    NavState.restore-scope = "";
                }
            }
            init => { self.sr-restore(); }
            changed sr-armed => { self.sr-restore(); }
            changed viewport-height => { self.sr-restore(); }
            changed viewport-y => { NavState.report-scroll(self.viewport-y); }

            page := VerticalLayout {
                width: parent.width;
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 6px;
                padding-bottom: 100px;
                spacing: 0px;
                alignment: start;

                // Counter + drag hint.
                HorizontalLayout {
                    height: 24px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("{} folders, {} playlists",
                                PlaylistManagerState.folder-count,
                                PlaylistManagerState.playlist-count);
                            color: Theme.text-muted;
                            font-size: Typography.legal;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if PlaylistManagerState.can-reorder: VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Use the arrows to reorder playlists");
                            color: Theme.text-muted;
                            font-size: Typography.legal;
                        }
                    }
                }

                Rectangle { height: 14px; }

                if PlaylistManagerState.loading: HorizontalLayout {
                    alignment: center;
                    LoadingSpinner { size: 36px; }
                }

                if !PlaylistManagerState.loading
                    && PlaylistManagerState.folder-mode
                    && PlaylistManagerState.view-mode != "tree"
                    && PlaylistManagerState.folders.length > 0: PmFoldersSection { }

                if !PlaylistManagerState.loading: PmPlaylistsContent { }
            }
        }
    }

    // Shared scrollbar in the right gutter (homologated cross-view). Sits
    // below the fixed 56px toolbar so it tracks only the scrolling area.
    ListScrollbar {
        x: parent.width - self.width - 4px;
        y: 56px;
        width: 14px;
        height: parent.height - 56px;
        viewport-height: pm-flick.viewport-height;
        visible-height: pm-flick.height;
        viewport-y <=> pm-flick.viewport-y;
        auto-hide: true;
        hover-active: ShellState.pointer-in-window
            && ShellState.pointer-x >= pm-flick.absolute-position.x
            && ShellState.pointer-x <= pm-flick.absolute-position.x + pm-flick.width
            && ShellState.pointer-y >= pm-flick.absolute-position.y
            && ShellState.pointer-y <= pm-flick.absolute-position.y + pm-flick.height;
    }
}
