// Playlist Manager — TREE-mode playlist row.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PmTreeRow } from "../state.slint";
import { PmCollage } from "../primitives/PmCollage.slint";
import { PmActionButton } from "pm_shared_bits.slint";

export component PmTreePlaylistRow inherits Rectangle {
    in property <PmTreeRow> entry;
    callback open();
    callback favorite();
    callback edit();
    height: 40px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface-hover : transparent;
    opacity: root.entry.playlist.is-hidden ? 0.6 : 1.0;
    HorizontalLayout {
        padding-left: root.entry.indent ? 36px : 10px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            PmCollage {
                item: root.entry.playlist;
                size: 28px;
                radius: 5px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.playlist.name;
                color: Theme.text-primary;
                font-size: Typography.body;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.entry.playlist.tracks-line;
                color: Theme.text-muted;
                font-size: Typography.legal;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 0px;
                opacity: ta.has-hover ? 1.0 : 0.0;
                PmActionButton {
                    icon: root.entry.playlist.is-favorite
                        ? @image-url("../assets/icons/heart-filled.svg")
                        : @image-url("../assets/icons/heart.svg");
                    filled: root.entry.playlist.is-favorite;
                    clicked => { root.favorite(); }
                }
                PmActionButton {
                    icon: @image-url("../assets/icons/pencil.svg");
                    clicked => { root.edit(); }
                }
            }
        }
    }
    ta := TouchArea {
        width: parent.width - 90px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.open();
        }
    }
}
