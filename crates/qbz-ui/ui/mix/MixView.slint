// Qobuz mix detail view (DailyQ / WeeklyQ / FavQ / TopQ). Ported to
// the AlbumView level: a header (gradient artwork + "Qobuz Mixes"
// label + title + description + "N tracks • duration" info line +
// circular action buttons) over a track list with a column header
// and rich rows (artwork + title/artist + album + duration + quality
// + favorite + more).
//
// Split into sibling files to keep this under the 130-line cap:
// MixHeader (artwork + metadata + action buttons), MixTrackList (column
// header + track rows), MixCircleAction (local action-button component).
// The outer Flickable, scroll-restore logic, and ListScrollbar stay here
// since they're bound to this component's own instances.

import { Theme } from "../foundation/semantic-colors.slint";
import { MixState, DragState, NavState, ShellState } from "../state.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { MultiSelectBar } from "../primitives/MultiSelectBar.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { MixHeader } from "MixHeader.slint";
import { MixTrackList } from "MixTrackList.slint";

export component MixView inherits Rectangle {
    callback play-track(string);
    callback play-all();
    callback shuffle();
    callback refresh();
    callback media-action(string, string, string);

    // Per-mix header gradient, matching the QobuzMixesRow tiles.
    property <brush> mix-gradient:
        MixState.kind == "daily"
            ? @linear-gradient(135deg, #1e3a8a 0%, #6366f1 50%, #c084fc 100%)
        : MixState.kind == "weekly"
            ? @linear-gradient(135deg, #065f46 0%, #10b981 50%, #fbbf24 100%)
        : MixState.kind == "fav"
            ? @linear-gradient(135deg, #7f1d1d 0%, #ef4444 50%, #fb923c 100%)
            : @linear-gradient(135deg, #1f2937 0%, #4b5563 50%, #fbbf24 100%);

    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    flick := Flickable {
        interactive: !DragState.active;
        viewport-width: self.width;
        viewport-height: page.preferred-height;
        // Scroll-position restore on back/forward (see nav::scope_for).
        property <string> sr-armed: NavState.restore-scope;
        function sr-restore() {
            if (NavState.restore-scope == "mix" && self.viewport-height > self.height) {
                self.viewport-y = NavState.scroll-restore;
                NavState.restore-scope = "";
            }
        }
        init => { self.sr-restore(); }
        changed sr-armed => { self.sr-restore(); }
        changed viewport-height => { self.sr-restore(); }
        changed viewport-y => { NavState.report-scroll(self.viewport-y); }

        page := VerticalLayout {
            width: parent.width;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 11px;
            padding-bottom: 100px;
            spacing: 0px;
            alignment: start;

            HorizontalLayout {
                alignment: start;
                NavButtons { }
            }

            Rectangle { height: 22px; }

            MixHeader {
                mix-gradient: root.mix-gradient;
                content-width: root.width;
                play-all => { root.play-all(); }
                shuffle => { root.shuffle(); }
                media-action(kind, id, action) => { root.media-action(kind, id, action); }
                refresh => { root.refresh(); }
            }

            Rectangle { height: 28px; }

            // Bulk action bar — visible in multi-select mode. Scrolls with the
            // page (same as AlbumView). Actions bubble via media-action("mix").
            if MixState.multi-select: MultiSelectBar {
                selected-count: MixState.selected-count;
                actions: [
                    { id: "select-all", label: @tr("Select all"), icon: @image-url("../assets/icons/square-check-big.svg"), danger: false, needs-selection: false },
                    { id: "play-next", label: @tr("Play next"), icon: @image-url("../assets/icons/list-plus.svg"), danger: false, needs-selection: true },
                    { id: "queue", label: @tr("Add to queue"), icon: @image-url("../assets/icons/list-end.svg"), danger: false, needs-selection: true },
                    { id: "add-to-playlist", label: @tr("Add to playlist"), icon: @image-url("../assets/icons/list-music.svg"), danger: false, needs-selection: true },
                    { id: "add-to-mixtape", label: @tr("Add to Mixtape/Collection"), icon: @image-url("../assets/icons/cassette-tape.svg"), danger: false, needs-selection: true },
                    { id: "clear", label: @tr("Clear"), icon: @image-url("../assets/icons/x.svg"), danger: false, needs-selection: true },
                ];
                action(id) => {
                    root.media-action("mix", "", id);
                }
            }
            if MixState.multi-select: Rectangle { height: 8px; }

            MixTrackList {
                play-track(id) => { root.play-track(id); }
                media-action(kind, id, action) => { root.media-action(kind, id, action); }
            }
        }
    }

    // Shared scrollbar in the right gutter (homologated cross-view).
    ListScrollbar {
        x: parent.width - self.width - 4px;
        width: 14px;
        height: 100%;
        viewport-height: flick.viewport-height;
        visible-height: flick.height;
        viewport-y <=> flick.viewport-y;
    }
}
