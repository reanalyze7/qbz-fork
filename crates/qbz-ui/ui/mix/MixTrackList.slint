// MixView track list: loading/empty states, column header row, and the
// TrackRow loop. Split out of MixView.slint to keep files under the
// 130-line cap. The ListScrollbar stays in MixView.slint since it's bound
// to the outer Flickable instance, not to this content.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { MixState } from "../state.slint";
import { TrackRow } from "../primitives/TrackRow.slint";
import { LoadingSpinner } from "../primitives/LoadingSpinner.slint";
import { HiResFilterButton } from "../primitives/HiResFilterButton.slint";

export component MixTrackList inherits VerticalLayout {
    callback play-track(string);
    callback media-action(string, string, string);

    // "Hi-Res only" filter. Local to this component: the toggle and the
    // rows it hides are both here, so no owner above needs to see it.
    property <bool> hires-only: false;

    // Filter pill, right-aligned above the column header — same slot the
    // genre-filter pill takes in the Favorites / Library track toolbars.
    if MixState.tracks.length > 0: HorizontalLayout {
        padding-right: 12px;
        padding-bottom: 8px;
        alignment: end;
        HiResFilterButton {
            active: root.hires-only;
            clicked => { root.hires-only = !root.hires-only; }
        }
    }

    if MixState.loading: HorizontalLayout {
        alignment: center;
        LoadingSpinner { size: 36px; }
    }
    if !MixState.loading && MixState.tracks.length == 0: Text {
        text: @tr("No tracks for this mix.");
        color: Theme.text-muted;
        font-size: Typography.body;
    }

    // --- Track list column header ------------------------------
    if MixState.tracks.length > 0: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        Text {
            text: "#";
            width: 40px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Title");
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-stretch: 1;
        }
        Text {
            text: @tr("Album");
            width: 220px;
            color: Theme.text-muted;
            font-size: Typography.legal;
        }
        Text {
            text: @tr("Duration");
            width: 64px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Quality");
            width: 92px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-alignment: center;
        }
        Rectangle { width: 28px; }
        Rectangle { width: 32px; }
    }
    if MixState.tracks.length > 0: Rectangle { height: 3px; }
    if MixState.tracks.length > 0: Rectangle {
        height: 1px;
        background: Theme.border-subtle;
    }
    Rectangle { height: 6px; }

    // Reuses the shared TrackRow (album column + favorite
    // + track context menu). A row "play" starts the mix from
    // that track; menu actions bubble up as media-action.
    for track[i] in MixState.tracks: TrackRow {
        visible: !root.hires-only || track.quality-tier == "hires";
        height: self.visible ? 50px : 0px;
        track: track;
        index: i;
        multi-select-mode: MixState.multi-select;
        show-artwork: true;
        show-album: true;
        show-favorite: true;
        media-action(kind, id, action) => {
            if (action == "play") {
                root.play-track(id);
            } else {
                root.media-action(kind, id, action);
            }
        }
    }
}
