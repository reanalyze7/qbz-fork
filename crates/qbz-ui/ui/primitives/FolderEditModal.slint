// Folder editor modal — create + edit a playlist folder (Tauri's
// FolderEditModal). Name field, an icon-preset grid, a solid-color swatch
// grid, a custom-image picker, a hidden toggle, and save/delete.
//
// Driven by FolderEditState/FolderEditActions. The icon-preset + color
// grids are built once by the Rust controller and pushed as models.
//
// The body sections live in sibling files (FolderNameField, FolderIconGrid,
// FolderColorGrid, FolderEditButtons) that each read/write
// FolderEditState/FolderEditActions directly rather than through passed-in
// properties — consistent with the rest of this UI, where globals are the
// state layer and components are pure views.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { FolderEditState, FolderEditActions } from "../state.slint";
import { QbzIcon } from "QbzIcon.slint";
import { FolderNameField } from "FolderNameField.slint";
import { FolderIconGrid } from "FolderIconGrid.slint";
import { FolderColorGrid } from "FolderColorGrid.slint";
import { FolderEditButtons } from "FolderEditButtons.slint";

export component FolderEditModal inherits Rectangle {
    visible: FolderEditState.open;

    if FolderEditState.open: Rectangle {
        background: #000000bf;
        TouchArea {
            mouse-cursor: default;
            clicked => { FolderEditActions.close(); }
        }
        Rectangle {
            width: Math.min(root.width - 80px, 480px);
            height: panel.preferred-height;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            border-radius: Radius.md;
            background: Theme.surface-card;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;
            TouchArea { }

            panel := VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Title + close.
                HorizontalLayout {
                    Text {
                        text: FolderEditState.id == "" ? @tr("New folder") : @tr("Edit folder");
                        color: Theme.text-primary;
                        font-size: Typography.heading;
                        font-weight: Typography.semibold;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    close-x := TouchArea {
                        width: 28px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { FolderEditActions.close(); }
                        QbzIcon {
                            source: @image-url("../assets/icons/x.svg");
                            width: 17px;
                            height: 17px;
                            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                            tint: close-x.has-hover ? Theme.text-primary : Theme.text-muted;
                        }
                    }
                }

                FolderNameField { }
                FolderIconGrid { }
                FolderColorGrid { }
                FolderEditButtons { }
            }
        }
    }
}
