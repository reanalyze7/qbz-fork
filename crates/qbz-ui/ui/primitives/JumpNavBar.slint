// JUMP TO bar — reusable sticky tab bar with an inline search input.
//
// Tauri shows this above each section-rich page (artist, library,
// future label / musician views), pinned to the top of its scroll
// container once scrolled past the header. Per-tab click callbacks let
// the parent decide what each tab scrolls to; the search icon expands an
// inline search input in the tab row itself (Tauri's `.page-search.open`
// behaviour), animated with a width transition.
//
// Presentation-only — sticky positioning is the parent's responsibility.
// Reuse: drop the bar inside any layout, pass `tabs` + the active id,
// wire `tab-clicked`, `search-clicked`, `search-text-edited`.
//
// The tab row, animated search input, and outer toggle button live in
// sibling files (JumpNavTabRow, JumpNavSearchOverlay, JumpNavSearchToggle);
// this file stays the single import surface and composes them.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { JumpNavTab, JumpNavTabRow } from "JumpNavTabRow.slint";
import { JumpNavSearchOverlay } from "JumpNavSearchOverlay.slint";
import { JumpNavSearchToggle } from "JumpNavSearchToggle.slint";

export { JumpNavTab }

export component JumpNavBar inherits Rectangle {
    in property <[JumpNavTab]> tabs;
    in property <string> active-tab-id;
    // Passed in so the parent can make it translucent under the app-wide
    // dynamic background (can't import ShellState: state.slint imports
    // JumpNavTab from here, so the reverse import would cycle).
    in property <brush> bar-bg: Theme.surface-main;
    // Artist pages offer inline search; the label page does not.
    in property <bool> show-search: true;
    in-out property <bool> search-open: false;
    in-out property <string> search-text;

    // Focus the input when it opens so the caret lands inside without
    // an extra click.
    changed search-open => {
        if (root.search-open) {
            search-overlay.focus-search();
        }
    }
    callback tab-clicked(string /* tab-id */, length /* anchor-y */);
    callback search-clicked();
    callback search-text-edited(string);

    height: 44px;
    background: root.bar-bg;
    border-width: 0px;

    // Bottom border so the bar reads as a separate strip when
    // sticky over the body content.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 18px;
        alignment: stretch;

        // JUMP TO label
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Text {
                text: @tr("JUMP TO");
                color: Theme.text-muted;
                font-size: Typography.legal;
                font-weight: Typography.semibold;
                letter-spacing: 0.5px;
            }
        }

        // Center region — tabs AND the animated search input share this
        // slot; the search input grows from 0 width on the right edge,
        // covering the tabs as it expands.
        center-region := Rectangle {
            horizontal-stretch: 1;
            clip: true;

            JumpNavTabRow {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                tabs: root.tabs;
                active-tab-id: root.active-tab-id;
                search-open: root.search-open;
                tab-clicked(id, anchor-y) => {
                    root.tab-clicked(id, anchor-y);
                }
            }

            search-overlay := JumpNavSearchOverlay {
                region-width: center-region.width;
                region-height: center-region.height;
                search-open: root.search-open;
                search-text <=> root.search-text;
                search-clicked => {
                    root.search-clicked();
                }
                search-text-edited(text) => {
                    root.search-text-edited(text);
                }
            }
        }

        // Outer search toggle — only while closed. `if` (not `visible:`)
        // reclaims the slot for the center region when open, letting the
        // expanded input reach the bar's right padding.
        if root.show-search && !root.search-open: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            JumpNavSearchToggle {
                clicked => {
                    root.search-clicked();
                }
            }
        }
    }
}
