// HiFi Wizard (DAC setup) — Slint shell. The 6-step modal skeleton
// (scrim + card + stepper + footer nav). Navigation is handled inline by
// mutating DacWizardState (open/close/next/back need no Rust). The
// wizard stays READ-ONLY — it never writes a system audio file.
//
// Modal recipe mirrors PlaylistImportModal: overlay Rectangle (not a
// window grab), so playback keeps running underneath while the test
// step plays.
//
// Each step body lives in its own DacStep*.slint sibling file (welcome ·
// check · select-dacs · review · test · done); this file stays the
// import surface and owns the scrim/card/header/stepper-rail/footer.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { DacWizardState } from "../state.slint";
import { ListScrollbar } from "ListScrollbar.slint";
import { DacWizardHeader } from "DacWizardHeader.slint";
import { DacWizardStepperRail } from "DacWizardStepperRail.slint";
import { DacWizardFooter } from "DacWizardFooter.slint";
import { DacStepWelcome } from "DacStepWelcome.slint";
import { DacStepCheck } from "DacStepCheck.slint";
import { DacStepSelectDacs } from "DacStepSelectDacs.slint";
import { DacStepReview } from "DacStepReview.slint";
import { DacStepTest } from "DacStepTest.slint";
import { DacStepDone } from "DacStepDone.slint";

export component DacWizardModal inherits Rectangle {
    visible: DacWizardState.open;

    // Step labels for the header rail (index = DacWizardState.step).
    property <[string]> steps: [
        @tr("Welcome"), @tr("Check"), @tr("DACs"),
        @tr("Configure"), @tr("Test"), @tr("Done"),
    ];

    if DacWizardState.open: Rectangle {
        background: #000000bf;
        // Scrim — click outside closes.
        TouchArea {
            mouse-cursor: default;
            clicked => {
                DacWizardState.open = false;
            }
        }

        card := Rectangle {
            width: Math.min(root.width - 80px, 620px);
            height: Math.min(Math.max(500px, body.preferred-height + 210px), root.height * 0.9);
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            border-radius: Radius.lg;
            background: Theme.surface-card;
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;
            // Swallow clicks so they never reach the scrim.
            TouchArea { }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                DacWizardHeader { }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                DacWizardStepperRail { steps: root.steps; }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Body — scrolls when a step outgrows the card, with a visible
                // scrollbar. Wrapped in a Rectangle so the scrollbar can overlay.
                Rectangle {
                    vertical-stretch: 1;
                    body-flick := Flickable {
                    viewport-width: self.width;
                    viewport-height: body.preferred-height;

                    body := VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        alignment: start;

                        if DacWizardState.step == 0: DacStepWelcome { }
                        if DacWizardState.step == 1: DacStepCheck { }
                        if DacWizardState.step == 2: DacStepSelectDacs { }
                        if DacWizardState.step == 3: DacStepReview { }
                        if DacWizardState.step == 4: DacStepTest { }
                        if DacWizardState.step == 5: DacStepDone { }
                    }
                    }
                    ListScrollbar {
                        x: parent.width - self.width - 2px;
                        width: 12px;
                        height: 100%;
                        viewport-height: body-flick.viewport-height;
                        visible-height: body-flick.height;
                        viewport-y <=> body-flick.viewport-y;
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                DacWizardFooter { }
            }
        }
    }
}
