// Animated inline search input for JumpNavBar — slides in from the right
// when search-open flips to true and shrinks back to 0 width when it goes
// false. Exposes focus-search() since JumpNavBar can't reach into a child
// component's private elements to focus the TextInput directly.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { QbzIcon } from "QbzIcon.slint";
import { UiFocusState } from "../focus-state.slint";

export component JumpNavSearchOverlay inherits Rectangle {
    // The root element of a component can't reference `parent` directly
    // (it has none when previewed/instantiated standalone), so the
    // enclosing region's size is threaded in explicitly instead.
    in property <length> region-width;
    in property <length> region-height;
    in property <bool> search-open;
    in-out property <string> search-text;
    callback search-clicked();
    callback search-text-edited(string);
    public function focus-search() {
        search-input.focus();
    }

    // 216px (= 60% of the previous 360 cap) keeps the open input as a
    // compact box pinned to the right side of the bar — wide enough to
    // read a few words of query, narrow enough not to swallow the tabs
    // visually. min() guards narrow viewports.
    property <length> max-open-width: 216px;
    x: root.region-width - self.width;
    y: 4px;
    width: root.search-open
        ? min(root.region-width, self.max-open-width)
        : 0px;
    height: root.region-height - 8px;
    background: Theme.surface-card;
    border-radius: 6px;
    border-width: 1px;
    border-color: search-input.has-focus
        ? Theme.border-subtle
        : Theme.surface-card;
    clip: true;
    animate width { duration: 200ms; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        // Leading magnifier glyph.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            QbzIcon {
                source: @image-url("../assets/icons/search.svg");
                width: 14px;
                height: 14px;
                tint: Theme.text-muted;
            }
        }
        // Input + placeholder share a stretched cell.
        Rectangle {
            horizontal-stretch: 1;
            search-input := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.text-primary;
                font-size: Typography.body;
                vertical-alignment: center;
                single-line: true;
                text <=> root.search-text;
                changed has-focus => { UiFocusState.text-input-focused = self.has-focus; }
                edited => {
                    root.search-text-edited(self.text);
                }
            }
            Text {
                visible: search-input.text == "";
                width: 100%;
                height: 100%;
                text: @tr("Search this page…");
                color: Theme.text-muted;
                font-size: Typography.body;
                vertical-alignment: center;
            }
        }
        // Trailing X — clears the query and closes the input. Lives
        // INSIDE the input so the close affordance reads as part of the
        // search widget (not a stray button hanging off the side of the
        // bar).
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: clear-ta.has-hover
                    ? Theme.surface-elevated
                    : transparent;
                QbzIcon {
                    source: @image-url("../assets/icons/x.svg");
                    width: 12px;
                    height: 12px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: clear-ta.has-hover
                        ? Theme.text-primary
                        : Theme.text-muted;
                }
                clear-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.search-clicked();
                    }
                }
            }
        }
    }
}
