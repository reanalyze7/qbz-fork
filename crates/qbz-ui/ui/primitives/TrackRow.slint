// The single, shared track-list row. Every track surface (album, artist
// Popular, search, favorites, mix, playlist) renders this with flags
// rather than its own copy — show-artwork, show-album, show-favorite,
// show-download, multi-select-mode, etc. Everything routes through one
// media-action(kind, id, action): "play"|"play-next"|"queue"|"favorite"|
// "download"|"toggle-select" and the context-menu actions. The row-body
// drag/click TouchArea lives in TrackRowInteraction.slint; the column
// cells live in TrackRowCells.slint (+ sibling TrackRow*Cell.slint
// files). This file is the import surface: public property/callback
// list, `row-hovered`, `open-track-menu`, composing the pieces above.

import { Theme } from "../foundation/semantic-colors.slint";
import { TrackItem, TrackMenuState } from "../state.slint";
import { TrackRowInteraction } from "TrackRowInteraction.slint";
import { TrackRowCells } from "TrackRowCells.slint";

export component TrackRow inherits Rectangle {
    in property <TrackItem> track;
    // Blacklisted rows render dimmed + INERT in place: opacity 0.4, no
    // play/drag/menu-play/favorite/download, nav-only menu, a blacklist
    // glyph in the number/play cell (mirrors Tauri's `.blacklisted`).
    property <bool> row-inert: root.track.is-blacklisted;
    // Fade out when removing (favorites un-favorite); inert dims to 0.4.
    opacity: root.track.removing
        ? 0.0
        : (root.row-inert ? 0.4 : 1.0);
    animate opacity { duration: 250ms; }
    in property <int> index;
    in property <bool> show-artwork: true;
    in property <bool> show-album: false;
    in property <bool> show-favorite: false;
    // Keeps the favorite column's 28px slot when the heart is hidden
    // (playlist detail mixes heart/heart-less rows; Tauri: placeholder).
    in property <bool> reserve-favorite: false;
    // Every Qobuz row carries the offline cloud/check button by default;
    // an already-local surface sets this false.
    in property <bool> show-download: true;
    // Local Library: a per-source indicator INSTEAD of favorite/offline.
    in property <bool> show-source: false;
    in property <bool> multi-select-mode: false;
    // Trailing "..." menu column. Off for menu-less (ephemeral) rows.
    in property <bool> show-menu: true;
    // Library surfaces force the LOCAL menu even for "qobuz"-sourced
    // rows (qobuz_download offline copies) — spec §3.4.
    in property <bool> force-local-menu: false;
    // Playlist-detail "Remove from playlist" (ownership, spec §3.1).
    in property <bool> remove-from-playlist-action: false;
    // Track Info menu entry visibility (spec §3.3); default on.
    in property <bool> track-info-action: true;
    // Go to Album/Artist on LOCAL rows: ON for force-local-menu surfaces;
    // mixed surfaces opt in explicitly (only RESOLVED rows have navigable keys).
    in property <bool> local-goto-actions: root.force-local-menu
        && root.track.source != "ephemeral";
    // Custom-order reorder chevrons at the leading edge.
    in property <bool> show-reorder: false;
    // Drag-reorder (#589) RIDES the row-body drag — no separate grip; a
    // reorderable row reports its visible index right before the drag
    // starts (TrackRowInteraction); the parent reads it from DragState.
    callback body-drag-started(int /* visible index */);
    in property <bool> draggable: true;
    callback media-action(string, string, string);
    // Explicit track number, else the 1-based list position.
    property <string> number-text:
        root.track.number != "" ? root.track.number : "\{root.index + 1}";
    property <bool> row-hovered:
        interaction.hovered || cells.leading-hovered || cells.menu-hovered;
    // `root.absolute-position - root.x/y`, computed once and threaded
    // into children needing window-coordinate math — see
    // TrackRowInteraction's doc comment.
    property <length> row-origin-x: root.absolute-position.x - root.x;
    property <length> row-origin-y: root.absolute-position.y - root.y;
    height: 50px;
    border-radius: 8px;
    // Alpha ramp keeps hover visible on light themes too; zebra as-is.
    background: root.row-hovered
        ? Theme.alpha-8
        : (Math.mod(root.index, 2) == 1 ? #ffffff07 : transparent);

    interaction := TrackRowInteraction {
        track: root.track;
        index: root.index;
        row-inert: root.row-inert;
        multi-select-mode: root.multi-select-mode;
        draggable: root.draggable;
        show-reorder: root.show-reorder;
        show-menu: root.show-menu;
        row-origin-x: root.row-origin-x;
        row-origin-y: root.row-origin-y;
        body-drag-started(i) => { root.body-drag-started(i); }
        media-action(kind, id, action) => { root.media-action(kind, id, action); }
        open-menu-at-pointer(x, y) => { root.open-track-menu(x, y, true); }
    }
    cells := TrackRowCells {
        track: root.track;
        number-text: root.number-text;
        show-artwork: root.show-artwork;
        show-album: root.show-album;
        show-favorite: root.show-favorite;
        reserve-favorite: root.reserve-favorite;
        show-download: root.show-download;
        show-source: root.show-source;
        multi-select-mode: root.multi-select-mode;
        show-menu: root.show-menu;
        show-reorder: root.show-reorder;
        row-inert: root.row-inert;
        row-hovered: root.row-hovered;
        media-action(kind, id, action) => { root.media-action(kind, id, action); }
        menu-clicked => { root.open-track-menu(0px, 0px, false); }
    }
    // Opens the ONE shell-level unified track menu (TrackMenuState /
    // AppShell). at-pointer = right-click (x clamped to the row so the
    // menu never overflows past the "..." gutter); otherwise anchored at
    // the gutter. 224px = TrackContextMenu's width.
    function open-track-menu(local-x: length, local-y: length, at-pointer: bool) {
        TrackMenuState.track-id = root.track.id;
        TrackMenuState.source = root.track.source;
        TrackMenuState.cache-status = root.track.cache-status;
        TrackMenuState.row-inert = root.row-inert;
        TrackMenuState.force-local-menu = root.force-local-menu;
        TrackMenuState.remove-from-playlist-action = root.remove-from-playlist-action;
        TrackMenuState.track-info-action = root.track-info-action;
        TrackMenuState.local-goto-actions = root.local-goto-actions;
        TrackMenuState.x = root.row-origin-x
            + (at-pointer
                ? Math.max(0px, Math.min(local-x, root.width - 224px - 12px))
                : root.width - 224px - 12px);
        TrackMenuState.y = root.row-origin-y + (at-pointer ? local-y : 48px);
        TrackMenuState.open-token += 1;
    }
}
