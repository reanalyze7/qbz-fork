// Title + artist column for TrackRow.
//
// femtovg measures some scripts' runs at ~0 (Korean at Typography.link,
// Japanese measures fine), so NOTHING about the title line may be
// content-measured or the line collapses and the glyphs have nowhere to
// paint. SongCard parity (the one surface where Korean renders): a plain
// Rectangle direct in the column, NO clip, Text width assigned — plus a
// FIXED height here, so both axes are layout-assigned and measurement is
// never trusted.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";

export component TrackRowTitleCell inherits VerticalLayout {
    in property <string> title;
    in property <string> artist;
    in property <string> artist-id;
    in property <bool> explicit: false;
    in property <bool> multi-select-mode: false;
    callback artist-open();

    alignment: center;
    horizontal-stretch: 1;
    spacing: 2px;

    title-line := Rectangle {
        height: 20px;
        title-text := Text {
            x: 0;
            // Reserve the badge slot (16px + 6px gap) when explicit so
            // the elide stops before the badge, never under it.
            width: parent.width - (root.explicit ? 22px : 0px);
            height: 100%;
            text: root.title;
            color: Theme.text-primary;
            font-size: Typography.link;
            font-weight: Typography.medium;
            vertical-alignment: center;
            overflow: elide;
        }
        // Explicit "E" badge — hugs the END of the title text (Tauri's
        // .track-title-row: flex, gap 6px, badge flex-shrink:0), not the
        // column's far right. preferred-width only POSITIONS the badge
        // (the title's own width stays assigned, so a bogus ~0
        // measurement can't blank it); when the run measures ~0 with a
        // non-empty title (the femtovg Korean case), hugging is
        // impossible, so the badge parks in the right-edge slot the
        // title width already reserves.
        if root.explicit: Rectangle {
            x: (root.title != "" && title-text.preferred-width < 1px)
                ? title-text.width + 6px
                : Math.min(title-text.preferred-width + 6px,
                           title-text.width + 6px);
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: Theme.surface-elevated;
            Text {
                text: "E";
                color: Theme.text-muted;
                font-size: 9px;
                font-weight: Typography.semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // Artist — a clickable link when an artist-id is present (opens the
    // artist view), plain muted text otherwise. The TouchArea is sized to
    // the text via the wrapping layout so it doesn't swallow clicks
    // across the whole row width.
    if root.artist != "": HorizontalLayout {
        alignment: start;
        Rectangle {
            width: artist-link.preferred-width;
            artist-link := Text {
                text: root.artist;
                color: (root.artist-id != "" && artist-ta.has-hover)
                    ? Theme.text-primary
                    : Theme.text-muted;
                font-size: Typography.legal;
                overflow: elide;
            }
            artist-ta := TouchArea {
                // Only interactive when there is an artist to open;
                // disabled in select mode so the click selects the row.
                enabled: root.artist-id != "" && !root.multi-select-mode;
                mouse-cursor: root.artist-id != "" ? pointer : default;
                clicked => {
                    root.artist-open();
                }
            }
        }
    }
}
