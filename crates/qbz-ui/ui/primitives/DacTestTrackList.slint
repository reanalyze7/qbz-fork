// The four curated test-track rows for DacStepTest — click one to jump
// straight to it while testing (no need to wait for each to finish).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { DacWizardState, DacWizardActions } from "../state.slint";

export component DacTestTrackList inherits VerticalLayout {
    // Display only; resolution of the actual tracks is Rust-side.
    property <[string]> test-tracks: [
        @tr("16-bit / 44.1 kHz — George Harrison · My Sweet Lord"),
        @tr("24-bit / 44.1 kHz — Billie Eilish · LUNCH"),
        @tr("24-bit / 96 kHz — Iron Maiden · Stratego"),
        @tr("24-bit / 192 kHz — Toto · Africa"),
    ];

    spacing: 4px;
    for line[idx] in root.test-tracks: Rectangle {
        height: 26px;
        border-radius: Radius.sm;
        background: (trow.has-hover && DacWizardState.test-playing)
            ? Theme.surface-hover : transparent;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            alignment: start;
            // Fixed glyph slot (width + height) so the ♪→▶ hover swap
            // can never reflow the row.
            Text {
                width: 14px;
                height: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: (trow.has-hover && DacWizardState.test-playing) ? "▶" : "♪";
                color: (trow.has-hover && DacWizardState.test-playing)
                    ? Theme.accent : Theme.text-muted;
                font-size: Typography.legal;
            }
            Text {
                text: line;
                color: Theme.text-secondary;
                font-size: Typography.legal;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        trow := TouchArea {
            mouse-cursor: DacWizardState.test-playing ? pointer : default;
            clicked => {
                if (DacWizardState.test-playing) {
                    DacWizardActions.test-play-index(idx);
                }
            }
        }
    }
}
