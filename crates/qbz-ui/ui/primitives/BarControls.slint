// Shared now-playing-bar control primitives. Extracted from PlayerBar so the
// transport cluster (TransportControls) and the bar's right cluster can both
// use them without duplicating definitions.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { QbzIcon } from "QbzIcon.slint";
import { LoadingSpinner } from "LoadingSpinner.slint";
import { TooltipState } from "../state.slint";

// Square, compact icon button with a hover tooltip.
export component IconButton inherits Rectangle {
    in property <image> icon;
    // +50% (owner request): 16 -> 24.
    in property <length> icon-size: 24px;
    in property <bool> active: false;
    in property <string> tooltip;
    // Footprint tight around the icon (icon-size + 12px hover padding) so the
    // bigger glyph doesn't leave a big empty margin — a flat 48px box for a
    // 24px icon read as oversized whitespace between controls.
    in property <length> btn-width: root.icon-size + 12px;
    // Disabled (e.g. transport with nothing playing) — dimmed + non-clickable,
    // 1:1 with Tauri's `.disabled` controls (opacity 0.3).
    in property <bool> enabled: true;
    callback clicked();

    width: root.btn-width;
    height: root.icon-size + 12px;
    border-radius: Radius.sm;
    opacity: root.enabled ? 1.0 : 0.3;
    background: (ta.has-hover && root.enabled) ? Theme.surface-hover : transparent;

    // Screen-reader surface: the tooltip text IS the accessible name (both
    // describe the same action), and `active` (shuffle/repeat/mute toggles)
    // maps to the ARIA-style checked state so a toggle reads its own state.
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-checked: root.active;

    QbzIcon {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        // Pixel-snap the centring so fine SVGs don't render blurry.
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        tint: root.active
            ? Theme.accent
            : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover && root.enabled && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor-x = root.absolute-position.x + root.width / 2;
                TooltipState.anchor-y = root.absolute-position.y;
                TooltipState.show = true;
            } else if (!self.has-hover) {
                TooltipState.show = false;
            }
        }
    }
}

// Primary play/pause button. `circle` = the New layout's filled white disc;
// `circle: false` = the Classic layout's plain glyph (no disc, tinted like the
// other transport icons, accent on hover — a 1:1 of the Tauri play button).
export component PlayButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> circle: true;
    // While a play is resolving/downloading (no audio yet) the glyph is
    // swapped for a spinner so the click reads as "heard, audio is coming".
    in property <bool> loading: false;
    // Disabled when there is nothing to play (no current track).
    in property <bool> enabled: true;
    callback clicked();

    // 30px icon (+50% from 20px) + a tight 10px hover margin — not a flat
    // oversized box (that read as a big gap around the glyph).
    width: root.circle ? 44px : 40px;
    height: root.circle ? 44px : 40px;
    border-radius: root.circle ? 19px : Radius.sm;
    // Full opacity even when disabled — a washed-out circle read as blurry;
    // Spotify/Apple Music keep the play button crisp and just ignore clicks.
    opacity: root.circle ? 1.0 : (root.enabled ? 1.0 : 0.3);
    background: root.circle
        ? ((ta.has-hover && root.enabled) ? #ffffffd6 : #ffffff)
        : ((ta.has-hover && root.enabled) ? Theme.surface-hover : transparent);
    // HC-only border on the white disc so it stays delineated against a
    // light HC background (1:1 Tauri otherwise — zero change in normal themes).
    border-width: (root.circle && Theme.is-high-contrast) ? 1px : 0px;
    border-color: Theme.border-strong;

    // Screen-reader surface — tooltip text doubles as the accessible name
    // ("Play"/"Pause", set by the caller).
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;

    if !root.loading: QbzIcon {
        source: root.icon;
        // +50%: 20 -> 30.
        width: 30px;
        height: 30px;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        tint: root.circle
            ? #000000
            : (ta.has-hover ? Theme.accent : Theme.text-primary);
    }

    if root.loading: LoadingSpinner {
        size: 30px;
        // Dark on the solid white disc, accent on the plain-glyph variant.
        tint: root.circle ? #000000 : Theme.accent;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover && root.enabled && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor-x = root.absolute-position.x + root.width / 2;
                TooltipState.anchor-y = root.absolute-position.y;
                TooltipState.show = true;
            } else if (!self.has-hover) {
                TooltipState.show = false;
            }
        }
    }
}
