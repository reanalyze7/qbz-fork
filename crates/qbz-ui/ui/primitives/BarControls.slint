// Shared now-playing-bar control primitives. Extracted from PlayerBar so the
// transport cluster (TransportControls) and the bar's right cluster can both
// use them without duplicating definitions.
//
// Re-export shim: IconButton and PlayButton now live in their own files
// (IconButton.slint / PlayButton.slint) to keep each under the 130-line
// cap; this file stays the public import surface so existing importers
// (`import { IconButton, PlayButton } from "../primitives/BarControls.slint";`)
// keep working unchanged.

export { IconButton } from "IconButton.slint";
export { PlayButton } from "PlayButton.slint";
