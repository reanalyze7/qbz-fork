// The "Add to playlist" picker's scrollable playlist list: loading spinner,
// "no results" empty state, and the row loop (spec
// PLAYLIST-REDESIGN-SPEC.md §2). Split out of PlaylistAddModal.slint to stay
// under the 130-line budget and because it's a cohesive unit on its own —
// list only, no search/header logic (that lives in the shell).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PlaylistPickerState } from "../state.slint";
import { LoadingSpinner } from "LoadingSpinner.slint";
import { PlaylistAddRow } from "PlaylistAddRow.slint";

export component PlaylistAddList inherits Rectangle {
    vertical-stretch: 1;

    if PlaylistPickerState.loading: HorizontalLayout {
        alignment: center;
        padding: 24px;
        LoadingSpinner { size: 28px; }
    }

    if !PlaylistPickerState.loading && PlaylistPickerState.filter-matches == 0: Rectangle {
        height: 80px;
        Text {
            width: 100%;
            height: 100%;
            text: PlaylistPickerState.filter != ""
                ? @tr("No playlists found")
                : @tr("No playlists yet");
            color: Theme.text-muted;
            font-size: Typography.body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !PlaylistPickerState.loading: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: list.preferred-height;
        list := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 8px;
            spacing: 2px;
            for pl[i] in PlaylistPickerState.playlists: PlaylistAddRow {
                item: pl;
                index: i;
            }
        }
    }
}
