// Leading half of TrackRow's column-cell row: reorder gutter, position
// number, the leading play/select stack, title/artist, and album.
// `leading-hovered` is re-exposed so TrackRow can fold it into its
// row-hovered background calc.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { TrackItem } from "../state.slint";
import { TrackRowReorderGutter } from "TrackRowReorderGutter.slint";
import { TrackRowLeadingStack } from "TrackRowLeadingStack.slint";
import { TrackRowTitleCell } from "TrackRowTitleCell.slint";
import { TrackRowAlbumCell } from "TrackRowAlbumCell.slint";

export component TrackRowLeadCells inherits HorizontalLayout {
    in property <TrackItem> track;
    in property <string> number-text;
    in property <bool> show-artwork: true;
    in property <bool> show-album: false;
    in property <bool> multi-select-mode: false;
    in property <bool> show-reorder: false;
    in property <bool> row-inert: false;
    in property <bool> row-hovered: false;
    out property <bool> leading-hovered: leading.hovered;
    callback media-action(string, string, string);

    // Stretches to fill the row (via the title cell's own stretch) so
    // TrackRowTrailCells lands at the row's right edge, matching the
    // original single-HorizontalLayout layout.
    horizontal-stretch: 1;
    spacing: 14px;

    if root.show-reorder: TrackRowReorderGutter {
        move-up => { root.media-action("track", root.track.id, "move-up"); }
        move-down => { root.media-action("track", root.track.id, "move-down"); }
    }

    // Position number — only for artwork rows (the cover doesn't carry
    // the number; non-artwork rows show it in the play cell).
    if root.show-artwork && !root.multi-select-mode: VerticalLayout {
        alignment: center;
        Text {
            text: root.number-text;
            // Wide enough for 4-digit positions (big playlists).
            width: 32px;
            color: Theme.text-muted;
            font-size: Typography.legal;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    VerticalLayout {
        alignment: center;
        leading := TrackRowLeadingStack {
            track: root.track;
            number-text: root.number-text;
            show-artwork: root.show-artwork;
            row-hovered: root.row-hovered;
            row-inert: root.row-inert;
            multi-select-mode: root.multi-select-mode;
            play => { root.media-action("track", root.track.id, "play"); }
            toggle-select => { root.media-action("track", root.track.id, "toggle-select"); }
        }
    }

    TrackRowTitleCell {
        title: root.track.title;
        artist: root.track.artist;
        artist-id: root.track.artist-id;
        explicit: root.track.explicit;
        multi-select-mode: root.multi-select-mode;
        artist-open => { root.media-action("artist", root.track.artist-id, "open"); }
    }

    if root.show-album: TrackRowAlbumCell {
        album: root.track.album;
        album-id: root.track.album-id;
        multi-select-mode: root.multi-select-mode;
        album-open => { root.media-action("album", root.track.album-id, "open"); }
    }
}
