// Primary play/pause button. `circle` = the New layout's filled white disc;
// `circle: false` = the Classic layout's plain glyph (no disc, tinted like
// the other transport icons, accent on hover — a 1:1 of the Tauri play
// button). Split out of BarControls.slint to keep files under the 130-line
// cap.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { QbzIcon } from "QbzIcon.slint";
import { LoadingSpinner } from "LoadingSpinner.slint";
import { TooltipState } from "../state.slint";

export component PlayButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> circle: true;
    // While a play is resolving/downloading (no audio yet) the glyph is
    // swapped for a spinner so the click reads as "heard, audio is coming".
    in property <bool> loading: false;
    // Disabled when there is nothing to play (no current track).
    in property <bool> enabled: true;
    callback clicked();

    // 30px icon (+50% from 20px) + a tight 10px hover margin — not a flat
    // oversized box (that read as a big gap around the glyph).
    width: root.circle ? 44px : 40px;
    height: root.circle ? 44px : 40px;
    border-radius: root.circle ? 19px : Radius.sm;
    // Full opacity even when disabled — a washed-out circle read as blurry;
    // Spotify/Apple Music keep the play button crisp and just ignore clicks.
    opacity: root.circle ? 1.0 : (root.enabled ? 1.0 : 0.3);
    background: root.circle
        ? ((ta.has-hover && root.enabled) ? #ffffffd6 : #ffffff)
        : ((ta.has-hover && root.enabled) ? Theme.surface-hover : transparent);
    // HC-only border on the white disc so it stays delineated against a
    // light HC background (1:1 Tauri otherwise — zero change in normal themes).
    border-width: (root.circle && Theme.is-high-contrast) ? 1px : 0px;
    border-color: Theme.border-strong;

    // Screen-reader surface — tooltip text doubles as the accessible name
    // ("Play"/"Pause", set by the caller).
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;

    if !root.loading: QbzIcon {
        source: root.icon;
        // +50%: 20 -> 30.
        width: 30px;
        height: 30px;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        tint: root.circle
            ? #000000
            : (ta.has-hover ? Theme.accent : Theme.text-primary);
    }

    if root.loading: LoadingSpinner {
        size: 30px;
        // Dark on the solid white disc, accent on the plain-glyph variant.
        tint: root.circle ? #000000 : Theme.accent;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
    }

    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
        changed has-hover => {
            if (self.has-hover && root.enabled && root.tooltip != "") {
                TooltipState.text = root.tooltip;
                TooltipState.anchor-x = root.absolute-position.x + root.width / 2;
                TooltipState.anchor-y = root.absolute-position.y;
                TooltipState.show = true;
            } else if (!self.has-hover) {
                TooltipState.show = false;
            }
        }
    }
}
