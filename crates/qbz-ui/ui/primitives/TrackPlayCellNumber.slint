// TrackPlayCell — plain track-number variant: number text, equalizer bars,
// fetch spinner, circular play/pause glyph backing. Extracted from
// TrackPlayCell.slint (internal, composed only by that file).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { ShellState } from "../state.slint";
import { QbzIcon } from "QbzIcon.slint";
import { EqualizerBars } from "EqualizerBars.slint";

export component TrackPlayCellNumber inherits Rectangle {
    in property <string> number;
    in property <length> number-width: 32px;
    in property <bool> row-hovered: false;
    in property <bool> is-playing: false;
    in property <bool> is-loading: false;
    in property <bool> show-overlay: false;
    in property <bool> show-bars: false;

    width: root.number-width;
    height: 40px;

    if !root.show-overlay: Text {
        text: root.number;
        color: Theme.text-muted;
        font-size: Typography.body;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
    }
    if root.show-bars: EqualizerBars {
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
    }
    // Fetch spinner — wins over the play glyph / number while the active
    // row is still resolving/downloading.
    if root.is-loading: Image {
        width: 16px;
        height: 16px;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        source: @image-url("../assets/icons/loader-circle.svg");
        colorize: Theme.accent;
        transform-rotation: ((ShellState.reduce-motion
            ? ShellState.coarse-tick-ms * 1.0
            : animation-tick() / 1ms) * 0.36) * 1deg;
    }
    // Circular backing so the play/pause glyph is legible on EVERY theme
    // (the old bare #ffffff glyph vanished on light themes — white-on-white,
    // no scrim like the artwork variant has). Fill/border/shadow use the
    // polarity-baked alpha ramp (black-alpha on light, white-alpha on dark)
    // and the glyph uses text-primary = the theme's max-contrast color. #638.
    if root.show-overlay && !root.show-bars && !root.is-loading: Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
        y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
        background: Theme.alpha-10;
        border-width: 1px;
        border-color: Theme.alpha-15;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.card-shadow;
        QbzIcon {
            source: (root.is-playing && root.row-hovered)
                ? @image-url("../assets/icons/pause.svg")
                : @image-url("../assets/icons/play-fill.svg");
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: Theme.text-primary;
        }
    }
}
