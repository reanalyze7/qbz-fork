// Offline-cache column for TrackRow — a stateful affordance reflecting
// cache-status:
//   0 none        cloud-download  (click -> cache)
//   1/2 q'd/dl'ing loader (accent) (click -> cache; re-queues)
//   3 ready       circle-check    (click -> uncache)
//   4 failed      triangle-alert  (click -> cache; retries)

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { ShellState } from "../state.slint";
import { QbzIcon } from "QbzIcon.slint";

export component TrackRowDownloadCell inherits VerticalLayout {
    in property <int> cache-status;
    in property <bool> multi-select-mode: false;
    callback clicked();

    alignment: center;
    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: Radius.sm;
        background: dl-ta.has-hover ? Theme.surface-elevated : transparent;
        // Queued / downloading: a SPINNING loader (continuous rotation via
        // animation-tick, like LoadingSpinner) so it reads as "working in
        // the background". Isolated in its own `if` so the per-frame tick
        // only drives the row while it is downloading.
        if root.cache-status == 1 || root.cache-status == 2: Image {
            width: 16px;
            height: 16px;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            source: @image-url("../assets/icons/loader-circle.svg");
            colorize: Theme.accent;
            transform-rotation: ((ShellState.reduce-motion
                ? ShellState.coarse-tick-ms * 1.0
                : animation-tick() / 1ms) * 0.36) * 1deg;
        }
        // Idle / ready / failed: a static glyph.
        if root.cache-status != 1 && root.cache-status != 2: QbzIcon {
            source: root.cache-status == 3
                ? @image-url("../assets/icons/circle-check-big.svg")
                : (root.cache-status == 4
                    ? @image-url("../assets/icons/triangle-alert.svg")
                    : @image-url("../assets/icons/cloud-download.svg"));
            width: 16px;
            height: 16px;
            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
            tint: root.cache-status == 3
                ? Theme.accent
                : (root.cache-status == 4
                    ? #e0564f
                    : (dl-ta.has-hover ? Theme.text-primary : Theme.text-muted));
        }
        dl-ta := TouchArea {
            // Disabled in select mode so the click selects the row.
            enabled: !root.multi-select-mode;
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}
