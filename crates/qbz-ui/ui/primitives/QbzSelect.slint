// Dropdown select primitive — the standard option picker for settings.
//
// The QBZ UI uses dropdowns, never pill-style option buttons. Shows the
// current option and opens a PopupWindow list on click; picking an option
// emits `selected(index)`. `searchable` adds a case-insensitive filter box
// (hides non-matching rows by visibility only, so `selected(i)` still
// emits the original index); the open list is height-capped and scrolls.
// `badges` drives a "BP" tag or speaker glyph per option.
//
// The collapsed-control row and the open-list popup live in
// QbzSelectControl.slint / QbzSelectPopup.slint; this file stays the
// import surface, owns the shared sizing state, and hosts the PopupWindow.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { ShellState, AppearanceState } from "../state.slint";
import { QbzSelectControl } from "QbzSelectControl.slint";
import { QbzSelectPopup } from "QbzSelectPopup.slint";

export component QbzSelect inherits Rectangle {
    in property <[string]> options;
    // Optional, parallel to `options`: "BP" badge (true) or speaker glyph
    // (false) per entry. Empty (every non-device caller) draws no marker.
    in property <[bool]> badges: [];
    // Optional, parallel to `options`: a non-empty entry renders a
    // non-selectable section-header row above it. Empty means no headers.
    in property <[string]> groups: [];
    in property <int> current-index: 0;
    in property <length> menu-width: 240px;
    // Optional wider open list, for long labels. 0px = `menu-width`.
    in property <length> popup-width: 0px;
    in property <bool> enabled: true;
    // Bootstrap-style small variant; toolbars opt in with `sm: true`.
    in property <bool> sm: false;
    // Opt-in filter box for long lists. Off by default.
    in property <bool> searchable: false;
    callback selected(int);

    // Live filter text (searchable lists only); reset on open.
    private property <string> filter: "";
    // Toolbar (sm) selects were unnecessarily wide; trim 40px.
    private property <length> eff-width: root.menu-width - (root.sm ? 40px : 0px);
    private property <length> list-width: root.popup-width > root.eff-width
        ? root.popup-width : root.eff-width;
    private property <length> row-height: 32px;
    private property <length> header-height: 24px;
    private property <length> search-height: root.searchable ? 42px : 0px;
    private property <length> max-list-height: 360px;
    width: root.eff-width;
    height: root.sm ? 30px : 34px;
    border-radius: root.sm ? 6px : Radius.sm;
    border-width: root.sm ? 0px : 1px;
    border-color: Theme.border-subtle;
    // Glass look under the app-wide dynamic background.
    background: ta.has-hover && root.enabled
        ? Theme.surface-hover
        : (ShellState.app-background-active
            ? Theme.surface-elevated.with-alpha(AppearanceState.app-background-surface-alpha)
            : Theme.surface-elevated);
    opacity: root.enabled ? 1.0 : 0.4;

    QbzSelectControl {
        options: root.options;
        badges: root.badges;
        current-index: root.current-index;
        sm: root.sm;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.filter = "";
                popup.show();
            }
        }
    }

    // Keyboard activation: Enter/Space open the list, same as a click.
    fs := FocusScope {
        enabled: root.enabled;
        // Declared after `ta`, hit-tested first; focus-on-click:false stops
        // it eating the first press (two-click bug, see QbzPrimaryButton).
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.filter = "";
                popup.show();
                return accept;
            }
            return reject;
        }
    }
    // Non-layout focus ring, shown only on keyboard focus.
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-width: 2px;
        border-color: fs.has-focus ? Theme.focus-ring : transparent;
        border-radius: parent.border-radius;
    }

    popup := PopupWindow {
        // Right-anchored so a wider list grows leftward, staying on-screen.
        x: root.eff-width - root.list-width;
        y: root.height + 4px;
        width: root.list-width;
        height: root.search-height
            + Math.min(popup-content.list-preferred-height, root.max-list-height)
            + 10px;

        popup-content := QbzSelectPopup {
            options: root.options;
            badges: root.badges;
            groups: root.groups;
            current-index: root.current-index;
            sm: root.sm;
            searchable: root.searchable;
            filter <=> root.filter;
            row-height: root.row-height;
            header-height: root.header-height;
            search-height: root.search-height;
            max-list-height: root.max-list-height;
            selected(i) => {
                root.selected(i);
            }
        }
    }
}
