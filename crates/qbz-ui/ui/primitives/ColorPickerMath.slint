// ColorPicker — pure RGB<->hex/hue helper functions. Extracted from
// ColorPicker.slint (internal, composed only by that file). Stateless, so
// they live on a global singleton rather than needing an owning component.

export global ColorPickerMath {
    // RGB -> hue (0..360), given the 0..1 channels and their max/delta.
    // Undefined hue (gray, cdelta <= 0) resolves to 0.
    public pure function compute-hue(cr: float, cg: float, cb: float, cmax: float, cdelta: float) -> float {
        if (cdelta <= 0.0) {
            return 0.0;
        }
        if (cmax == cr) {
            return Math.mod(((cg - cb) / cdelta) + 6.0, 6.0) * 60.0;
        }
        if (cmax == cg) {
            return (((cb - cr) / cdelta) + 2.0) * 60.0;
        }
        return (((cr - cg) / cdelta) + 4.0) * 60.0;
    }

    // --- int -> hex (for the read-out / editable HEX field) ----------------
    public pure function hex-digit(n: int) -> string {
        n == 1 ? "1" : n == 2 ? "2" : n == 3 ? "3" : n == 4 ? "4"
            : n == 5 ? "5" : n == 6 ? "6" : n == 7 ? "7" : n == 8 ? "8"
            : n == 9 ? "9" : n == 10 ? "a" : n == 11 ? "b" : n == 12 ? "c"
            : n == 13 ? "d" : n == 14 ? "e" : n == 15 ? "f" : "0"
    }
    public pure function byte-hex(b: int) -> string {
        ColorPickerMath.hex-digit(Math.floor(b / 16)) + ColorPickerMath.hex-digit(Math.mod(b, 16))
    }
}
