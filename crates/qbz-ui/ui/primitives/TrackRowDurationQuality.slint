// Duration + quality-badge columns for TrackRow.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { QualityBadgeFull } from "QualityBadgeFull.slint";

export component TrackRowDurationQuality inherits HorizontalLayout {
    in property <string> duration;
    in property <string> quality-tier;
    in property <string> quality-detail;

    // Duration.
    Text {
        text: root.duration;
        width: 70px;
        color: Theme.text-muted;
        // Secondary metadata — must read SMALLER than the track title
        // (Typography.link, 14px), not bigger. Was Typography.body (15px),
        // which made the duration larger than the title — illogical.
        font-size: Typography.legal;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Quality — bare badge (tier label + exact bit-depth / sample-rate),
    // no chip background so it blends into the row.
    HorizontalLayout {
        width: 92px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            QualityBadgeFull {
                tier: root.quality-tier;
                detail: root.quality-detail;
                show-icon: false;
                bare: true;
            }
        }
    }
}
