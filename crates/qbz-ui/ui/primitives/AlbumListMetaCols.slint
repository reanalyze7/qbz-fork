// TYPE / SOURCE / QUALITY / TRACKS / YEAR columns + the trailing overflow
// ("…") button and its context menu, for AlbumListRow.

import { Theme } from "../foundation/semantic-colors.slint";
import { AlbumCardItem } from "../state.slint";
import { AlbumListCols } from "AlbumListCols.slint";
import { QbzIcon } from "QbzIcon.slint";
import { QualityBadgeFull } from "QualityBadgeFull.slint";
import { AlbumListRowMenu } from "AlbumListRowMenu.slint";

export component AlbumListMetaCols inherits Rectangle {
    in property <AlbumCardItem> album;
    in property <bool> show-source: true;
    out property <bool> hovered: more-ta.has-hover;
    callback row-clicked(string);
    callback media-action(string, string, string);

    HorizontalLayout {
        spacing: AlbumListCols.gap;

        // --- TYPE --------------------------------------------------------
        Text {
            width: AlbumListCols.type;
            text: root.album.release-type;
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        // --- SOURCE (hideable) — discreet per-source glyph, NOT text. ---
        // Mirrors TrackRow's source indicator: local -> tinted hard-drive,
        // qobuz/offline -> their own mark; small + flat (the bold colored
        // badge is reserved for the AlbumCard grid).
        if root.show-source: Rectangle {
            width: AlbumListCols.source;
            if root.album.source != "": Image {
                source: (root.album.source == "qobuz" || root.album.source == "qobuz_download" || root.album.source == "qobuz_purchase")
                        ? @image-url("../assets/icons/qobuz-logo-filled.svg")
                        : @image-url("../assets/icons/hard-drive.svg");
                // `qobuz_purchase` → GOLD-tinted Qobuz mark (§8.7 purchase badge).
                colorize: root.album.source == "qobuz_purchase" ? #eab308
                    : (root.album.source == "local" ? Theme.text-muted : transparent);
                width: root.album.source == "local" ? 15px : 16px;
                height: self.width;
                x: 0;
                y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                image-fit: contain;
            }
        }

        // --- QUALITY (shared QualityBadgeFull) ----------------------------
        Rectangle {
            width: AlbumListCols.quality;
            VerticalLayout {
                alignment: center;
                QualityBadgeFull {
                    tier: root.album.quality-tier;
                    detail: root.album.quality-detail;
                }
            }
        }

        // --- TRACKS --------------------------------------------------------
        Text {
            width: AlbumListCols.tracks;
            text: root.album.track-count;
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // --- YEAR ------------------------------------------------------
        Text {
            width: AlbumListCols.year;
            text: root.album.plain-year;
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // --- Overflow "…" ---------------------------------------------
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: AlbumListCols.overflow;
                height: 32px;
                border-radius: 6px;
                background: more-ta.has-hover ? Theme.surface-elevated : transparent;
                QbzIcon {
                    source: @image-url("../assets/icons/ellipsis.svg");
                    width: 18px;
                    height: 18px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: more-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                }
                more-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        row-menu.show();
                    }
                }
                row-menu := AlbumListRowMenu {
                    album: root.album;
                    clicked(id) => {
                        root.row-clicked(id);
                    }
                    media-action(kind, id, action) => {
                        root.media-action(kind, id, action);
                    }
                }
            }
        }
    }
}
