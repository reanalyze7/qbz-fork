// Filter search box at the top of QbzSelect's open list (searchable
// lists only).

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { QbzIcon } from "QbzIcon.slint";
import { UiFocusState } from "../state.slint";

export component QbzSelectSearchBox inherits Rectangle {
    in-out property <string> filter: "";

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../assets/icons/search.svg");
                width: 14px;
                height: 14px;
                tint: Theme.text-muted;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            search-input := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.text-primary;
                font-size: Typography.body;
                vertical-alignment: center;
                single-line: true;
                text <=> root.filter;
                changed has-focus => { UiFocusState.text-input-focused = self.has-focus; }
            }
            Text {
                visible: search-input.text == "";
                text: @tr("Search…");
                color: Theme.text-muted;
                font-size: Typography.body;
                vertical-alignment: center;
            }
        }
    }
}
