// "+ New playlist" row, always first in the picker — never filtered out.
// Collapsed: a tappable row. Expanded (creating-open): name field + Create
// button that creates the playlist AND adds the pending track(s) in one
// action (create-and-add()) — spec §2. Replaces CreatePlaylistModal's
// name-only path; description/folder/public/offline-only stay reachable
// afterward via EditPlaylistModal, which already owns them.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { Radius } from "../foundation/radius.slint";
import { PlaylistPickerState, PlaylistPickerActions, UiFocusState } from "../state.slint";
import { QbzIcon } from "QbzIcon.slint";
import { QbzPrimaryButton } from "QbzPrimaryButton.slint";

export component PlaylistCreateRow inherits Rectangle {
    property <bool> can-create: PlaylistPickerState.create-name != "" && !PlaylistPickerState.creating;

    height: PlaylistPickerState.creating-open ? 92px : 44px;

    // Collapsed row.
    if !PlaylistPickerState.creating-open: Rectangle {
        background: collapsed-ta.has-hover ? Theme.surface-hover : transparent;
        collapsed-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                PlaylistPickerState.creating-open = true;
                PlaylistPickerState.create-name = "";
            }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                QbzIcon { source: @image-url("../assets/icons/plus.svg"); width: 14px; height: 14px; tint: Theme.accent; }
            }
            Text {
                text: @tr("New playlist");
                color: Theme.accent;
                font-size: Typography.link;
                font-weight: Typography.medium;
                vertical-alignment: center;
            }
        }
    }

    // Expanded: name field + Cancel/Create.
    if PlaylistPickerState.creating-open: VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        name-box := Rectangle {
            height: 40px;
            border-radius: Radius.sm;
            background: Theme.surface-elevated;
            border-width: 1px;
            border-color: name-input.has-focus ? Theme.accent : Theme.border-subtle;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    name-input := TextInput {
                        width: 100%;
                        height: 100%;
                        color: Theme.text-primary;
                        font-size: Typography.link;
                        vertical-alignment: center;
                        single-line: true;
                        enabled: !PlaylistPickerState.creating;
                        text <=> PlaylistPickerState.create-name;
                        changed has-focus => { UiFocusState.text-input-focused = self.has-focus; }
                        accepted => {
                            if (root.can-create) {
                                PlaylistPickerActions.create-and-add();
                            }
                        }
                    }
                    Text {
                        visible: name-input.text == "";
                        width: 100%;
                        height: 100%;
                        text: @tr("My Playlist");
                        color: Theme.text-muted;
                        font-size: Typography.link;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            cancel-ta := TouchArea {
                width: 60px;
                height: 30px;
                mouse-cursor: pointer;
                enabled: !PlaylistPickerState.creating;
                clicked => {
                    PlaylistPickerState.creating-open = false;
                    PlaylistPickerState.create-name = "";
                }
                Text {
                    text: @tr("Cancel");
                    color: Theme.text-muted;
                    font-size: Typography.legal;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            QbzPrimaryButton {
                label: PlaylistPickerState.creating ? @tr("Creating…") : @tr("Create");
                height: 30px;
                enabled: root.can-create;
                clicked => {
                    PlaylistPickerActions.create-and-add();
                }
            }
        }
    }
}
