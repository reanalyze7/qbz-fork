// Reusable album list-row — the "list view" counterpart to the grid
// AlbumCard. Modeled on Tauri's My QBZ > Collections list (and the
// DiscographyBuilderView column grid): a thumbnail + title/artist ITEM
// column, then TYPE, SOURCE, QUALITY, TRACKS and YEAR columns plus a
// trailing overflow ("…") button. Column-for-column with the Tauri
// reference. Reused by Discover "View all", Favorites, LocalLibrary and
// My QBZ — every column except ITEM is hideable via a bool prop.
//
// Column widths (AlbumListCols), the header row (AlbumListHeader), the
// checkbox/art/item cells, and the TYPE/SOURCE/QUALITY/TRACKS/YEAR/
// overflow columns (AlbumListMetaCols) live in sibling files; this file
// stays the import surface and the row-level hover/click glue.

import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { AlbumCardItem } from "../state.slint";
import { AlbumListCols } from "AlbumListCols.slint";
import { AlbumListArtCell } from "AlbumListArtCell.slint";
import { AlbumListMetaCols } from "AlbumListMetaCols.slint";
import { AlbumListSelectCheckbox } from "AlbumListSelectCheckbox.slint";
import { AlbumListItemCell } from "AlbumListItemCell.slint";

export { AlbumListCols } from "AlbumListCols.slint";
export { AlbumListHeader } from "AlbumListHeader.slint";

export component AlbumListRow inherits Rectangle {
    in property <AlbumCardItem> album;
    // Fade out when the row is being removed (favorites un-favorite).
    opacity: root.album.removing ? 0.0 : 1.0;
    animate opacity { duration: 250ms; }
    // Row index — drives the even/odd zebra striping (coherent with TrackRow).
    in property <int> index;
    // Optional leading rank ("#1" etc) for ranked lists (Most Streamed).
    in property <bool> show-rank: false;
    in property <string> rank;
    // The SOURCE column is hidden in single-source contexts (Discover).
    in property <bool> show-source: true;
    // Multi-select mode (Local Library albums): a leading checkbox + row click
    // toggles selection instead of opening. Default false → other consumers
    // (Discover/Label/Favorites lists) are untouched.
    in property <bool> select-mode: false;

    callback clicked(string);
    // kind ("album" | "artist"), id, action ("play"|"queue"|"play-next"|"favorite"|"open").
    callback media-action(string, string, string);

    // Hover spans the row body + the art / artist / overflow affordances so
    // the row highlights as one (mirrors TrackRow's row-hovered).
    property <bool> row-hovered:
        ta.has-hover || art-cell.hovered || item-cell.hovered || meta.hovered;

    height: 64px;
    border-radius: Radius.sm;
    // Even/odd zebra (odd rows faintly tinted), coherent with TrackRow.
    background: root.row-hovered
        ? Theme.surface-hover
        : (Math.mod(root.index, 2) == 1 ? #ffffff07 : transparent);

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.select-mode) {
                root.media-action("album", root.album.id, "toggle-select");
            } else {
                root.clicked(root.album.id);
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: AlbumListCols.gap;

        // --- Multi-select checkbox (leading) --------------------------
        if root.select-mode: VerticalLayout {
            alignment: center;
            AlbumListSelectCheckbox {
                selected: root.album.selected;
            }
        }

        // --- # ---------------------------------------------------------
        if root.show-rank: Text {
            width: AlbumListCols.rank;
            text: root.rank;
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }

        // --- Artwork thumb (play on hover) ----------------------------
        VerticalLayout {
            alignment: center;
            art-cell := AlbumListArtCell {
                artwork: root.album.artwork;
                select-mode: root.select-mode;
                row-hovered: root.row-hovered;
                clicked => {
                    if (root.select-mode) {
                        root.media-action("album", root.album.id, "toggle-select");
                    } else {
                        root.media-action("album", root.album.id, "play");
                    }
                }
            }
        }

        // --- ITEM: title + artist -------------------------------------
        item-cell := AlbumListItemCell {
            title: root.album.title;
            artist: root.album.artist;
            artist-id: root.album.artist-id;
            artist-clicked => {
                root.media-action("artist", root.album.artist-id, "open");
            }
        }

        meta := AlbumListMetaCols {
            album: root.album;
            show-source: root.show-source;
            row-clicked(id) => {
                root.clicked(id);
            }
            media-action(kind, id, action) => {
                root.media-action(kind, id, action);
            }
        }
    }
}
