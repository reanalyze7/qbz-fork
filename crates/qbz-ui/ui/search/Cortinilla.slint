// Search "cortinilla" — the live as-you-type dropdown shown under the header
// search box. It is the in-window overlay equivalent of HeaderMenuOverlay:
// a plain Rectangle mounted as a LAST child of AppShell, NOT a PopupWindow
// (a PopupWindow grabs the pointer, which would kill hover on the rows and
// on the header search box itself).
//
// This file is just the shell: idle-close Timer, click-outside scrims, and
// positioning math. The scrolling result body (skeleton rows, top-result,
// labelled sections) lives in CortinillaPanel.slint, instantiated below
// inside the `if root.visible:` block.
//
// The panel is anchored under the absolutely-centered header search box and is
// height-capped so it NEVER covers the now-playing bar. Any click outside the
// panel (content, sidebar, player, or the header strip beside the search box)
// dismisses it; a page change dismisses it too (AppShell).

import { Layout } from "../foundation/layout.slint";
import { SearchState, ShellState } from "../state.slint";
import { CortinillaPanel } from "./CortinillaPanel.slint";

export component Cortinilla inherits Rectangle {
    // Bubbled up to AppShell for the controller to act on (mirrors how
    // HeaderMenuOverlay bubbles `navigate`); forwarded to SearchActions.
    callback row-clicked(int /* flat-index */);
    callback view-more(string /* kind */);
    callback search-all();
    callback dismiss();

    // Only render/consume events when open AND the live query is long enough
    // to have meaningful results (mirrors the controller's >= 2 gate).
    visible: SearchState.cortinilla-open
        && SearchState.cortinilla-query.character-count >= 2;

    // Fixed width (no parent/sibling refs -> no binding-loop risk); the panel
    // is centered under the header search box via root.width arithmetic.
    property <length> panel-width: 320px;

    // The centered header search box width (mirrors HeaderBar's responsive
    // `search-width`), used to leave a click-through gap for the box in the
    // header-strip scrims below.
    property <length> search-box-width:
        (root.width < 960px ? 179px : 256px) - (ShellState.nav-in-sidebar ? 0px : 60px);

    // --- Idle auto-close -----------------------------------------------
    // Dismiss after ~4.5 s of inactivity: no pointer over the panel and no
    // search activity. `panel-hovered` mirrors CortinillaPanel's `hovered`
    // out property — the panel lives in an `if` subtree and a Timer in
    // there cannot be restart()ed (1.16 compiler panic), so the timer lives
    // here, in the always-mounted root component.
    property <bool> panel-hovered: false;
    // The mirror can go stale when the panel unmounts while hovered (its
    // `changed has-hover` never fires false) — reset it on every open/close.
    changed visible => { root.panel-hovered = false; }
    idle-close := Timer {
        interval: 4500ms;
        running: root.visible && !root.panel-hovered;
        triggered => { root.dismiss(); }
    }
    // Activity probes — a keystroke or arrow-key move restarts the countdown.
    // Guarded so hovering doesn't wrongly resume a timer paused by `running`.
    property <string> idle-query-probe: SearchState.cortinilla-query;
    changed idle-query-probe => {
        if (root.visible && !root.panel-hovered) { idle-close.restart(); }
    }
    property <int> idle-sel-probe: SearchState.selected-index;
    changed idle-sel-probe => {
        if (root.visible && !root.panel-hovered) { idle-close.restart(); }
    }

    // Click-outside scrims — ANY click outside the panel dismisses it. Three
    // transparent TouchAreas tile the window EXCEPT (a) the panel (declared
    // later, on top) and (b) the header search box (the central gap), which
    // stays focusable/typeable. A page change also dismisses it (AppShell).
    //   1) everything BELOW the header (content, sidebar, player bar)
    if root.visible: TouchArea {
        x: 0;
        y: Layout.header-height;
        width: root.width;
        height: root.height - self.y;
        clicked => { root.dismiss(); }
    }
    //   2) header strip LEFT of the search box
    if root.visible: TouchArea {
        x: 0;
        y: 0;
        width: (root.width - root.search-box-width) / 2;
        height: Layout.header-height;
        clicked => { root.dismiss(); }
    }
    //   3) header strip RIGHT of the search box
    if root.visible: TouchArea {
        x: (root.width + root.search-box-width) / 2;
        y: 0;
        width: root.width - self.x;
        height: Layout.header-height;
        clicked => { root.dismiss(); }
    }

    // The panel itself, anchored under the centered search box. Its height is
    // capped so the bottom edge stays ABOVE the now-playing bar; a tall result
    // set scrolls inside the panel's Flickable, a short one collapses.
    if root.visible: panel := CortinillaPanel {
        // 12px = the panel-box VLayout's top/bottom padding. Driven only by
        // `root.height` + ShellState (never a sibling's geometry) -> no loop.
        scroll-cap:
            root.height - Layout.header-height - 6px
            - Layout.player-bar-height
            - 16px - 12px;

        x: (root.width - root.panel-width) / 2;
        y: Layout.header-height + 6px;
        panel-width: root.panel-width;

        row-clicked(fi) => {
            root.row-clicked(fi);
        }
        view-more(kind) => {
            root.view-more(kind);
        }
        // Mirror the panel's hover state for the idle-close Timer above.
        // Must be wired here, INSIDE the `if` subtree that owns `panel`'s id
        // — a conditional element's id is not reachable from outside its own
        // `if` block, only the property/callback values it exposes are.
        changed hovered => {
            root.panel-hovered = panel.hovered;
        }
    }
}
