// Settings > Sandbox — the one-time permission commands for sandboxed
// installs (Tauri parity: the old Settings > Flatpak / Snap sections).
// Shown only when the app runs inside Flatpak or Snap (SandboxState.
// install-method); hidden on native/dev installs.
//
// Flatpak rows: exclusive-DAC D-Bus reservation (the user-side fix for
// discussion #641 AND issue #652 — the Flathub manifest can't carry the
// wildcard own-name, so the user grants it locally via `flatpak override`;
// without it PipeWire keeps the DAC and an "exclusive" ALSA output falls
// back to PipeWire mixing) and filesystem access for NAS/external music
// libraries. NOTE: the published manifest already ships --device=all
// (flathub/com.blitzfc.qbz@11d38546, since 1.2.15) — /dev/snd IS exposed,
// do not "fix" #652 with a device override. Snap rows: the audio interface connections
// from the Tauri section (snap name is `qbz-player`).
//
// Commands are plain strings (never translated); surrounding copy goes
// through @tr. Copy feedback is local UI state (Copied! for 1.5 s); the
// clipboard write itself is SandboxState.copy-command → share::copy_to_clipboard.
//
// Shared row primitives + the copy-to-clipboard CommandBlock live in
// sandbox/SandboxCommandBlock.slint; the per-installer bodies live in
// sandbox/SandboxFlatpakSection.slint and sandbox/SandboxSnapSection.slint.

import { SandboxState } from "../state.slint";
import { SandboxFlatpakSection } from "sandbox/SandboxFlatpakSection.slint";
import { SandboxSnapSection } from "sandbox/SandboxSnapSection.slint";

export component SandboxSettings inherits VerticalLayout {
    spacing: 4px;
    alignment: start;

    if SandboxState.install-method == "flatpak": SandboxFlatpakSection { }
    if SandboxState.install-method == "snap": SandboxSnapSection { }
}
