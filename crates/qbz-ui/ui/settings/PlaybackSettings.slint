// Playback settings panel — end-of-source behavior, session persistence,
// and streaming/caching options. 1:1 with the Tauri app. Backed by the
// SettingsState global and persisted through the Rust settings
// controller.
//
// The three groups (PLAYBACK/SESSION/STREAMING) live in sibling files
// under playback/ to stay under the 130-line file budget; each forwards
// its settings-* callback up to this root, which re-emits them to Rust.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { PlaybackGroup } from "playback/PlaybackGroup.slint";
import { SessionGroup } from "playback/SessionGroup.slint";
import { StreamingGroup } from "playback/StreamingGroup.slint";

component GroupHeader inherits Text {
    color: Theme.text-muted;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: Typography.semibold;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border-subtle;
}

export component PlaybackSettings inherits VerticalLayout {
    callback settings-bool(string, bool);
    callback settings-select(string, int);
    callback settings-slider(string, int);
    callback settings-string(string, string);

    spacing: 4px;

    GroupHeader { text: @tr("PLAYBACK"); }
    PlaybackGroup {
        settings-bool(k, v) => { root.settings-bool(k, v); }
        settings-slider(k, v) => { root.settings-slider(k, v); }
    }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    GroupHeader { text: @tr("SESSION"); }
    SessionGroup {
        settings-bool(k, v) => { root.settings-bool(k, v); }
    }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    GroupHeader { text: @tr("STREAMING"); }
    StreamingGroup {
        settings-bool(k, v) => { root.settings-bool(k, v); }
        settings-select(k, v) => { root.settings-select(k, v); }
        settings-slider(k, v) => { root.settings-slider(k, v); }
    }
}
