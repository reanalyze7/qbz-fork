// RENDERER group (Linux only — visibility seeded from Rust; macOS is always
// Skia/Metal so the orchestrator never mounts this group there).

import { AppearanceState } from "../../state.slint";
import { QbzSelect } from "../../primitives/QbzSelect.slint";
import { SettingRow } from "../SettingRow.slint";
import { GroupHeader } from "shared.slint";

export component RendererSection inherits VerticalLayout {
    spacing: 4px;

    GroupHeader { text: @tr("RENDERER"); }

    SettingRow {
        label: @tr("Rendering backend");
        description: @tr("Auto picks the best renderer for your graphics hardware. Only change this if the app feels slow or renders incorrectly (requires restart)");
        QbzSelect {
            menu-width: 200px;
            options: AppearanceState.renderer-options;
            current-index: AppearanceState.renderer-index;
            selected(i) => {
                AppearanceState.renderer-index = i;
                AppearanceState.appearance-select("renderer", i);
            }
        }
    }
    SettingRow {
        label: @tr("Preferred GPU");
        description: @tr("Which GPU renders the app. On a hybrid laptop, picking the discrete GPU moves the dynamic-background load off the integrated one (cooler, but more power). Auto is recommended (requires restart)");
        QbzSelect {
            menu-width: 260px;
            options: AppearanceState.gpu-power-modes;
            current-index: AppearanceState.gpu-power-index;
            selected(i) => {
                AppearanceState.gpu-power-index = i;
                AppearanceState.appearance-select("gpu-power", i);
            }
        }
    }
}
