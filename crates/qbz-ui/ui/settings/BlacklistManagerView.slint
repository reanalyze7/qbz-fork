// Artist Blacklist Manager — a faithful Slint port of Tauri's
// BlacklistManagerView.svelte (consolidated review §7). The standalone
// manage-blacklist surface reached from the Settings content-filtering row:
// a header (Back + ban icon + title), a description line, a controls row
// (enable/disable toggle / search-as-you-type with × clear / Clear-All /
// total-count badge), an amber disabled-warning banner, and a 4-branch body
// (loading / empty / no-search-results / list), plus a Clear-All confirm
// modal overlaid above everything (ADR-009 — declared last so it stacks on
// top; the manager itself has no other overlay).
//
// State + actions live in BlacklistState / BlacklistActions; the controller
// (crate::blacklist_manager) precomputes the date string + has-notes flag and
// pushes ONLY the search-filtered rows into `items`, while `count` stays the
// FULL list count — so "empty" = count==0 and "no results" = count>0 with an
// empty `items`. Rows show a generic blind-eye glyph (no artist image exists),
// the name, "Added {date}", optional italic notes, and a per-row remove X
// (optimistic, no confirm). The blacklist visual across the Slint port is
// `blind-eye.svg` (TrackRow + ArtistPageView, T5/T9), used here too instead of
// Tauri's lucide `Ban`.
//
// Split across settings/blacklist/: row components (artist_row.slint,
// album_row.slint, dismissed_row.slint), tab_bar.slint, the controls-row
// pieces (enable_toggle/search_box/clear_all_button/controls_row.slint),
// disabled_banner.slint, the per-tab body branches (artists_body.slint,
// albums_body.slint, reco_body.slint), and clear_all_modal.slint.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { BlacklistState, BlacklistActions, ShellState } from "../state.slint";
import { LoadingSpinner } from "../primitives/LoadingSpinner.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { BlacklistHeader } from "blacklist/header.slint";
import { BlacklistTabBar } from "blacklist/tab_bar.slint";
import { BlacklistControlsRow } from "blacklist/controls_row.slint";
import { BlacklistDisabledBanner } from "blacklist/disabled_banner.slint";
import { BlacklistArtistsBody } from "blacklist/artists_body.slint";
import { BlacklistAlbumsBody } from "blacklist/albums_body.slint";
import { BlacklistRecoBody } from "blacklist/reco_body.slint";
import { BlacklistClearAllModal } from "blacklist/clear_all_modal.slint";

export component BlacklistManagerView inherits Rectangle {
    background: ShellState.app-background-active ? transparent : Theme.surface-main;

    // Local modal flag (Clear-All confirmation). Lives in the view; the
    // confirm only fires BlacklistActions.clear-all on the danger button.
    property <bool> confirm-clear-open: false;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        // Top bar — Back (ADR-004 via NavButtons; routes through nav history).
        HorizontalLayout {
            vertical-stretch: 0;
            NavButtons { }
        }

        BlacklistHeader { }

        BlacklistTabBar { }

        // Description (per tab).
        Text {
            vertical-stretch: 0;
            text: BlacklistState.active-tab == 0
                ? @tr("Blacklisted artists are hidden from search results, radio, suggestions, and similar artists.")
                : BlacklistState.active-tab == 1
                    ? @tr("Blocked albums are hidden from search, discovery, and listings — even when their artist is allowed.")
                    : @tr("Dismissed artists only leave your Recommendations — they still appear in search and everywhere else.");
            color: Theme.text-muted;
            font-size: Typography.body;
            wrap: word-wrap;
        }

        BlacklistControlsRow {
            clear-all-requested => {
                root.confirm-clear-open = true;
            }
        }

        if !BlacklistState.enabled: BlacklistDisabledBanner { }

        // Body — 4 mutually-exclusive branches (order is load-bearing):
        // shared Loading, then the active tab's empty/no-results/list body.
        Rectangle {
            vertical-stretch: 1;

            if BlacklistState.loading: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    LoadingSpinner { }
                }
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: @tr("Loading blacklist…");
                        color: Theme.text-muted;
                        font-size: Typography.body;
                    }
                }
            }

            if BlacklistState.active-tab == 0: BlacklistArtistsBody { }
            if BlacklistState.active-tab == 1: BlacklistAlbumsBody { }
            if BlacklistState.active-tab == 2: BlacklistRecoBody { }
        }
    }

    // Clear-All confirm modal — declared LAST so it stacks above the view
    // (ADR-009 ≥ 3000 satisfied by declaration order).
    if root.confirm-clear-open: BlacklistClearAllModal {
        dismissed => {
            root.confirm-clear-open = false;
        }
        confirmed => {
            if (BlacklistState.active-tab == 0) {
                BlacklistActions.clear-all();
            } else {
                BlacklistActions.clear-all-albums();
            }
            root.confirm-clear-open = false;
        }
    }
}
