// Settings > Integrations — source-agnostic scrobblers (Last.fm + ListenBrainz).
// A master enable + collapse header, then per-service connect/disconnect rows
// that bind the `ScrobbleState` global for state and `ScrobbleActions` for
// actions. The fire path is source-agnostic (Qobuz and local) and lives in Rust.
// ADR-008: no pills — plain bordered buttons.
//
// The SCROBBLERS master header + per-service rows live in sibling files
// under integrations/ to stay under the 130-line file budget.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { ScrobbleActions, SettingsState } from "../state.slint";
import { SettingRow } from "SettingRow.slint";
import { QbzToggle } from "../primitives/QbzToggle.slint";
import { GroupHeader } from "integrations/GroupHeader.slint";
import { ScrobblersSection } from "integrations/ScrobblersSection.slint";

export component IntegrationsSettings inherits VerticalLayout {
    spacing: 4px;

    // Bubbles a persisted bool toggle up to SettingsView -> Rust handle_bool.
    callback settings-bool(string, bool);

    init => {
        ScrobbleActions.load();
    }

    // ===================================================================
    // RECOMMENDATIONS — opt-out for the external Discover "Recommendations"
    // tab. The description nudges connecting the sources that feed it.
    // ===================================================================
    GroupHeader { text: @tr("RECOMMENDATIONS"); }
    SettingRow {
        label: @tr("Show Recommendations in Discover");
        description: @tr("A personalized Discover tab built from your listening. For the best results connect Last.fm and ListenBrainz below — MusicBrainz is used automatically to match releases.");
        QbzToggle {
            checked: SettingsState.show-recommendations;
            toggled(v) => {
                SettingsState.show-recommendations = v;
                root.settings-bool("show-recommendations", v);
            }
        }
    }

    // ===================================================================
    // METADATA — MusicBrainz opt-out (default on). Enriches artist pages
    // (relationships, origin/scene) and playlist song suggestions. No telemetry.
    // ===================================================================
    Rectangle { height: 12px; }
    GroupHeader { text: @tr("METADATA"); }
    Rectangle { height: 4px; }
    SettingRow {
        label: @tr("MusicBrainz");
        description: @tr("Enable artist relationships and enhanced metadata from MusicBrainz. No telemetry — it only matches releases to enrich artist pages and playlist song suggestions. Turn off to disable those sections.");
        QbzToggle {
            checked: SettingsState.musicbrainz-enabled;
            toggled(v) => {
                SettingsState.musicbrainz-enabled = v;
                root.settings-bool("musicbrainz", v);
            }
        }
    }

    // ===================================================================
    // SCROBBLERS — master header + per-service rows (see
    // integrations/ScrobblersSection.slint).
    // ===================================================================
    ScrobblersSection { }
}
