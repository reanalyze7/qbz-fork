// Settings page — a back/title header, a left sub-navigation column
// (Audio, Playback), and the active settings panel in a scroll area.
//
// Navigation between sub-sections is pure UI state (SettingsState.section);
// setting changes bubble up as settings-bool / settings-select callbacks
// to the Rust layer, which persists them and applies them to the player.

import { Theme } from "../foundation/semantic-colors.slint";
import { Typography } from "../foundation/typography.slint";
import { NavState, ContentView } from "../state.slint";
import { NavButtons } from "../shell/NavButtons.slint";
import { ScrollView } from "std-widgets.slint";
import { ListScrollbar } from "../primitives/ListScrollbar.slint";
import { SettingsSubNav } from "view/SettingsSubNav.slint";
import { SettingsActivePanel } from "view/SettingsActivePanel.slint";

export component SettingsView inherits Rectangle {
    callback settings-bool(string, bool);
    callback settings-select(string, int);
    callback settings-slider(string, int);
    callback settings-string(string, string);
    callback settings-reset();
    callback settings-release-device();

    background: Theme.surface-main;

    VerticalLayout {
        spacing: 0px;

        // --- Header: back button + title -----------------------------------
        Rectangle {
            height: 92px;
            VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 11px;
                spacing: 12px;
                alignment: start;

                HorizontalLayout {
                    alignment: start;
                    NavButtons { }
                }

                Text {
                    text: @tr("Settings");
                    color: Theme.text-primary;
                    font-size: Typography.title;
                    font-weight: Typography.bold;
                }
            }
        }

        // --- Sub-nav + active panel ----------------------------------------
        HorizontalLayout {
            vertical-stretch: 1;

            // Left sub-navigation (see view/SettingsSubNav.slint for the
            // section-index table, kept in sync with the panel chain below).
            SettingsSubNav { }

            // Active panel. A raw Flickable (NOT the std ScrollView) so the
            // panel scrolls on TOUCH-DRAG on the Pi kiosk — a Flickable intercepts
            // the drag after a few px even over the dense SettingRows' controls,
            // which the std ScrollView did not. A ListScrollbar overlay keeps the
            // desktop scrollbar; sr-restore uses `self.height` (the Flickable's
            // visible height) in place of ScrollView's `visible-height`.
            Rectangle {
                horizontal-stretch: 1;
                settings-flick := Flickable {
                    interactive: true;
                    viewport-width: self.width;
                    property <string> sr-armed: NavState.restore-scope;
                    function sr-restore() {
                        if (NavState.restore-scope == "settings" && self.viewport-height > self.height) {
                            self.viewport-y = NavState.scroll-restore;
                            NavState.restore-scope = "";
                        }
                    }
                    init => { self.sr-restore(); }
                    changed sr-armed => { self.sr-restore(); }
                    changed viewport-height => { self.sr-restore(); }
                    changed viewport-y => { NavState.report-scroll(self.viewport-y); }
                SettingsActivePanel {
                    settings-bool(k, v) => { root.settings-bool(k, v); }
                    settings-select(k, i) => { root.settings-select(k, i); }
                    settings-slider(k, v) => { root.settings-slider(k, v); }
                    settings-string(k, s) => { root.settings-string(k, s); }
                    settings-reset => { root.settings-reset(); }
                    settings-release-device => { root.settings-release-device(); }
                }
                }
                ListScrollbar {
                    x: parent.width - self.width - 2px;
                    width: 14px;
                    height: 100%;
                    viewport-height: settings-flick.viewport-height;
                    visible-height: settings-flick.height;
                    viewport-y <=> settings-flick.viewport-y;
                    auto-hide: true;
                }
            }
        }
    }
}
