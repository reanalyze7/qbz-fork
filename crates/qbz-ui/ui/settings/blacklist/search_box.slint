// Search input (search-as-you-type) + clear (×) for the blacklist manager's
// controls row.

import { Theme } from "../../foundation/semantic-colors.slint";
import { Typography } from "../../foundation/typography.slint";
import { Radius } from "../../foundation/radius.slint";
import { BlacklistState, BlacklistActions, UiFocusState } from "../../state.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";

export component BlacklistSearchBox inherits Rectangle {
    width: 280px;
    height: 34px;
    border-radius: Radius.sm;
    background: Theme.surface-elevated;
    border-width: 1px;
    border-color: search-in.has-focus ? Theme.accent : Theme.border-subtle;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            QbzIcon {
                source: @image-url("../../assets/icons/search.svg");
                width: 15px;
                height: 15px;
                tint: Theme.text-muted;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            search-in := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text-primary;
                font-size: Typography.legal;
                text: BlacklistState.search-query;
                changed has-focus => { UiFocusState.text-input-focused = self.has-focus; }
                // Search-as-you-type: every edit re-pushes the
                // controller-filtered rows. No debounce (Tauri parity).
                edited => {
                    BlacklistActions.search-changed(self.text);
                }
            }
        }
        if BlacklistState.search-query != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: Radius.sm;
                background: clear-ta.has-hover ? Theme.surface-hover : transparent;
                QbzIcon {
                    source: @image-url("../../assets/icons/x.svg");
                    width: 13px;
                    height: 13px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: clear-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                }
                clear-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        search-in.text = "";
                        BlacklistActions.search-changed("");
                    }
                }
            }
        }
    }
}
