// One blocked-album row (Albums tab of BlacklistManagerView; parallel to
// ArtistRow, with a cover thumbnail).

import { Theme } from "../../foundation/semantic-colors.slint";
import { Typography } from "../../foundation/typography.slint";
import { Radius } from "../../foundation/radius.slint";
import { QbzIcon } from "../../primitives/QbzIcon.slint";

export component AlbumRow inherits Rectangle {
    in property <string> album-title;
    in property <string> artist-name;
    in property <string> added-display;
    in property <image> cover-image;
    property <bool> hovered: ta.has-hover || rm-ta.has-hover;
    callback select();
    callback remove();
    callback hover-changed(bool);
    height: 64px;
    border-radius: Radius.md;
    background: root.hovered ? Theme.surface-elevated : Theme.surface-card;

    changed hovered => {
        root.hover-changed(self.hovered);
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;

        Rectangle {
            horizontal-stretch: 1;
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.select();
                }
            }
            HorizontalLayout {
                spacing: 12px;
                // 48x48 cover with a blind-eye fallback (shows through until the
                // network cover resolves, or when none exists).
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: Radius.sm;
                        clip: true;
                        background: Theme.surface-elevated;
                        QbzIcon {
                            source: @image-url("../../assets/icons/blind-eye.svg");
                            width: 20px;
                            height: 20px;
                            x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                            y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                            tint: Theme.text-muted;
                        }
                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.cover-image;
                            image-fit: cover;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.album-title;
                        color: Theme.text-primary;
                        font-size: Typography.body;
                        font-weight: Typography.medium;
                        overflow: elide;
                    }
                    Text {
                        text: root.artist-name;
                        color: Theme.text-secondary;
                        font-size: Typography.legal;
                        overflow: elide;
                    }
                    Text {
                        text: @tr("Added {}", root.added-display);
                        color: Theme.text-muted;
                        font-size: Typography.legal;
                        overflow: elide;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Radius.sm;
                background: rm-ta.has-hover ? Theme.danger-bg : transparent;
                QbzIcon {
                    source: @image-url("../../assets/icons/x.svg");
                    width: 18px;
                    height: 18px;
                    x: Math.round((parent.width - self.width) / 2 / 1px) * 1px;
                    y: Math.round((parent.height - self.height) / 2 / 1px) * 1px;
                    tint: rm-ta.has-hover ? Theme.danger : Theme.text-muted;
                }
                rm-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
}
