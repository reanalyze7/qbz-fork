// Appearance settings panel — theme, typography, language, window chrome,
// notifications, player views, and system tray options. A 1:1
// structural replica of the Tauri app's Settings > Appearance section.
//
// This is primarily an UNWIRED replica: rows are bound to AppearanceState
// and emit generic appearance-bool / appearance-select / appearance-text /
// appearance-action callbacks, but the Rust side does not yet persist or
// apply most of them. The single exception is the sidebar-playlist-collage
// toggle, which is wired straight through to SidebarState.playlist-collage
// (an already-functional flag). Conditional rows are `if`-gated on the same
// flags Tauri gates on (System theme, title-bar mode, etc.).
//
// Split by domain section (matching the original file's `// ====` banner
// comments) into settings/appearance/*.slint; this file is the thin
// orchestrator that composes them back in order with the section dividers.

import { AppearanceState } from "../state.slint";
import { Divider } from "appearance/shared.slint";
import { ThemeSection } from "appearance/ThemeSection.slint";
import { TypographySection } from "appearance/TypographySection.slint";
import { LibraryVisualsSection } from "appearance/LibraryVisualsSection.slint";
import { NotificationsSection } from "appearance/NotificationsSection.slint";
import { WindowTitleSection } from "appearance/WindowTitleSection.slint";
import { TitleBarSection } from "appearance/TitleBarSection.slint";
import { WindowControlsSection } from "appearance/WindowControlsSection.slint";
import { PlayerViewsSection } from "appearance/PlayerViewsSection.slint";
import { TraySection } from "appearance/TraySection.slint";
import { RendererSection } from "appearance/RendererSection.slint";

export component AppearanceSettings inherits VerticalLayout {
    spacing: 4px;

    ThemeSection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    TypographySection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    LibraryVisualsSection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    NotificationsSection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    WindowTitleSection { }

    if !AppearanceState.is-macos: Rectangle { height: 12px; }
    if !AppearanceState.is-macos: Divider { }
    if !AppearanceState.is-macos: Rectangle { height: 12px; }

    // TITLE BAR (custom window chrome — the header IS the title bar: it is
    // always present; custom mode adds window controls + drag to it and
    // drops the system decorations. Linux defaults to system chrome; macOS
    // keeps the native overlay (traffic lights over the header), so this
    // whole section is hidden there.)
    if !AppearanceState.is-macos: TitleBarSection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    // WINDOW CONTROLS (drawn in-app on Linux custom chrome; macOS keeps
    // the native traffic lights so this section is hidden there)
    if !AppearanceState.is-macos: WindowControlsSection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    PlayerViewsSection { }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    TraySection { }

    // RENDERER (Linux only — visibility seeded from Rust; macOS is
    // always Skia/Metal so the group never shows there)
    if AppearanceState.renderer-setting-visible: Rectangle { height: 12px; }
    if AppearanceState.renderer-setting-visible: Divider { }
    if AppearanceState.renderer-setting-visible: Rectangle { height: 12px; }
    if AppearanceState.renderer-setting-visible: RendererSection { }

    Rectangle { height: 40px; }
}
