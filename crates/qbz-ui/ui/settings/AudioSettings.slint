// Audio settings panel — streaming quality, output routing, and
// bit-perfect options. 1:1 with the Tauri app. All rows are backed by
// the SettingsState global and persisted through the Rust settings
// controller. Conditional rows are `if`-gated on Rust-computed flags.
//
// Split by settings group into settings/audio/*.slint; this file is the
// thin orchestrator that composes them back in order and wires each
// section's callbacks through to its own (unchanged) public callbacks.

import { Divider } from "audio/shared.slint";
import { HearingProtectionSection } from "audio/HearingProtectionSection.slint";
import { StreamingSection } from "audio/StreamingSection.slint";
import { OutputSection } from "audio/OutputSection.slint";
import { BitPerfectSection } from "audio/BitPerfectSection.slint";
import { StartupSection } from "audio/StartupSection.slint";
import { ResetRow } from "audio/ResetRow.slint";

export component AudioSettings inherits VerticalLayout {
    callback settings-bool(string, bool);
    callback settings-select(string, int);
    callback settings-slider(string, int);
    // Emitted by the Reset button.
    callback settings-reset();
    // Emitted by the refresh/release button next to the output device:
    // frees a device QBZ is holding (ALSA exclusive) and re-enumerates so a
    // freed or hot-plugged DAC appears without restarting the app.
    callback settings-release-device();

    spacing: 4px;

    HearingProtectionSection {
        settings-bool(k, v) => { root.settings-bool(k, v); }
        settings-slider(k, v) => { root.settings-slider(k, v); }
    }

    StreamingSection {
        settings-bool(k, v) => { root.settings-bool(k, v); }
        settings-select(k, i) => { root.settings-select(k, i); }
    }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    OutputSection {
        settings-bool(k, v) => { root.settings-bool(k, v); }
        settings-select(k, i) => { root.settings-select(k, i); }
        settings-release-device => { root.settings-release-device(); }
    }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    BitPerfectSection {
        settings-bool(k, v) => { root.settings-bool(k, v); }
    }

    Rectangle { height: 12px; }
    Divider { }
    Rectangle { height: 12px; }

    StartupSection {
        settings-bool(k, v) => { root.settings-bool(k, v); }
    }

    Rectangle { height: 20px; }

    ResetRow {
        settings-reset => { root.settings-reset(); }
    }
}
